		.ЭтоНеопределено();
	
КонецПроцедуры

Процедура ПодготовитьЛог_РегистрБезТела() Экспорт
	
	Исходные = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	
	Попытка
		
		Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
		ЗаполнитьЗначенияСвойств(Настройки, Исходные);
		Настройки.ЗаписыватьВРСТело = Ложь;
		Настройки.МаксимальныйРазмерТела = 0;
		ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
		
		ЛогЗапроса = ЮТOneSnifferТестовыеДанные.НовыйИсходящийЛогДляТеста();
		Подготовленный = ЛогированиеТрафика.ПодготовитьЛог(
			ЛогЗапроса,
			Перечисления.НазначениеЛога.Регистр);
		
		ЮТест.ОжидаетЧто(Подготовленный.Содержание.ТелоЗапроса).ЭтоНеопределено();
		ЮТест.ОжидаетЧто(Подготовленный.Содержание.ТелоОтвета).ЭтоНеопределено();
		ЮТест.ОжидаетЧто(Подготовленный.Свойство("HTTPОтвет")).ЭтоЛожь();
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

Процедура ПодготовитьЛог_РегистрСТеломИЛимитом() Экспорт
	
	Исходные = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	
	Попытка
		
		Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
		ЗаполнитьЗначенияСвойств(Настройки, Исходные);
		Настройки.ЗаписыватьВРСТело = Истина;
		Настройки.МаксимальныйРазмерТела = 1; // 1 КБ
		ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
		
		ЛогЗапроса = ЮТOneSnifferТестовыеДанные.НовыйИсходящийЛогДляТеста();
		// Наберём тело > 1 КБ
		Куски = Новый Массив;
		Для Индекс = 1 По 200 Цикл
			Куски.Добавить("0123456789012345678901234567890123456789012345678901234567890123");
		КонецЦикла;
		ЛогЗапроса.Содержание.ТелоОтвета = ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Куски, ""));
		
		Подготовленный = ЛогированиеТрафика.ПодготовитьЛог(
			ЛогЗапроса,
			Перечисления.НазначениеЛога.Регистр);
		
		ЮТест.ОжидаетЧто(Подготовленный.Содержание.ТелоОтвета).Заполнено();
		ЮТест.ОжидаетЧто(ТипЗнч(Подготовленный.Содержание.ТелоОтвета))
			.Равно(Тип("ДвоичныеДанные"));
		ЮТест.ОжидаетЧто(Подготовленный.Содержание.ТелоОтвета.Размер())
			.МеньшеИлиРавно(1024 + 256); // префикс + маркер усечения
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

#КонецОбласти

#Область Регистр

Процедура ЗаписатьЛог_И_ПолучитьТекстЛога() Экспорт
	
	Исходные = ЮТOneSnifferТестовыеДанные.ВключитьЛогированиеВРС();
	
	Попытка
		
		ЛогЗапроса = ЮТOneSnifferТестовыеДанные.НовыйИсходящийЛогДляТеста(
			"OneSniffer.ЗаписьТест");
		РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса);
		
		КлючЗаписи = ЮТOneSnifferТестовыеДанные.КлючЗаписиЛога(ЛогЗапроса);
		ТекстЛога = ЛогированиеТрафика.ПолучитьТекстЛога(КлючЗаписи, Истина);
		
		ЮТест.ОжидаетЧто(ТекстЛога).Заполнено();
		ЮТест.ОжидаетЧто(ТекстЛога).Содержит("### OneSniffer.ЗаписьТест");
		ЮТест.ОжидаетЧто(ТекстЛога).Содержит("GET https://example.test/api/ping");
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

Процедура ОчиститьИсторию_УдаляетСтарые() Экспорт
	
	Исходные = ЮТOneSnifferТестовыеДанные.ВключитьЛогированиеВРС();
	
	Попытка
		
		ЛогЗапроса = ЮТOneSnifferТестовыеДанные.НовыйИсходящийЛогДляТеста(
			"OneSniffer.ОчисткаСтарый");
		ЛогЗапроса.Дата = ТекущаяДатаСеанса() - 10 * 24 * 60 * 60;
		РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса);
		
		Результат = РегистрыСведений.ЛогиТрафика.ОчиститьИсторию(3);
		ЮТест.ОжидаетЧто(Результат.УдаленоЗаписей).БольшеИлиРавно(1);
		
		КлючЗаписи = ЮТOneSnifferТестовыеДанные.КлючЗаписиЛога(ЛогЗапроса);
		ТекстЛога = ЛогированиеТрафика.ПолучитьТекстЛога(КлючЗаписи);
		ЮТест.ОжидаетЧто(ТекстЛога).ЭтоНеопределено();
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

Процедура ОчиститьИсторию_НольДнейНеУдаляет() Экспорт
	
	Результат = РегистрыСведений.ЛогиТрафика.ОчиститьИсторию(0);
	ЮТест.ОжидаетЧто(Результат.УдаленоЗаписей).Равно(0);
	
КонецПроцедуры

Процедура ПолучитьКодCurl_СодержитМетодИURL() Экспорт
	
	Исходные = ЮТOneSnifferТестовыеДанные.ВключитьЛогированиеВРС();
	
	Попытка
		
		ЛогЗапроса = ЮТOneSnifferТестовыеДанные.НовыйИсходящийЛогДляТеста(
			"OneSniffer.CurlТест");
		РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса);
		
		КлючЗаписи = ЮТOneSnifferТестовыеДанные.КлючЗаписиЛога(ЛогЗапроса);
		КодCurl = ЛогированиеТрафика.ПолучитьКодCurl(КлючЗаписи);
		
		ЮТест.ОжидаетЧто(КодCurl).Содержит("curl");
		ЮТест.ОжидаетЧто(КодCurl).Содержит("example.test");
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

#КонецОбласти

