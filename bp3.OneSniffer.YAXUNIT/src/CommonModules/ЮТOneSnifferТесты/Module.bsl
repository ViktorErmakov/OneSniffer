// Серверные тесты OneSniffer: настройки, конвертация, протокол, РС (P0–P1).
// Обращения к ЛогированиеТрафика / _HTTPСервис / РС ЛогиТрафика резолвятся
// в рантайме при подключённом расширении bp3.OneSniffer (как у Kanban).

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("OneSniffer.Настройки")
			.ДобавитьСерверныйТест("НовыйНастройкиЛогирования_ФлагиВыключены")
			.ДобавитьСерверныйТест("СохранитьЗагрузитьНастройкиЛогирования_RoundTrip")
			.ДобавитьСерверныйТест("СобытияЖурнала_ИменаСтабильны")
		.ДобавитьТестовыйНабор("OneSniffer.КонвертацияИПротокол")
			.ДобавитьСерверныйТест("СтруктураURI_HTTPSПортПоУмолчанию")
			.ДобавитьСерверныйТест("СтруктураURI_ЯвныйПорт")
			.ДобавитьСерверныйТест("ПолучитьСтрокуURLЗапроса_HTTPSБезСтандартногоПорта")
			.ДобавитьСерверныйТест("ПолучитьСтрокуURLЗапроса_НестандартныйПортИПараметры")
			.ДобавитьСерверныйТест("РасшифровкаКодаСостоянияHTTP_ИзвестныеИНеизвестный")
			.ДобавитьСерверныйТест("ЗначениеВJSON_И_ЗначениеИзСтрокиJSON")
			.ДобавитьСерверныйТест("ОтформатироватьJSONДляОтображения")
			.ДобавитьСерверныйТест("ПроверитьУстановитьПеременныеВСтроке_GuidИTime")
			.ДобавитьСерверныйТест("ПроверитьУстановитьПеременныеВСтроке_ПутьВКэше")
		.ДобавитьТестовыйНабор("OneSniffer.СекретыИПодготовка")
			.ДобавитьСерверныйТест("МаскироватьСекретныеЗаголовки_CookieИApiKey")
			.ДобавитьСерверныйТест("МаскироватьСекретныеЗаголовки_BearerСохраняется")
			.ДобавитьСерверныйТест("Authorization_GetSetDelete")
			.ДобавитьСерверныйТест("ПодготовитьЛог_РегистрБезТела")
			.ДобавитьСерверныйТест("ПодготовитьЛог_РегистрСТеломИЛимитом")
		.ДобавитьТестовыйНабор("OneSniffer.Регистр")
			.ДобавитьСерверныйТест("ЗаписатьЛог_И_ПолучитьТекстЛога")
			.ДобавитьСерверныйТест("ОчиститьИсторию_УдаляетСтарые")
			.ДобавитьСерверныйТест("ОчиститьИсторию_НольДнейНеУдаляет")
			.ДобавитьСерверныйТест("ПолучитьКодCurl_СодержитМетодИURL")
		.ДобавитьТестовыйНабор("OneSniffer.Входящий")
			.ДобавитьСерверныйТест("ЗаписатьВходящийЛог_ПриВыключенномЛогированииНеПишет")
			.ДобавитьСерверныйТест("ЗаписатьВходящийЛог_ПишетВРС")
	;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Настройки

Процедура НовыйНастройкиЛогирования_ФлагиВыключены() Экспорт
	
	Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
	
	ЮТест.ОжидаетЧто(Настройки.ВключеноЛогирование).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Настройки.ЗаписыватьВРС).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Настройки.ЗаписыватьВЖР).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Настройки.ЗаписыватьВРСТело).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Настройки.МаксимальныйРазмерТела).Равно(0);
	ЮТест.ОжидаетЧто(Настройки.СрокХранения).Равно(0);
	ЮТест.ОжидаетЧто(Настройки.Редактор).ИмеетТип(Тип("Структура"));
	
КонецПроцедуры

Процедура СохранитьЗагрузитьНастройкиЛогирования_RoundTrip() Экспорт
	
	Исходные = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	
	Попытка
		
		Ожидаемые = ЛогированиеТрафика.НовыйНастройкиЛогирования();
		Ожидаемые.ВключеноЛогирование = Истина;
		Ожидаемые.ЗаписыватьВРС = Истина;
		Ожидаемые.ЗаписыватьВРСТело = Истина;
		Ожидаемые.МаксимальныйРазмерТела = 64;
		Ожидаемые.СрокХранения = 7;
		ЛогированиеТрафика.СохранитьНастройкиЛогирования(Ожидаемые);
		
		Фактически = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
		ЮТест.ОжидаетЧто(Фактически.ВключеноЛогирование).ЭтоИстина();
		ЮТест.ОжидаетЧто(Фактически.ЗаписыватьВРС).ЭтоИстина();
		ЮТест.ОжидаетЧто(Фактически.ЗаписыватьВРСТело).ЭтоИстина();
		ЮТест.ОжидаетЧто(Фактически.МаксимальныйРазмерТела).Равно(64);
		ЮТест.ОжидаетЧто(Фактически.СрокХранения).Равно(7);
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

Процедура СобытияЖурнала_ИменаСтабильны() Экспорт
	
	ЮТест.ОжидаетЧто(ЛогированиеТрафика.НаименованиеБиблиотеки())
		.Заполнено();
	ЮТест.ОжидаетЧто(ЛогированиеТрафика.СобытиеВызватьHTTPМетод())
		.Содержит("OneSniffer");
	ЮТест.ОжидаетЧто(ЛогированиеТрафика.СобытиеОбработатьHTTPСервис())
		.Содержит("OneSniffer");
	
КонецПроцедуры

#КонецОбласти

#Область КонвертацияИПротокол

Процедура СтруктураURI_HTTPSПортПоУмолчанию() Экспорт
	
	URI = ЛогированиеТрафика.СтруктураURI("https://host.example/path?x=1");
	
	ЮТест.ОжидаетЧто(URI.Схема).Равно("https");
	ЮТест.ОжидаетЧто(URI.Хост).Равно("host.example");
	ЮТест.ОжидаетЧто(URI.Порт).Равно(443);
	ЮТест.ОжидаетЧто(URI.ПутьНаСервере).Содержит("path");
	
КонецПроцедуры

Процедура СтруктураURI_ЯвныйПорт() Экспорт
	
