Процедура ЗаписатьВходящийЛог_ПриВыключенномЛогированииНеПишет() Экспорт
	
	Исходные = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	
	Попытка
		
		Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
		ЗаполнитьЗначенияСвойств(Настройки, Исходные);
		Настройки.ВключеноЛогирование = Ложь;
		Настройки.ЗаписыватьВРС = Истина;
		ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
		
		Запрос = ЮТест.Данные().HTTPСервисЗапрос()
			.Метод("GET")
			.БазовыйURL("https://host.test")
			.ОтносительныйURL("/hs/onesniffer/ping");
		Ответ = Новый HTTPСервисОтвет(200);
		
		ВремяДо = ТекущаяДатаСеанса();
		_HTTPСервис.ЗаписатьВходящийЛог(Запрос, "OneSniffer.ВходящийВыкл", Ответ);
		
		// Контроль: свежих записей с этим событием быть не должно.
		ЗапросПроверки = Новый Запрос;
		ЗапросПроверки.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛогиТрафика.Событие КАК Событие
		|ИЗ
		|	РегистрСведений.ЛогиТрафика КАК ЛогиТрафика
		|ГДЕ
		|	ЛогиТрафика.Событие = &Событие
		|	И ЛогиТрафика.Дата >= &Дата";
		ЗапросПроверки.УстановитьПараметр("Событие", "OneSniffer.ВходящийВыкл");
		ЗапросПроверки.УстановитьПараметр("Дата", ВремяДо);
		ЮТест.ОжидаетЧто(ЗапросПроверки.Выполнить().Пустой()).ЭтоИстина();
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

Процедура ЗаписатьВходящийЛог_ПишетВРС() Экспорт
	
	Исходные = ЮТOneSnifferТестовыеДанные.ВключитьЛогированиеВРС();
	
	Попытка
		
		ИмяСобытия = "OneSniffer.ВходящийВкл." + Строка(Новый УникальныйИдентификатор);
		Запрос = ЮТест.Данные().HTTPСервисЗапрос()
			.Метод("GET")
			.БазовыйURL("https://host.test")
			.ОтносительныйURL("/hs/onesniffer/ping");
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json");
		
		ВремяДо = ТекущаяДатаСеанса();
		_HTTPСервис.ЗаписатьВходящийЛог(Запрос, ИмяСобытия, Ответ);
		
		ЗапросПроверки = Новый Запрос;
		ЗапросПроверки.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЛогиТрафика.Входящий КАК Входящий,
		|	ЛогиТрафика.КодОтвета КАК КодОтвета,
		|	ЛогиТрафика.Событие КАК Событие
		|ИЗ
		|	РегистрСведений.ЛогиТрафика КАК ЛогиТрафика
		|ГДЕ
		|	ЛогиТрафика.Событие = &Событие
		|	И ЛогиТрафика.Дата >= &Дата";
		ЗапросПроверки.УстановитьПараметр("Событие", ИмяСобытия);
		ЗапросПроверки.УстановитьПараметр("Дата", ВремяДо);
		Результат = ЗапросПроверки.Выполнить();
		ЮТест.ОжидаетЧто(Результат.Пустой()).ЭтоЛожь();
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЮТест.ОжидаетЧто(Выборка.Входящий).ЭтоИстина();
		ЮТест.ОжидаетЧто(Выборка.КодОтвета).Равно(200);
		
	Исключение
		ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
		ВызватьИсключение;
	КонецПопытки;
	
	ЮТOneSnifferТестовыеДанные.ВосстановитьНастройкиЛогирования(Исходные);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
