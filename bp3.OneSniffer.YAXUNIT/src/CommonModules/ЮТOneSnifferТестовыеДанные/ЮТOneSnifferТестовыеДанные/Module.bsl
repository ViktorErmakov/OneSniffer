// Тестовые данные и фабрики для тестов OneSniffer (YAxUnit).

#Область СлужебныйПрограммныйИнтерфейс

// Собирает исходящий лог без реального HTTPСоединение.
//
// Параметры:
//  Событие - Строка
//  КодОтвета - Число
//
// Возвращаемое значение:
//  см. РегистрыСведений.ЛогиТрафика.НовыйСтруктураМенеджераЗаписи
//
Функция НовыйИсходящийЛогДляТеста(Событие = "OneSniffer.Тест", КодОтвета = 200) Экспорт
	
	ЛогЗапроса = РегистрыСведений.ЛогиТрафика.НовыйСтруктураМенеджераЗаписи();
	ЛогЗапроса.Дата = ТекущаяДатаСеанса();
	ЛогЗапроса.ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЛогЗапроса.НомерСеанса = НомерСеансаИнформационнойБазы();
	ЛогЗапроса.Сервер = "example.test";
	ЛогЗапроса.Порт = 443;
	ЛогЗапроса.Адрес = "/api/ping";
	ЛогЗапроса.Метод = Перечисления.МетодHTTP.GET;
	ЛогЗапроса.Входящий = Ложь;
	ЛогЗапроса.ЭтоЗащищенноеСоединение = Истина;
	ЛогЗапроса.Событие = Событие;
	ЛогЗапроса.КодОтвета = КодОтвета;
	ЛогЗапроса.Клиент = ИмяКомпьютера();
	ЛогЗапроса.Пользователь = "YAxUnit";
	ЛогЗапроса.Длительность = 0;
	ЛогЗапроса.Размер = 0;
	
	Содержание = РегистрыСведений.ЛогиТрафика.НовыйСодержание(
		Перечисления.НаправлениеHTTPЛога.Исходящий,
		Перечисления.НазначениеЛога.Рабочий);
	Содержание.ЗаголовкиЗапроса = Новый Соответствие;
	Содержание.ЗаголовкиОтвета = Новый Соответствие;
	Содержание.ЗаголовкиЗапроса.Вставить("Content-Type", "application/json");
	Содержание.ЗаголовкиОтвета.Вставить("Content-Type", "application/json");
	Содержание.ТелоЗапроса = ПолучитьДвоичныеДанныеИзСтроки("{ ""q"": 1 }");
	Содержание.ТелоОтвета = ПолучитьДвоичныеДанныеИзСтроки("{ ""ok"": true }");
	ЛогЗапроса.Содержание = Содержание;
	
	Возврат ЛогЗапроса;
	
КонецФункции

// Ключ записи РС по заполненному логу.
//
// Параметры:
//  ЛогЗапроса - Структура
//
// Возвращаемое значение:
//  Структура
//
Функция КлючЗаписиЛога(ЛогЗапроса) Экспорт
	
	КлючЗаписи = Новый Структура("НомерСеанса, ВремяНачала, Дата, Сервер");
	ЗаполнитьЗначенияСвойств(КлючЗаписи, ЛогЗапроса);
	Возврат КлючЗаписи;
	
КонецФункции

// Включает запись логов в РС с телами. Возвращает снимок настроек для восстановления.
//
// Возвращаемое значение:
//  см. ЛогированиеТрафика.НовыйНастройкиЛогирования
//
Функция ВключитьЛогированиеВРС() Экспорт
	
	Исходные = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	
	Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
	ЗаполнитьЗначенияСвойств(Настройки, Исходные);
	Настройки.ВключеноЛогирование = Истина;
	Настройки.ЗаписыватьВРС = Истина;
	Настройки.ЗаписыватьВРСТело = Истина;
	Настройки.ЗаписыватьВЖР = Ложь;
	Настройки.ЗаписыватьВЖРТело = Ложь;
	Настройки.МаксимальныйРазмерТела = 0;
	ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
	
	Возврат Исходные;
	
КонецФункции

// Восстанавливает ранее сохранённые настройки логирования.
//
// Параметры:
//  Настройки - см. ЛогированиеТрафика.НовыйНастройкиЛогирования
//
Процедура ВосстановитьНастройкиЛогирования(Настройки) Экспорт
	
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
	КонецЕсли;
	
КонецПроцедуры

// Markdown одного исходящего GET без ответа.
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстMarkdownИсходящегоGET() Экспорт
	
	Строки = Новый Массив;
	Строки.Добавить("### OneSniffer.ИмпортТест");
	Строки.Добавить("GET https://example.test/api/ping");
	Строки.Добавить("Content-Type: application/json");
	Строки.Добавить("");
	Строки.Добавить("{ ""q"": 1 }");
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

#КонецОбласти
