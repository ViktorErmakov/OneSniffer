// Клиентский мост к Monaco Editor (паттерн bsl_console).
// Тонкий/толстый: ZIP → TEMP\OneSniffer_Monaco\ → уникальная копия *.html.
// Веб: HTML = HTTPS URL статики (АдресСтатикиРедактора); без file://.
// Языки: json | rest | bsl | plaintext. Метаданные 1С / bslGlobals не подключаются.

#Область ПрограммныйИнтерфейс

// Распаковывает макет (один раз) и подставляет путь/URL в реквизит поля HTML.
// После присвоения платформа навигирует поле; дальше — ДокументСформирован.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - реквизиты АдресМакетаРедактора, КаталогРедактора,
//          ИсходникиРедактораЗагружены
//  ИмяРеквизитаHTML - Строка
//
Процедура ОбеспечитьЗагрузкуМакета(Форма, ИмяРеквизитаHTML) Экспорт
	
	Если ЗначениеЗаполнено(Форма[ИмяРеквизитаHTML]) Тогда
		Форма.ИсходникиРедактораЗагружены = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИмяРеквизитаHTML = "HTMLТелоОтвета" Тогда
		ОбеспечитьЗагрузкуМакетаSingle(Форма, ИмяРеквизитаHTML);
		Возврат;
	КонецЕсли;
	
#Если ВебКлиент Тогда
	
	АдресСтатики = OneSniffer_РедакторКодаКлиентСервер.АдресСтатикиРедактора();
	Если ПустаяСтрока(АдресСтатики) Тогда
		Возврат;
	КонецЕсли;
	
	Форма[ИмяРеквизитаHTML] = АдресСтатики;
	Форма.ИсходникиРедактораЗагружены = Истина;
	
#Иначе
	
	Если ПустаяСтрока(Форма.КаталогРедактора) Тогда
		Форма.КаталогРедактора = ОбеспечитьКаталогМакета(Форма);
	КонецЕсли;
	
	Если ПустаяСтрока(Форма.КаталогРедактора) Тогда
		Возврат;
	КонецЕсли;
	
	Разделитель = ПолучитьРазделительПути();
	ТочкаВхода = Форма.КаталогРедактора + Разделитель + "index.html";
	УникальныйФайл = Форма.КаталогРедактора + Разделитель
		+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0")
		+ "_" + ИмяРеквизитаHTML + ".html";
	
	КопироватьФайл(ТочкаВхода, УникальныйФайл);
	
	Форма[ИмяРеквизитаHTML] = УникальныйФайл;
	Форма.ИсходникиРедактораЗагружены = Истина;
	
#КонецЕсли
	
КонецПроцедуры

// Обработчик ДокументСформирован: init + текст + опции (как ConsoleOnReady в bsl_console).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ПолеФормы
//  Текст - Строка
//  Язык - Строка - json | rest | bsl | plaintext
//  ТолькоПросмотр - Булево
//
Процедура ОбработчикДокументСформирован(Форма, Элемент, Текст = "", Язык = "plaintext",
	ТолькоПросмотр = Истина) Экспорт
	
	Если Не Форма.ИсходникиРедактораЗагружены Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РедакторДоступен(Элемент) Тогда
		Возврат;
	КонецЕсли;
	
	Окно = Элемент.Документ.defaultView;
	Окно.init();
	ПрименитьНастройкиКОкну(Окно, OneSniffer_РедакторКодаВызовСервера.ЗагрузитьНастройкиРедактора());
	Окно.setLanguageMode(Язык);
	Окно.setReadOnly(ТолькоПросмотр);
	Окно.updateText(ТекстДляРедактора(Текст));
	Если Язык = "json" Тогда
		Окно.formatDocument();
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает текст в уже загруженный редактор.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  Текст - Строка
//  Язык - Строка - json | rest | bsl | plaintext; пустая строка = не менять
//  ТолькоПросмотр - Булево, Неопределено - Неопределено = не менять
//
Процедура УстановитьТекстРедактора(Форма, ИмяПоля, Текст, Язык = "", ТолькоПросмотр = Неопределено) Экспорт
	
	Элемент = Форма.Элементы[ИмяПоля];
	Если Не РедакторДоступен(Элемент) Тогда
		Возврат;
	КонецЕсли;
	
	Окно = Элемент.Документ.defaultView;
	
	Если ЗначениеЗаполнено(Язык) Тогда
		Окно.setLanguageMode(Язык);
	КонецЕсли;
	Если ТолькоПросмотр <> Неопределено Тогда
		Окно.setReadOnly(ТолькоПросмотр);
	КонецЕсли;
	Окно.updateText(ТекстДляРедактора(Текст));
	Если Язык = "json" Тогда
		Окно.formatDocument();
	КонецЕсли;
	
КонецПроцедуры

// Возвращает текст из редактора; пустая строка, если JS API недоступен.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьТекстРедактора(Форма, ИмяПоля) Экспорт
	
	Элемент = Форма.Элементы[ИмяПоля];
	Если Не РедакторДоступен(Элемент) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Элемент.Документ.defaultView.getText());
	
КонецФункции

// Применяет настройки ко всем указанным полям HTML.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИменаПолей - Массив из Строка
//  Настройки - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Процедура ПрименитьНастройкиКРедакторам(Форма, ИменаПолей, Настройки) Экспорт
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		
		Элемент = Форма.Элементы.Найти(ИмяПоля);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не РедакторДоступен(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		ПрименитьНастройкиКОкну(Элемент.Документ.defaultView, Настройки);
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет доступность JS API редактора (аналог ВебДокументДоступен в bsl_console).
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML-документа
//
// Возвращаемое значение:
//  Булево
//
Функция РедакторДоступен(Элемент) Экспорт
	
	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Если Элемент.Документ = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Элемент.Документ.defaultView = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Элемент.Документ.defaultView.getText();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Эксперимент: single-page HTML из макета OneSniffer_MonacoEditorSingle (поле «Ответ»).
//
Процедура ОбеспечитьЗагрузкуМакетаSingle(Форма, ИмяРеквизитаHTML)
	
	Если ЗначениеЗаполнено(Форма[ИмяРеквизитаHTML]) Тогда
		Форма.ИсходникиРедактораЗагружены = Истина;
		Возврат;
	КонецЕсли;
	
#Если ВебКлиент Тогда
	
	// Веб: пробуем подставить HTML-строку из макета; иначе fallback на URL статики.
	Если ПустаяСтрока(Форма.АдресМакетаРедактораSingle) Тогда
		Форма.АдресМакетаРедактораSingle = OneSniffer_РедакторКодаВызовСервера.АдресМакетаРедактораSingle(
			Форма.УникальныйИдентификатор);
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Форма.АдресМакетаРедактораSingle);
	Если ДвоичныеДанные <> Неопределено Тогда
		Форма[ИмяРеквизитаHTML] = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные);
		Форма.ИсходникиРедактораЗагружены = Истина;
		Возврат;
	КонецЕсли;
	
	АдресСтатики = OneSniffer_РедакторКодаКлиентСервер.АдресСтатикиРедактора();
	Если ПустаяСтрока(АдресСтатики) Тогда
		Возврат;
	КонецЕсли;
	Форма[ИмяРеквизитаHTML] = АдресСтатики;
	Форма.ИсходникиРедактораЗагружены = Истина;
	
#Иначе
	
	Если ПустаяСтрока(Форма.КаталогРедактора) Тогда
		Форма.КаталогРедактора = ОбеспечитьКаталогМакета(Форма);
	КонецЕсли;
	
	Разделитель = ПолучитьРазделительПути();
	КаталогРедактора = ?(ПустаяСтрока(Форма.КаталогРедактора),
		КаталогВременныхФайлов() + "OneSniffer_Monaco" + Разделитель,
		Форма.КаталогРедактора);
	
	Если ПустаяСтрока(Форма.АдресМакетаРедактораSingle) Тогда
		Форма.АдресМакетаРедактораSingle = OneSniffer_РедакторКодаВызовСервера.АдресМакетаРедактораSingle(
			Форма.УникальныйИдентификатор);
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Форма.АдресМакетаРедактораSingle);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьКаталог(КаталогРедактора);
	ТочкаВхода = КаталогРедактора + "editor.single.html";
	ФайлТочки = Новый Файл(ТочкаВхода);
	Если Не ФайлТочки.Существует() Тогда
		ДвоичныеДанные.Записать(ТочкаВхода);
	КонецЕсли;
	
	УникальныйФайл = КаталогРедактора
		+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0")
		+ "_" + ИмяРеквизитаHTML + "_single.html";
	КопироватьФайл(ТочкаВхода, УникальныйФайл);
	
	Форма[ИмяРеквизитаHTML] = УникальныйФайл;
	Форма.ИсходникиРедактораЗагружены = Истина;
	
#КонецЕсли
	
КонецПроцедуры

#Если Не ВебКлиент Тогда

Функция ОбеспечитьКаталогМакета(Форма)
	
	КаталогРедактора = КаталогВременныхФайлов() + "OneSniffer_Monaco"
		+ ПолучитьРазделительПути();
	ВерсияМакета = OneSniffer_РедакторКодаКлиентСервер.ВерсияМакетаРедактора();
	ФайлВерсии = КаталогРедактора + ВерсияМакета + ".ver";
	ФайлИндекса = КаталогРедактора + "index.html";
	
	ФайлВерсииНаДиске = Новый Файл(ФайлВерсии);
	ФайлИндексаНаДиске = Новый Файл(ФайлИндекса);
	Если ФайлВерсииНаДиске.Существует() И ФайлИндексаНаДиске.Существует() Тогда
		Возврат КаталогРедактора;
	КонецЕсли;
	
	Если ПустаяСтрока(Форма.АдресМакетаРедактора) Тогда
		Форма.АдресМакетаРедактора = OneSniffer_РедакторКодаВызовСервера.АдресМакетаРедактора(
			Форма.УникальныйИдентификатор);
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Форма.АдресМакетаРедактора);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СоздатьКаталог(КаталогРедактора);
	
	УдалитьФайлы(КаталогРедактора, "*.*");
	
	ИмяАрхива = КаталогРедактора + "editor.zip";
	ДвоичныеДанные.Записать(ИмяАрхива);
	
	ЧтениеАрхива = Новый ЧтениеZipФайла(ИмяАрхива);
	ЧтениеАрхива.ИзвлечьВсе(КаталогРедактора);
	ЧтениеАрхива.Закрыть();
	
	УдалитьФайлы(ИмяАрхива);
	
	ЗаписьВерсии = Новый ЗаписьТекста(ФайлВерсии, КодировкаТекста.UTF8);
	ЗаписьВерсии.ЗаписатьСтроку(ВерсияМакета);
	ЗаписьВерсии.Закрыть();
	
	Возврат КаталогРедактора;
	
КонецФункции

#КонецЕсли

Функция ТекстДляРедактора(Текст)
	
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Текст);
	
КонецФункции

Процедура ПрименитьНастройкиКОкну(Окно, Настройки)
	
	Опции = OneSniffer_РедакторКодаКлиентСервер.ОпцииMonacoИзНастроек(Настройки);
	
	Окно.setTheme(Опции.theme);
	Окно.setFontSize(Опции.fontSize);
	Окно.wordWrap(Опции.wordWrap = "on");
	Окно.minimap(Опции.minimap.enabled);
	Если Опции.lineNumbers = "on" Тогда
		Окно.showLineNumbers();
	Иначе
		Окно.hideLineNumbers();
	КонецЕсли;
	Окно.setOption("folding", Опции.folding);
	Окно.setOption("formatOnPaste", Опции.formatOnPaste);
	Окно.setOption("tabSize", Опции.tabSize);
	
КонецПроцедуры

#КонецОбласти
