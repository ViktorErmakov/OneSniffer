// Без @strict-types: мост работает с DOM (Документ.defaultView, V8Proxy) и нетипизированным
// реквизитом формы КэшМостаРедактора — строгая типизация здесь недостижима.

// Клиентский мост к Monaco Editor (туннель V8Proxy, см. html-v8proxy-bridge.mdc).
// Страница подставляется в реквизит поля HTML на сервере (OneSniffer_РедакторКода.ПодготовитьРедакторыНаФорме).
// JS→1С: #V8_request.click → ПриНажатии; 1С→JS: defaultView["V8Proxy"].sendResponse.
// Состояния редакторов и ожидания экспорта хранятся в реквизите формы КэшМостаРедактора.

#Область ПрограммныйИнтерфейс

// Обработчик ПриНажатии поля HTML: команды с #V8_request.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с реквизитом КэшМостаРедактора
//  Элемент - ПолеФормы - поле HTML-документа
//  ДанныеСобытия - Произвольный - данные события DOM
//  СтандартнаяОбработка - Булево
//
Процедура ОбработчикПриНажатии(Форма, Элемент, ДанныеСобытия, СтандартнаяОбработка) Экспорт
	
	Если ДанныеСобытия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСобытия.Href) Тогда
		СтандартнаяОбработка = Ложь;
		ПерейтиПоНавигационнойСсылке(ДанныеСобытия.Href);
		Возврат;
	КонецЕсли;
	
	Если ДанныеСобытия.Button = Неопределено Тогда
		Кнопка = ДанныеСобытия.Element;
	Иначе
		Кнопка = ДанныеСобытия.Button;
	КонецЕсли;
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Кнопка.id <> "V8_request" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	Событие = Строка(Кнопка.value);
	
	Если Событие = "ready" Тогда
		
		ОбработатьReadyРедактора(Форма, Элемент);
		
	ИначеЕсли Событие = "exportText" Тогда
		
		Текст = "";
		Попытка
			Текст = Строка(Кнопка.textContent);
		Исключение
			Текст = "";
		КонецПопытки;
		ЗавершитьОжиданиеЭкспорта(Форма, Элемент.Имя, Текст);
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает текст / язык / режим просмотра (через V8Proxy.sendResponse setState).
// До готовности страницы состояние хранится на форме и отправляется в ответ на ready.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  Текст - Строка
//  Язык - Строка - json | rest | bsl | plaintext; пустая строка = не менять
//  ТолькоПросмотр - Булево, Неопределено - Неопределено = не менять
//  НастройкиРедактора - Структура, Неопределено - если заданы, кладутся в состояние
//
Процедура УстановитьТекстРедактора(Форма, ИмяПоля, Текст, Язык = "", ТолькоПросмотр = Неопределено,
	НастройкиРедактора = Неопределено) Экспорт
	
	Состояние = ПолучитьСостояниеРедактора(Форма, ИмяПоля);
	Состояние.Текст = ТекстДляРедактора(Текст);
	
	Если ЗначениеЗаполнено(Язык) Тогда
		Состояние.Язык = Язык;
	КонецЕсли;
	Если ТолькоПросмотр <> Неопределено Тогда
		Состояние.ТолькоПросмотр = ТолькоПросмотр;
	КонецЕсли;
	Если ТипЗнч(НастройкиРедактора) = Тип("Структура") Тогда
		Состояние.Настройки = НастройкиРедактора;
	КонецЕсли;
	Состояние.ФорматироватьJSON = (Состояние.Язык = "json");
	
	ЗаписатьСостояниеРедактора(Форма, ИмяПоля, Состояние);
	
	Если Состояние.Готов Тогда
		ОтправитьСостояниеВРедактор(Форма, ИмяПоля, Состояние);
	КонецЕсли;
	
КонецПроцедуры

// Запрашивает текст редактора: requestExport → exportText → оповещение.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  ОписаниеОповещения - ОписаниеОповещения - результат: Строка (текст редактора)
//
Процедура ЗапроситьТекстРедактора(Форма, ИмяПоля, ОписаниеОповещения) Экспорт
	
	Элемент = Форма.Элементы.Найти(ИмяПоля);
	Если Элемент = Неопределено Или Не РедакторДоступен(Элемент) Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, "");
		Возврат;
	КонецЕсли;
	
	Кэш = КэшМоста(Форма);
	Кэш.ОжиданияЭкспорта.Вставить(ИмяПоля, ОписаниеОповещения);
	Форма.КэшМостаРедактора = Кэш;
	
	ОтправитьОтвет(Элемент, "requestExport", "");
	
КонецПроцедуры

// Применяет настройки ко всем указанным полям HTML через applyOptions.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИменаПолей - Массив из Строка
//  Настройки - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Процедура ПрименитьНастройкиКРедакторам(Форма, ИменаПолей, Настройки) Экспорт
	
	Кэш = КэшМоста(Форма);
	Кэш.НастройкиПоУмолчанию = Настройки;
	Форма.КэшМостаРедактора = Кэш;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		
		Состояние = ПолучитьСостояниеРедактора(Форма, ИмяПоля);
		Состояние.Настройки = Настройки;
		ЗаписатьСостояниеРедактора(Форма, ИмяПоля, Состояние);
		
		Элемент = Форма.Элементы.Найти(ИмяПоля);
		Если Элемент = Неопределено Или Не РедакторДоступен(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		Пакет = Новый Структура;
		Пакет.Вставить("options", OneSniffer_РедакторКодаКлиентСервер.ОпцииMonacoИзНастроек(Настройки));
		ОтправитьОтвет(Элемент, "applyOptions", Пакет);
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет доступность V8Proxy на странице поля HTML.
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML-документа
//
// Возвращаемое значение:
//  Булево
//
Функция РедакторДоступен(Элемент) Экспорт
	
	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Если Элемент.Документ = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Элемент.Документ.defaultView = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Прокси = Элемент.Документ.defaultView["V8Proxy"];
		Возврат Прокси <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Отправляет ответ в JS через V8Proxy.sendResponse.
//
// Параметры:
//  ЭлементПолеHTML - ПолеФормы - поле HTML-документа
//  Событие - Строка - имя команды протокола моста
//  Ответ - Произвольный - структура/массив → JSON; строка/двоичные
//
Процедура ОтправитьОтвет(Знач ЭлементПолеHTML, Знач Событие, Знач Ответ) Экспорт
	
	Если ЭлементПолеHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЭлементHTML = ЭлементПолеHTML.Документ.defaultView;
		Прокси = ЭлементHTML["V8Proxy"];
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Прокси = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пакет = "";
	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Ответ) = Тип("Структура")
		Или ТипЗнч(Ответ) = Тип("ФиксированнаяСтруктура")
		Или ТипЗнч(Ответ) = Тип("Соответствие")
		Или ТипЗнч(Ответ) = Тип("ФиксированноеСоответствие")
		Или ТипЗнч(Ответ) = Тип("Массив")
		Или ТипЗнч(Ответ) = Тип("ФиксированныйМассив") Тогда
		
		Пакет = OneSniffer_РедакторКодаКлиентСервер.ЗначениеВСтрокуJSON(Ответ);
		
	ИначеЕсли ТипЗнч(Ответ) = Тип("ДвоичныеДанные") Тогда
		
		Пакет = Base64Строка(Ответ);
		
	Иначе
		
		Пакет = Строка(Ответ);
		
	КонецЕсли;
	
	Прокси.sendResponse(Событие, Пакет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает кэш моста редакторов, хранимый в реквизите формы.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - реквизит КэшМостаРедактора (Произвольный)
//
// Возвращаемое значение:
//  Структура:
//   * Состояния - Соответствие из КлючИЗначение:
//    ** Ключ - Строка - имя поля HTML-документа
//    ** Значение - см. НовоеСостояниеРедактора
//   * ОжиданияЭкспорта - Соответствие из КлючИЗначение:
//    ** Ключ - Строка - имя поля HTML-документа
//    ** Значение - ОписаниеОповещения
//   * НастройкиПоУмолчанию - Структура, Неопределено - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Функция КэшМоста(Форма)
	
	Кэш = Форма.КэшМостаРедактора;
	
	Если ТипЗнч(Кэш) <> Тип("Структура") Тогда
		Кэш = Новый Структура;
		Кэш.Вставить("Состояния", Новый Соответствие);
		Кэш.Вставить("ОжиданияЭкспорта", Новый Соответствие);
		Кэш.Вставить("НастройкиПоУмолчанию", Неопределено);
		Форма.КэшМостаРедактора = Кэш;
	ИначеЕсли Не Кэш.Свойство("НастройкиПоУмолчанию") Тогда
		Кэш.Вставить("НастройкиПоУмолчанию", Неопределено);
		Форма.КэшМостаРедактора = Кэш;
	КонецЕсли;
	
	Возврат Кэш;
	
КонецФункции

// Новое состояние редактора поля HTML.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка
//   * Язык - Строка
//   * ТолькоПросмотр - Булево
//   * Настройки - Структура, Неопределено - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//   * ФорматироватьJSON - Булево
//   * Готов - Булево - страница прислала ready
//
Функция НовоеСостояниеРедактора()
	
	Состояние = Новый Структура;
	Состояние.Вставить("Текст", "");
	Состояние.Вставить("Язык", "plaintext");
	Состояние.Вставить("ТолькоПросмотр", Истина);
	Состояние.Вставить("Настройки", Неопределено);
	Состояние.Вставить("ФорматироватьJSON", Ложь);
	Состояние.Вставить("Готов", Ложь);
	Возврат Состояние;
	
КонецФункции

// Возвращает состояние редактора поля, создавая его при необходимости.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//
// Возвращаемое значение:
//  см. НовоеСостояниеРедактора
//
Функция ПолучитьСостояниеРедактора(Форма, ИмяПоля)
	
	Состояние = КэшМоста(Форма).Состояния.Получить(ИмяПоля);
	Если Состояние = Неопределено Тогда
		Состояние = НовоеСостояниеРедактора();
		ЗаписатьСостояниеРедактора(Форма, ИмяПоля, Состояние);
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

// Записывает состояние редактора поля в кэш моста на форме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  Состояние - см. НовоеСостояниеРедактора
//
Процедура ЗаписатьСостояниеРедактора(Форма, ИмяПоля, Состояние)
	
	Кэш = КэшМоста(Форма);
	Кэш.Состояния.Вставить(ИмяПоля, Состояние);
	Форма.КэшМостаРедактора = Кэш;
	
КонецПроцедуры

// Обрабатывает сигнал ready страницы: отдаёт отложенное состояние в редактор.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ПолеФормы - поле HTML-документа
//
Процедура ОбработатьReadyРедактора(Форма, Элемент)
	
	Состояние = ПолучитьСостояниеРедактора(Форма, Элемент.Имя);
	Состояние.Готов = Истина;
	
	Если ТипЗнч(Состояние.Настройки) <> Тип("Структура") Тогда
		НастройкиПоУмолчанию = КэшМоста(Форма).НастройкиПоУмолчанию;
		Если ТипЗнч(НастройкиПоУмолчанию) = Тип("Структура") Тогда
			Состояние.Настройки = НастройкиПоУмолчанию;
		Иначе
			Состояние.Настройки = OneSniffer_РедакторКодаВызовСервера.ЗагрузитьНастройкиРедактора();
		КонецЕсли;
	КонецЕсли;
	
	ЗаписатьСостояниеРедактора(Форма, Элемент.Имя, Состояние);
	ОтправитьСостояниеВРедактор(Форма, Элемент.Имя, Состояние);
	
КонецПроцедуры

// Отправляет пакет setState в редактор поля.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  Состояние - см. НовоеСостояниеРедактора
//
Процедура ОтправитьСостояниеВРедактор(Форма, ИмяПоля, Состояние)
	
	Элемент = Форма.Элементы.Найти(ИмяПоля);
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = Состояние.Настройки;
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию();
	КонецЕсли;
	
	Пакет = Новый Структура;
	Пакет.Вставить("text", Состояние.Текст);
	Пакет.Вставить("language", Состояние.Язык);
	Пакет.Вставить("readOnly", Состояние.ТолькоПросмотр);
	Пакет.Вставить("options", OneSniffer_РедакторКодаКлиентСервер.ОпцииMonacoИзНастроек(Настройки));
	Пакет.Вставить("formatJson", Состояние.ФорматироватьJSON);
	
	ОтправитьОтвет(Элемент, "setState", Пакет);
	
КонецПроцедуры

// Завершает ожидание exportText: кэширует текст и вызывает оповещение.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  Текст - Строка - текст редактора
//
Процедура ЗавершитьОжиданиеЭкспорта(Форма, ИмяПоля, Текст)
	
	Кэш = КэшМоста(Форма);
	ОписаниеОповещения = Кэш.ОжиданияЭкспорта.Получить(ИмяПоля);
	Кэш.ОжиданияЭкспорта.Удалить(ИмяПоля);
	Форма.КэшМостаРедактора = Кэш;
	
	Состояние = ПолучитьСостояниеРедактора(Форма, ИмяПоля);
	Состояние.Текст = ТекстДляРедактора(Текст);
	ЗаписатьСостояниеРедактора(Форма, ИмяПоля, Состояние);
	
	Если ОписаниеОповещения <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Состояние.Текст);
	КонецЕсли;
	
КонецПроцедуры

// Приводит значение к тексту для редактора.
//
// Параметры:
//  Текст - Произвольный - исходное значение
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстДляРедактора(Текст)
	
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Текст);
	
КонецФункции

#КонецОбласти
