// Клиентский мост к Monaco Editor (паттерн bsl_console).
// Макет: single-page HTML (ТекстМакетаРедактора с сервера).
// Веб: HTML-строка в поле; тонкий/толстый: TEMP + уникальная копия *.html.
// Языки: json | rest | bsl | plaintext. Метаданные 1С / bslGlobals не подключаются.

#Область ПрограммныйИнтерфейс

// Подставляет single-page HTML в реквизит поля (из ТекстМакетаРедактора формы).
// После присвоения платформа навигирует поле; дальше — ДокументСформирован.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - ТекстМакетаРедактора, ИсходникиРедактораЗагружены,
//          опционально КаталогРедактора (тонкий/толстый)
//  ИмяРеквизитаHTML - Строка
//
Процедура ОбеспечитьЗагрузкуМакета(Форма, ИмяРеквизитаHTML) Экспорт
	
	Если ЗначениеЗаполнено(Форма[ИмяРеквизитаHTML]) Тогда
		Форма.ИсходникиРедактораЗагружены = Истина;
		Возврат;
	КонецЕсли;
	
	ТекстМакета = "";
	Попытка
		ТекстМакета = Форма.ТекстМакетаРедактора;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ПустаяСтрока(ТекстМакета) Тогда
		Возврат;
	КонецЕсли;
	
#Если ВебКлиент Тогда
	
	Форма[ИмяРеквизитаHTML] = ТекстМакета;
	Форма.ИсходникиРедактораЗагружены = Истина;
	
#Иначе
	
	КаталогРедактора = ОбеспечитьКаталогSingleИзСтроки(Форма, ТекстМакета);
	Если ПустаяСтрока(КаталогРедактора) Тогда
		Возврат;
	КонецЕсли;
	
	Разделитель = ПолучитьРазделительПути();
	ТочкаВхода = КаталогРедактора + "editor.single.html";
	УникальныйФайл = КаталогРедактора
		+ Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0")
		+ "_" + ИмяРеквизитаHTML + "_single.html";
	КопироватьФайл(ТочкаВхода, УникальныйФайл);
	
	Форма[ИмяРеквизитаHTML] = УникальныйФайл;
	Форма.ИсходникиРедактораЗагружены = Истина;
	
#КонецЕсли
	
КонецПроцедуры

// Обработчик ДокументСформирован: init + текст + опции (как ConsoleOnReady в bsl_console).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  Элемент - ПолеФормы
//  Текст - Строка
//  Язык - Строка - json | rest | bsl | plaintext
//  ТолькоПросмотр - Булево
//  НастройкиРедактора - Структура, Неопределено - см. НастройкиРедактораПоУмолчанию;
//                       если Неопределено — загрузка с сервера
//
Процедура ОбработчикДокументСформирован(Форма, Элемент, Текст = "", Язык = "plaintext",
	ТолькоПросмотр = Истина, НастройкиРедактора = Неопределено) Экспорт
	
	Если Не Форма.ИсходникиРедактораЗагружены Тогда
		Возврат;
	КонецЕсли;
	
	Если Не РедакторДоступен(Элемент) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(НастройкиРедактора) <> Тип("Структура") Тогда
		НастройкиРедактора = OneSniffer_РедакторКодаВызовСервера.ЗагрузитьНастройкиРедактора();
	КонецЕсли;
	
	Окно = Элемент.Документ.defaultView;
	Окно.init();
	ПрименитьНастройкиКОкну(Окно, НастройкиРедактора);
	Окно.setLanguageMode(Язык);
	Окно.setReadOnly(ТолькоПросмотр);
	Окно.updateText(ТекстДляРедактора(Текст));
	Если Язык = "json" Тогда
		Окно.formatDocument();
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает текст в уже загруженный редактор.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//  Текст - Строка
//  Язык - Строка - json | rest | bsl | plaintext; пустая строка = не менять
//  ТолькоПросмотр - Булево, Неопределено - Неопределено = не менять
//
Процедура УстановитьТекстРедактора(Форма, ИмяПоля, Текст, Язык = "", ТолькоПросмотр = Неопределено) Экспорт
	
	Элемент = Форма.Элементы[ИмяПоля];
	Если Не РедакторДоступен(Элемент) Тогда
		Возврат;
	КонецЕсли;
	
	Окно = Элемент.Документ.defaultView;
	
	Если ЗначениеЗаполнено(Язык) Тогда
		Окно.setLanguageMode(Язык);
	КонецЕсли;
	Если ТолькоПросмотр <> Неопределено Тогда
		Окно.setReadOnly(ТолькоПросмотр);
	КонецЕсли;
	Окно.updateText(ТекстДляРедактора(Текст));
	Если Язык = "json" Тогда
		Окно.formatDocument();
	КонецЕсли;
	
КонецПроцедуры

// Возвращает текст из редактора; пустая строка, если JS API недоступен.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИмяПоля - Строка - имя поля HTML-документа
//
// Возвращаемое значение:
//  Строка
//
Функция ПолучитьТекстРедактора(Форма, ИмяПоля) Экспорт
	
	Элемент = Форма.Элементы[ИмяПоля];
	Если Не РедакторДоступен(Элемент) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Элемент.Документ.defaultView.getText());
	
КонецФункции

// Применяет настройки ко всем указанным полям HTML.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИменаПолей - Массив из Строка
//  Настройки - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Процедура ПрименитьНастройкиКРедакторам(Форма, ИменаПолей, Настройки) Экспорт
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		
		Элемент = Форма.Элементы.Найти(ИмяПоля);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Не РедакторДоступен(Элемент) Тогда
			Продолжить;
		КонецЕсли;
		
		ПрименитьНастройкиКОкну(Элемент.Документ.defaultView, Настройки);
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет доступность JS API редактора (аналог ВебДокументДоступен в bsl_console).
//
// Параметры:
//  Элемент - ПолеФормы - поле HTML-документа
//
// Возвращаемое значение:
//  Булево
//
Функция РедакторДоступен(Элемент) Экспорт
	
	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Если Элемент.Документ = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Элемент.Документ.defaultView = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Элемент.Документ.defaultView.getText();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Если Не ВебКлиент Тогда

// Пишет editor.single.html в TEMP по версии макета; возвращает каталог.
//
Функция ОбеспечитьКаталогSingleИзСтроки(Форма, ТекстМакета)
	
	Разделитель = ПолучитьРазделительПути();
	КаталогРедактора = КаталогВременныхФайлов() + "OneSniffer_Monaco" + Разделитель;
	
	Попытка
		Если Не ПустаяСтрока(Форма.КаталогРедактора) Тогда
			КаталогРедактора = Форма.КаталогРедактора;
			Если Прав(КаталогРедактора, 1) <> Разделитель Тогда
				КаталогРедактора = КаталогРедактора + Разделитель;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// реквизит КаталогРедактора может отсутствовать на форме
	КонецПопытки;
	
	ВерсияМакета = OneSniffer_РедакторКодаКлиентСервер.ВерсияМакетаРедактора();
	ФайлВерсии = КаталогРедактора + ВерсияМакета + ".ver";
	ТочкаВхода = КаталогРедактора + "editor.single.html";
	
	ФайлВерсииНаДиске = Новый Файл(ФайлВерсии);
	ФайлТочки = Новый Файл(ТочкаВхода);
	Если ФайлВерсииНаДиске.Существует() И ФайлТочки.Существует() Тогда
		Попытка
			Форма.КаталогРедактора = КаталогРедактора;
		Исключение
			// нет реквизита
		КонецПопытки;
		Возврат КаталогРедактора;
	КонецЕсли;
	
	СоздатьКаталог(КаталогРедактора);
	
	ПолучитьДвоичныеДанныеИзСтроки(ТекстМакета, КодировкаТекста.UTF8).Записать(ТочкаВхода);
	
	ЗаписьВерсии = Новый ЗаписьТекста(ФайлВерсии, КодировкаТекста.UTF8);
	ЗаписьВерсии.ЗаписатьСтроку(ВерсияМакета);
	ЗаписьВерсии.Закрыть();
	
	Попытка
		Форма.КаталогРедактора = КаталогРедактора;
	Исключение
		// нет реквизита
	КонецПопытки;
	
	Возврат КаталогРедактора;
	
КонецФункции

#КонецЕсли

Функция ТекстДляРедактора(Текст)
	
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Строка(Текст);
	
КонецФункции

Процедура ПрименитьНастройкиКОкну(Окно, Настройки)
	
	Опции = OneSniffer_РедакторКодаКлиентСервер.ОпцииMonacoИзНастроек(Настройки);
	
	Окно.setTheme(Опции.theme);
	Окно.setFontSize(Опции.fontSize);
	Окно.wordWrap(Опции.wordWrap = "on");
	Окно.minimap(Опции.minimap.enabled);
	Если Опции.lineNumbers = "on" Тогда
		Окно.showLineNumbers();
	Иначе
		Окно.hideLineNumbers();
	КонецЕсли;
	Окно.setOption("folding", Опции.folding);
	Окно.setOption("formatOnPaste", Опции.formatOnPaste);
	Окно.setOption("tabSize", Опции.tabSize);
	
КонецПроцедуры

#КонецОбласти
