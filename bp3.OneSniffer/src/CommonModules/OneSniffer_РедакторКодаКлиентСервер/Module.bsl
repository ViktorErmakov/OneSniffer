// Модуль общих настроек и утилит Monaco Editor для OneSniffer.

#Область ПрограммныйИнтерфейс

// Настройки редактора по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Тема - Строка
//   * РазмерШрифта - Число
//   * ПереносСтрок - Булево
//   * Миникарта - Булево
//   * НомераСтрок - Булево
//   * Сворачивание - Булево
//   * ФорматироватьПриВставке - Булево
//   * РазмерТабуляции - Число
//
Функция НастройкиРедактораПоУмолчанию() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Тема", "vs");
	Настройки.Вставить("РазмерШрифта", 15);
	Настройки.Вставить("ПереносСтрок", Истина);
	Настройки.Вставить("Миникарта", Ложь);
	Настройки.Вставить("НомераСтрок", Истина);
	Настройки.Вставить("Сворачивание", Истина);
	Настройки.Вставить("ФорматироватьПриВставке", Истина);
	Настройки.Вставить("РазмерТабуляции", 4);
	Возврат Настройки;
	
КонецФункции

// Маркер версии single-макета в TEMP (инвалидация кеша при смене макета).
// Увеличивайте при обновлении OneSniffer_MonacoEditorSingle / sync-monaco-maket.ps1.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияМакетаРедактора() Экспорт
	
	Возврат "20260803a";
	
КонецФункции

// Определяет язык Monaco по заголовкам HTTP (json | rest | plaintext).
// Метаданные конфигурации 1С в редактор не передаются.
//
// Параметры:
//  Заголовки - Соответствие из КлючИЗначение, Неопределено - заголовки HTTP
//  РежимREST - Булево - принудительно rest (произвольный запрос / протокол)
//
// Возвращаемое значение:
//  Строка - json | rest | plaintext
//
Функция ЯзыкРедактораПоЗаголовкам(Заголовки, РежимREST = Ложь) Экспорт
	
	Если РежимREST Тогда
		Возврат "rest";
	КонецЕсли;
	
	ТипКонтента = "";
	Если ТипЗнч(Заголовки) = Тип("Соответствие")
		Или ТипЗнч(Заголовки) = Тип("ФиксированноеСоответствие") Тогда
		ТипКонтента = НРег(Строка(Заголовки.Получить("Content-Type")));
		Если ПустаяСтрока(ТипКонтента) Тогда
			ТипКонтента = НРег(Строка(Заголовки.Получить("content-type")));
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(ТипКонтента, "json") > 0 Тогда
		Возврат "json";
	КонецЕсли;
	
	Возврат "plaintext";
	
КонецФункции

// Опции Monaco из структуры настроек OneSniffer.
//
// Параметры:
//  Настройки - Структура
//
// Возвращаемое значение:
//  Структура - поля для setOptions / init:
//   * theme - Строка
//   * fontSize - Число
//   * wordWrap - Строка
//   * minimap - Структура
//   * lineNumbers - Строка
//   * folding - Булево
//   * formatOnPaste - Булево
//   * tabSize - Число
//
Функция ОпцииMonacoИзНастроек(Настройки) Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = НастройкиРедактораПоУмолчанию();
	КонецЕсли;
	
	Опции = Новый Структура;
	Опции.Вставить("theme", Настройки.Тема);
	Опции.Вставить("fontSize", Настройки.РазмерШрифта);
	Если Настройки.ПереносСтрок Тогда
		Опции.Вставить("wordWrap", "on");
	Иначе
		Опции.Вставить("wordWrap", "off");
	КонецЕсли;
	Опции.Вставить("minimap", Новый Структура("enabled", Настройки.Миникарта));
	Если Настройки.НомераСтрок Тогда
		Опции.Вставить("lineNumbers", "on");
	Иначе
		Опции.Вставить("lineNumbers", "off");
	КонецЕсли;
	Опции.Вставить("folding", Настройки.Сворачивание);
	Опции.Вставить("formatOnPaste", Настройки.ФорматироватьПриВставке);
	Опции.Вставить("tabSize", Настройки.РазмерТабуляции);
	Возврат Опции;
	
КонецФункции

#КонецОбласти
