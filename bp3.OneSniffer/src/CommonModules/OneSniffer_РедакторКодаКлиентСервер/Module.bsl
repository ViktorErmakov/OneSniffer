// Модуль общих настроек и утилит Monaco Editor для OneSniffer.

#Область ПрограммныйИнтерфейс

// Настройки редактора по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Тема - Строка
//   * РазмерШрифта - Число
//   * ПереносСтрок - Булево
//   * Миникарта - Булево
//   * НомераСтрок - Булево
//   * Сворачивание - Булево
//   * ФорматироватьПриВставке - Булево
//   * РазмерТабуляции - Число
//
Функция НастройкиРедактораПоУмолчанию() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Тема", "vs");
	Настройки.Вставить("РазмерШрифта", 15);
	Настройки.Вставить("ПереносСтрок", Истина);
	Настройки.Вставить("Миникарта", Ложь);
	Настройки.Вставить("НомераСтрок", Истина);
	Настройки.Вставить("Сворачивание", Истина);
	Настройки.Вставить("ФорматироватьПриВставке", Истина);
	Настройки.Вставить("РазмерТабуляции", 4);
	Возврат Настройки;
	
КонецФункции

// Маркер версии single-макета в TEMP (инвалидация кеша при смене макета).
// Увеличивайте при обновлении OneSniffer_MonacoEditorSingle / sync-monaco-maket.ps1.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияМакетаРедактора() Экспорт
	
	Возврат "20260724a";
	
КонецФункции

// Определяет язык Monaco по заголовкам HTTP (json | rest | plaintext).
// Метаданные конфигурации 1С в редактор не передаются.
//
// Параметры:
//  Заголовки - Соответствие из КлючИЗначение, Неопределено - заголовки HTTP
//  РежимREST - Булево - принудительно rest (произвольный запрос / протокол)
//
// Возвращаемое значение:
//  Строка - json | rest | plaintext
//
Функция ЯзыкРедактораПоЗаголовкам(Заголовки, РежимREST = Ложь) Экспорт
	
	Если РежимREST Тогда
		Возврат "rest";
	КонецЕсли;
	
	ТипКонтента = "";
	Если ТипЗнч(Заголовки) = Тип("Соответствие")
		Или ТипЗнч(Заголовки) = Тип("ФиксированноеСоответствие") Тогда
		ТипКонтента = НРег(Строка(Заголовки.Получить("Content-Type")));
		Если ПустаяСтрока(ТипКонтента) Тогда
			ТипКонтента = НРег(Строка(Заголовки.Получить("content-type")));
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(ТипКонтента, "json") > 0 Тогда
		Возврат "json";
	КонецЕсли;
	
	Возврат "plaintext";
	
КонецФункции

// Усекает длинный текст тела для отображения в списке (защита от тормозов UI).
//
// Параметры:
//  Текст - Строка
//  МаксДлина - Число - максимальная длина результата
//
// Возвращаемое значение:
//  Строка
//
Функция УсечьТекстДляОтображения(Текст, МаксДлина = 32768) Экспорт
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = Строка(Текст);
	Результат = УсечьДлинныеBase64ВТексте(Результат, 120);
	
	Если СтрДлина(Результат) > МаксДлина Тогда
		Результат = Лев(Результат, МаксДлина)
			+ Символы.ПС
			+ НСтр("ru = '… [текст усечён для отображения; полный текст — в окне «Просмотр»]'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Опции Monaco из структуры настроек OneSniffer.
//
// Параметры:
//  Настройки - Структура
//
// Возвращаемое значение:
//  Структура - поля для setOptions / init:
//   * theme - Строка
//   * fontSize - Число
//   * wordWrap - Строка
//   * minimap - Структура
//   * lineNumbers - Строка
//   * folding - Булево
//   * formatOnPaste - Булево
//   * tabSize - Число
//
Функция ОпцииMonacoИзНастроек(Настройки) Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = НастройкиРедактораПоУмолчанию();
	КонецЕсли;
	
	Опции = Новый Структура;
	Опции.Вставить("theme", Настройки.Тема);
	Опции.Вставить("fontSize", Настройки.РазмерШрифта);
	Если Настройки.ПереносСтрок Тогда
		Опции.Вставить("wordWrap", "on");
	Иначе
		Опции.Вставить("wordWrap", "off");
	КонецЕсли;
	Опции.Вставить("minimap", Новый Структура("enabled", Настройки.Миникарта));
	Если Настройки.НомераСтрок Тогда
		Опции.Вставить("lineNumbers", "on");
	Иначе
		Опции.Вставить("lineNumbers", "off");
	КонецЕсли;
	Опции.Вставить("folding", Настройки.Сворачивание);
	Опции.Вставить("formatOnPaste", Настройки.ФорматироватьПриВставке);
	Опции.Вставить("tabSize", Настройки.РазмерТабуляции);
	Возврат Опции;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УсечьДлинныеBase64ВТексте(Текст, ДлинаПревью)
	
	Результат = Текст;
	Позиция = 1;
	Длина = СтрДлина(Результат);
	МинимальнаяДлинаBase64 = 200;
	
	Пока Позиция <= Длина Цикл
		
		Символ = Сред(Результат, Позиция, 1);
		Если Не ЭтоСимволBase64(Символ) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		
		Начало = Позиция;
		Пока Позиция <= Длина И ЭтоСимволBase64(Сред(Результат, Позиция, 1)) Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		
		ДлинаКуска = Позиция - Начало;
		Если ДлинаКуска >= МинимальнаяДлинаBase64 Тогда
			Префикс = Лев(Результат, Начало - 1);
			Кусок = Сред(Результат, Начало, ДлинаКуска);
			Суффикс = Сред(Результат, Позиция);
			Замена = Лев(Кусок, ДлинаПревью) + "…[base64," + Формат(ДлинаКуска, "ЧГ=") + "]";
			Результат = Префикс + Замена + Суффикс;
			Позиция = Начало + СтрДлина(Замена);
			Длина = СтрДлина(Результат);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭтоСимволBase64(Символ)
	
	Код = КодСимвола(Символ);
	Возврат (Код >= 65 И Код <= 90) // A-Z
		Или (Код >= 97 И Код <= 122) // a-z
		Или (Код >= 48 И Код <= 57) // 0-9
		Или Символ = "+" Или Символ = "/" Или Символ = "=";
	
КонецФункции

#КонецОбласти
