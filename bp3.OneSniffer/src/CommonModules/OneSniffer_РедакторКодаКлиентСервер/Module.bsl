// Модуль общих настроек и утилит Monaco Editor для OneSniffer.

#Область ПрограммныйИнтерфейс

// Настройки редактора по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * Тема - Строка
//   * РазмерШрифта - Число
//   * ПереносСтрок - Булево
//   * Миникарта - Булево
//   * НомераСтрок - Булево
//   * Сворачивание - Булево
//   * ФорматироватьПриВставке - Булево
//   * РазмерТабуляции - Число
//
Функция НастройкиРедактораПоУмолчанию() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Тема", "vs");
	Настройки.Вставить("РазмерШрифта", 15);
	Настройки.Вставить("ПереносСтрок", Истина);
	Настройки.Вставить("Миникарта", Ложь);
	Настройки.Вставить("НомераСтрок", Истина);
	Настройки.Вставить("Сворачивание", Истина);
	Настройки.Вставить("ФорматироватьПриВставке", Истина);
	Настройки.Вставить("РазмерТабуляции", 4);
	Возврат Настройки;
	
КонецФункции

// Маркер версии single-макета в TEMP (инвалидация кеша при смене макета).
// Увеличивайте при обновлении OneSniffer_MonacoEditorSingle / sync-monaco-maket.ps1.
//
// Возвращаемое значение:
//  Строка
//
Функция ВерсияМакетаРедактора() Экспорт
	
	Возврат "20260803a";
	
КонецФункции

// Определяет язык Monaco по заголовкам HTTP (json | rest | plaintext).
// Метаданные конфигурации 1С в редактор не передаются.
//
// Параметры:
//  Заголовки - Соответствие из КлючИЗначение, Неопределено - заголовки HTTP
//  РежимREST - Булево - принудительно rest (произвольный запрос / протокол)
//
// Возвращаемое значение:
//  Строка - json | rest | plaintext
//
Функция ЯзыкРедактораПоЗаголовкам(Заголовки, РежимREST = Ложь) Экспорт
	
	Если РежимREST Тогда
		Возврат "rest";
	КонецЕсли;
	
	ТипКонтента = "";
	Если ТипЗнч(Заголовки) = Тип("Соответствие")
		Или ТипЗнч(Заголовки) = Тип("ФиксированноеСоответствие") Тогда
		ТипКонтента = НРег(Строка(Заголовки.Получить("Content-Type")));
		Если ПустаяСтрока(ТипКонтента) Тогда
			ТипКонтента = НРег(Строка(Заголовки.Получить("content-type")));
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(ТипКонтента, "json") > 0 Тогда
		Возврат "json";
	КонецЕсли;
	
	Возврат "plaintext";
	
КонецФункции

// Опции Monaco из структуры настроек OneSniffer.
//
// Параметры:
//  Настройки - Структура
//
// Возвращаемое значение:
//  Структура - поля для setOptions / init:
//   * theme - Строка
//   * fontSize - Число
//   * wordWrap - Строка
//   * minimap - Структура
//   * lineNumbers - Строка
//   * folding - Булево
//   * formatOnPaste - Булево
//   * tabSize - Число
//
Функция ОпцииMonacoИзНастроек(Настройки) Экспорт
	
	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = НастройкиРедактораПоУмолчанию();
	КонецЕсли;
	
	Опции = Новый Структура;
	Опции.Вставить("theme", Настройки.Тема);
	Опции.Вставить("fontSize", Настройки.РазмерШрифта);
	Если Настройки.ПереносСтрок Тогда
		Опции.Вставить("wordWrap", "on");
	Иначе
		Опции.Вставить("wordWrap", "off");
	КонецЕсли;
	Опции.Вставить("minimap", Новый Структура("enabled", Настройки.Миникарта));
	Если Настройки.НомераСтрок Тогда
		Опции.Вставить("lineNumbers", "on");
	Иначе
		Опции.Вставить("lineNumbers", "off");
	КонецЕсли;
	Опции.Вставить("folding", Настройки.Сворачивание);
	Опции.Вставить("formatOnPaste", Настройки.ФорматироватьПриВставке);
	Опции.Вставить("tabSize", Настройки.РазмерТабуляции);
	Возврат Опции;
	
КонецФункции

// Сериализует значение в строку JSON. Канон проекта: единственная точка сериализации
// для моста V8Proxy и логирования.
// Веб-клиент: ручная сборка строки (тип ЗаписьJSON в веб-клиенте недоступен).
// Сервер с БСП: ОбщегоНазначения.ЗначениеВJSON. Остальные контексты: ЗаписьJSON.
//
// Параметры:
//  Значение - Структура
//           - ФиксированнаяСтруктура
//           - Соответствие из КлючИЗначение
//           - ФиксированноеСоответствие из КлючИЗначение
//           - Массив из Произвольный
//           - ФиксированныйМассив из Произвольный
//           - Строка
//           - Число
//           - Булево
//           - Дата
//           - Неопределено - сериализуемое значение
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВСтрокуJSON(Знач Значение) Экспорт
	
	Результат = "";
	
#Если ВебКлиент Тогда
	Результат = ЗначениеВСтрокуJSONБезЗаписиJSON(Значение);
#ИначеЕсли Сервер Тогда
	Результат = ЗначениеВСтрокуJSONНаСервере(Значение);
#Иначе
	Результат = ЗначениеВСтрокуJSONЧерезЗаписьJSON(Значение);
#КонецЕсли
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Если Сервер Тогда

// Сериализует значение на сервере: через БСП, если библиотека подключена.
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВСтрокуJSONНаСервере(Знач Значение)
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.БазоваяФункциональность") Тогда
		Возврат ОбщегоНазначения.ЗначениеВJSON(Значение);
	КонецЕсли;
	
	Возврат ЗначениеВСтрокуJSONЧерезЗаписьJSON(Значение);
	
КонецФункции

#КонецЕсли

#Если Не ВебКлиент Тогда

// Сериализует значение штатным ЗаписьJSON (тип недоступен в веб-клиенте).
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВСтрокуJSONЧерезЗаписьJSON(Знач Значение)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецЕсли

// Сериализует значение в JSON без ЗаписьJSON: тип недоступен в веб-клиенте,
// а вызов сервера ради сериализации пакета моста запрещен.
//
// Параметры:
//  Значение - Произвольный - сериализуемое значение
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВСтрокуJSONБезЗаписиJSON(Знач Значение)
	
	Фрагменты = Новый Массив; // Массив из Строка
	ЗаписатьJSONЗначениеВСтроку(Фрагменты, Значение);
	
	Возврат СтрСоединить(Фрагменты, "");
	
КонецФункции

// Добавляет JSON-представление значения в накопитель фрагментов.
//
// Параметры:
//  Фрагменты - Массив из Строка - накопитель результата
//  Значение - Произвольный - сериализуемое значение
//
Процедура ЗаписатьJSONЗначениеВСтроку(Фрагменты, Знач Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если Значение = Неопределено Или Значение = Null Тогда
		
		Фрагменты.Добавить("null");
		
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		
		Если Значение Тогда
			Фрагменты.Добавить("true");
		Иначе
			Фрагменты.Добавить("false");
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		
		Фрагменты.Добавить(Формат(Значение, "ЧГ=0; ЧРД=.; ЧН=0"));
		
	ИначеЕсли ТипЗначения = Тип("Структура")
		Или ТипЗначения = Тип("ФиксированнаяСтруктура")
		Или ТипЗначения = Тип("Соответствие")
		Или ТипЗначения = Тип("ФиксированноеСоответствие") Тогда
		
		Фрагменты.Добавить("{");
		ЭтоПервыйЭлемент = Истина;
		Для Каждого КлючИЗначение Из Значение Цикл
			Если Не ЭтоПервыйЭлемент Тогда
				Фрагменты.Добавить(",");
			КонецЕсли;
			ЭтоПервыйЭлемент = Ложь;
			Фрагменты.Добавить(СтрокаВJSON(Строка(КлючИЗначение.Ключ)));
			Фрагменты.Добавить(":");
			ЗаписатьJSONЗначениеВСтроку(Фрагменты, КлючИЗначение.Значение);
		КонецЦикла;
		Фрагменты.Добавить("}");
		
	ИначеЕсли ТипЗначения = Тип("Массив")
		Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		
		Фрагменты.Добавить("[");
		ЭтоПервыйЭлемент = Истина;
		Для Каждого ЭлементМассива Из Значение Цикл
			Если Не ЭтоПервыйЭлемент Тогда
				Фрагменты.Добавить(",");
			КонецЕсли;
			ЭтоПервыйЭлемент = Ложь;
			ЗаписатьJSONЗначениеВСтроку(Фрагменты, ЭлементМассива);
		КонецЦикла;
		Фрагменты.Добавить("]");
		
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		
		Фрагменты.Добавить(СтрокаВJSON(
			Формат(Значение, "ДФ=yyyy-MM-dd") + "T" + Формат(Значение, "ДФ=HH:mm:ss")));
		
	Иначе
		
		Фрагменты.Добавить(СтрокаВJSON(Строка(Значение)));
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает строковый литерал JSON: кавычки и экранирование служебных символов.
//
// Параметры:
//  Текст - Строка - исходное значение
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокаВJSON(Знач Текст)
	
	Результат = СтрЗаменить(Текст, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Результат = СтрЗаменить(Результат, Символ(8), "\b");
	Результат = СтрЗаменить(Результат, Символы.Таб, "\t");
	Результат = СтрЗаменить(Результат, Символы.ПС, "\n");
	Результат = СтрЗаменить(Результат, Символы.ПФ, "\f");
	Результат = СтрЗаменить(Результат, Символы.ВК, "\r");
	
	// Остальные управляющие символы недопустимы в литерале JSON и кодируются как \u00XX.
	Для КодСимвола = 1 По 31 Цикл
		Если КодСимвола = 8 Или КодСимвола = 9 Или КодСимвола = 10
			Или КодСимвола = 12 Или КодСимвола = 13 Тогда
			Продолжить;
		КонецЕсли;
		УправляющийСимвол = Символ(КодСимвола);
		Если СтрНайти(Результат, УправляющийСимвол) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Результат = СтрЗаменить(Результат, УправляющийСимвол, "\u" + ШестнадцатеричныйКодСимвола(КодСимвола));
	КонецЦикла;
	
	Возврат """" + Результат + """";
	
КонецФункции

// Возвращает четырехзначный шестнадцатеричный код символа для последовательности \uXXXX.
//
// Параметры:
//  КодСимвола - Число - код символа Unicode
//
// Возвращаемое значение:
//  Строка
//
Функция ШестнадцатеричныйКодСимвола(Знач КодСимвола)
	
	Цифры = "0123456789ABCDEF";
	Результат = "";
	ОстатокКода = КодСимвола;
	
	Для Разряд = 1 По 4 Цикл
		Результат = Сред(Цифры, ОстатокКода % 16 + 1, 1) + Результат;
		ОстатокКода = Цел(ОстатокКода / 16);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
