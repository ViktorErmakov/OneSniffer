// Серверные методы Monaco Editor для OneSniffer.

#Область ПрограммныйИнтерфейс

// Помещает ZIP multi-file Monaco во временное хранилище формы.
// Клиент: тонкий/толстый — распаковка + уникальный *.html; веб — URL из АдресСтатикиРедактора.
//
// Параметры:
//  УникальныйИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище
//
Функция АдресМакетаРедактора(УникальныйИдентификаторФормы) Экспорт
	
	ДвоичныеДанные = ПолучитьОбщийМакет("OneSniffer_MonacoEditor");
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
	
КонецФункции

// Помещает single-page HTML Monaco во временное хранилище формы (эксперимент для поля «Ответ»).
//
// Параметры:
//  УникальныйИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище
//
Функция АдресМакетаРедактораSingle(УникальныйИдентификаторФормы) Экспорт
	
	ДвоичныеДанные = ПолучитьОбщийМакет("OneSniffer_MonacoEditorSingle");
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
	
КонецФункции

// Загружает настройки редактора из хранилища (персональные, вместе с настройками логирования).
//
// Возвращаемое значение:
//  Структура - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Функция ЗагрузитьНастройкиРедактора() Экспорт
	
	Возврат ЛогированиеТрафика.ЗагрузитьНастройкиРедактора();
	
КонецФункции

// Сохраняет настройки редактора (персональные, вместе с настройками логирования).
//
// Параметры:
//  Настройки - Структура
//
Процедура СохранитьНастройкиРедактора(Настройки) Экспорт
	
	ЛогированиеТрафика.СохранитьНастройкиРедактора(Настройки);
	
КонецПроцедуры

#КонецОбласти
