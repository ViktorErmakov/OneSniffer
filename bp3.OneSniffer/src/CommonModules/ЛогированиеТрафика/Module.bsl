Функция ЗаписатьИсключенияВРСВФоне() Экспорт
	
	ИмяПроцедуры = "ЛогированиеТрафика.ЗаписатьИсключенияВРС";
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне();
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	ДлительнаяОперация = ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, ИмяПроцедуры);
	
	Возврат ДлительнаяОперация;
	
КонецФункции

// Импортирует записи HTTP из журнала регистрации в регистр ЛогиТрафика.
//
// Возвращаемое значение:
//  Число - количество успешно импортированных записей
//
Функция ЗаписатьИсключенияВРС() Экспорт
	
	Настройки = ЗагрузитьНастройкиЛогирования();
	ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
	Если ЗначениеЗаполнено(Настройки.ДатаЧтенияЖР) Тогда
		ДатаНачала = Настройки.ДатаЧтенияЖР;
	КонецЕсли;
	
	ТаблицаЗаписей = Новый ТаблицаЗначений();
	Отбор = Новый Структура;
	Отбор.Вставить("Событие", СобытиеВызватьHTTPМетод());
	Отбор.Вставить("ДатаНачала", ДатаНачала);
	ВыгрузитьЖурналРегистрации(ТаблицаЗаписей, Отбор);
	
	КоличествоИмпортированных = 0;
	МаксимальнаяДатаЖурнала = ДатаНачала;
	
	Для Каждого СтрокаЗаписиЖР Из ТаблицаЗаписей Цикл
		
		Если СтрокаЗаписиЖР.Дата > МаксимальнаяДатаЖурнала Тогда
			МаксимальнаяДатаЖурнала = СтрокаЗаписиЖР.Дата;
		КонецЕсли;
		
		ЛогЗапроса = ЛогЗапросаИзДанныхЖурнала(СтрокаЗаписиЖР.Данные);
		Если ЛогЗапроса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса);
			КоличествоИмпортированных = КоличествоИмпортированных + 1;
		Исключение
			ЗаписьЖурналаРегистрации(
				СтрШаблон("%1ЗаписатьИсключенияВРС", НаименованиеБиблиотеки()),
				УровеньЖурналаРегистрации.Ошибка,,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
	Если ТаблицаЗаписей.Количество() > 0 Тогда
		Настройки.ДатаЧтенияЖР = МаксимальнаяДатаЖурнала;
		СохранитьНастройкиЛогирования(Настройки);
	КонецЕсли;
	
	Возврат КоличествоИмпортированных;
	
КонецФункции

// Собирает структуру лога из поля «Данные» записи журнала регистрации.
//
// Параметры:
//  ДанныеЖурнала - Произвольный
//
// Возвращаемое значение:
//  Структура, Неопределено - см. РегистрыСведений.ЛогиТрафика.НовыйЛог
//
Функция ЛогЗапросаИзДанныхЖурнала(ДанныеЖурнала) Экспорт
	
	СтрокаДанных = "";
	Если ТипЗнч(ДанныеЖурнала) = Тип("Строка") Тогда
		СтрокаДанных = ДанныеЖурнала;
	ИначеЕсли ДанныеЖурнала <> Неопределено Тогда
		СтрокаДанных = Строка(ДанныеЖурнала);
	КонецЕсли;
	
	Если ПустаяСтрока(СтрокаДанных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СохраненныйЛогЗапроса = ЗначениеИзСтрокиJSON(СтрокаДанных, Ложь, "Дата");
	Если ТипЗнч(СохраненныйЛогЗапроса) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЛогЗапроса = РегистрыСведений.ЛогиТрафика.НовыйСтруктураМенеджераЗаписи();
	ЗаполнитьЗначенияСвойств(ЛогЗапроса, СохраненныйЛогЗапроса);
	Если Не СохраненныйЛогЗапроса.Свойство("Размер")
		И СохраненныйЛогЗапроса.Свойство("РазмерОтвета") Тогда
		ЛогЗапроса.Размер = СохраненныйЛогЗапроса.РазмерОтвета;
	КонецЕсли;
	
	СодержаниеЛога = РегистрыСведений.ЛогиТрафика.НовыйСодержание(
		Перечисления.НаправлениеHTTPЛога.Исходящий,
		Перечисления.НазначениеЛога.Рабочий);
	СохраненноеСодержание = Неопределено;
	Если СохраненныйЛогЗапроса.Свойство("Содержание", СохраненноеСодержание) Тогда
		ЗаполнитьЗначенияСвойств(СодержаниеЛога, СохраненноеСодержание);
	КонецЕсли;
	ВходящийЗапрос = Ложь;
	Если СохраненныйЛогЗапроса.Свойство("Входящий") Тогда
		ВходящийЗапрос = СохраненныйЛогЗапроса.Входящий;
	КонецЕсли;
	ЛогЗапроса.Содержание = РегистрыСведений.ЛогиТрафика.ПодготовитьСодержание(
		СодержаниеЛога,
		Перечисления.НазначениеЛога.Рабочий,
		ВходящийЗапрос);
	
	МетодСтрокой = Неопределено;
	Если Не СохраненныйЛогЗапроса.Свойство("Метод", МетодСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетодHTTP = МетодHTTPИзСтрокиЖурнала(МетодСтрокой);
	Если МетодHTTP = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЛогЗапроса.Метод = МетодHTTP;
	
	Возврат ЛогЗапроса;
	
КонецФункции

// Преобразует строковое представление метода HTTP к значению перечисления.
//
// Параметры:
//  МетодСтрокой - Строка, ПеречислениеСсылка.МетодHTTP
//
// Возвращаемое значение:
//  ПеречислениеСсылка.МетодHTTP, Неопределено
//
Функция МетодHTTPИзСтрокиЖурнала(МетодСтрокой)
	
	Если ТипЗнч(МетодСтрокой) = Тип("ПеречислениеСсылка.МетодHTTP") Тогда
		Возврат МетодСтрокой;
	КонецЕсли;
	
	ИмяМетода = ВРег(СокрЛП(Строка(МетодСтрокой)));
	Если ПустаяСтрока(ИмяМетода) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Перечисления.МетодHTTP[ИмяМетода];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя события.
// 
// Параметры:
//  ИмяСобытия - Строка
//  АдресРесурса - Строка
//
Процедура ИмяСобытия(ИмяСобытия, АдресРесурса) Экспорт
	
	ЛогированиеТрафикаПереопределяемый.ИмяСобытия(ИмяСобытия, АдресРесурса);
	
	Если ПустаяСтрока(ИмяСобытия) Тогда
		
		Если СтрНачинаетсяС(АдресРесурса, "rest/public/ticket/get") Тогда
			ИмяСобытия = "ИнтернетПоддержка.Получение тикета";
		ИначеЕсли АдресРесурса = "update-platform/programs/update/info" Тогда
			ИмяСобытия = "ИнтернетПоддержка.Обновление платформы";
		ИначеЕсли АдресРесурса = "update-platform/patches/getInfo" Тогда
			ИмяСобытия = "ИнтернетПоддержка.Проверка патчей платформы";
		ИначеЕсли АдресРесурса = "update-platform/programs/update/ping" Тогда
			ИмяСобытия = "ИнтернетПоддержка.Доступность обновления";
		Иначе
			ИмяСобытия = НСтр("ru = 'Произвольный запрос'");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Ключ хранилища настроек логирования (пользовательское хранилище — редактор).
//
// Возвращаемое значение:
//  Строка
//
Функция КлючХранилищаНастроекЛогирования() Экспорт
	Возврат "OneSniff";
КонецФункции

// Ключ записи общих настроек в РС OneSniffer_Настройки.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючЗаписиНастроекЛогированияВРС()
	Возврат "Основная";
КонецФункции

Функция НастройкиЛогированияБезРедактора(Настройки)
	
	Результат = Новый Структура;
	Шаблон = НовыйНастройкиЛогирования();
	Для Каждого КлючИЗначение Из Шаблон Цикл
		Если КлючИЗначение.Ключ = "Редактор" Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеСвойства = КлючИЗначение.Значение;
		Если ТипЗнч(Настройки) = Тип("Структура") Тогда
			Настройки.Свойство(КлючИЗначение.Ключ, ЗначениеСвойства);
		КонецЕсли;
		Результат.Вставить(КлючИЗначение.Ключ, ЗначениеСвойства);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьНастройкиЛогированияИзРС()
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.OneSniffer_Настройки.СоздатьМенеджерЗаписи();
	Запись.Ключ = КлючЗаписиНастроекЛогированияВРС();
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеХранилища = Запись.Значение;
	Если ТипЗнч(ЗначениеХранилища) <> Тип("ХранилищеЗначения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ЗначениеХранилища.Получить();
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Процедура ЗаписатьНастройкиЛогированияВРС(НастройкиБезРедактора)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запись = РегистрыСведений.OneSniffer_Настройки.СоздатьМенеджерЗаписи();
	Запись.Ключ = КлючЗаписиНастроекЛогированияВРС();
	Запись.Значение = Новый ХранилищеЗначения(НастройкиБезРедактора, Новый СжатиеДанных(5));
	Запись.Записать(Истина);
	
КонецПроцедуры

// Усекает текст для UI, если включена общая настройка УсекатьДлинныйBase64.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстДляОтображенияПоНастройке(Текст) Экспорт
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	Настройки = ЗагрузитьНастройкиЛогирования();
	Если Не Настройки.УсекатьДлинныйBase64 Тогда
		Возврат Строка(Текст);
	КонецЕсли;
	
	Возврат OneSniffer_РедакторКодаКлиентСервер.УсечьТекстДляОтображения(Текст);
	
КонецФункции

// Собирает настройки редактора из структуры настроек или устаревшего ключа "Editor".
//
// Параметры:
//  ЗагруженныеНастройки - Структура, Неопределено
//
// Возвращаемое значение:
//  Структура - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Функция НастройкиРедактораИзХранилища(ЗагруженныеНастройки)
	
	Редактор = OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию();
	
	Если ТипЗнч(ЗагруженныеНастройки) = Тип("Структура")
		И ЗагруженныеНастройки.Свойство("Редактор")
		И ТипЗнч(ЗагруженныеНастройки.Редактор) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Редактор, ЗагруженныеНастройки.Редактор);
		Возврат Редактор;
	КонецЕсли;
	
	// Миграция с отдельного ключа Editor (ранние сборки Monaco).
	КлючОбъекта = КлючХранилищаНастроекЛогирования();
	СтарыеНастройки = ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, "Editor", Неопределено);
	Если ТипЗнч(СтарыеНастройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Редактор, СтарыеНастройки);
	КонецЕсли;
	
	Возврат Редактор;
	
КонецФункции

// Получение информации запроса.
//
// Параметры:
//  КлючЗаписи - Структура - отоборы для логов.
// 
// Возвращаемое значение:
//  Структура - информация запроса:
//   * ТелоЗапроса - Строка - тело запроса.
//
Функция ПолучитьДетализациюПротоколаЗапроса(КлючЗаписи) Экспорт
	
	ПротоколЗапроса = ПолучитьПротоколЗапросаЛога(КлючЗаписи);
	Если ПротоколЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПротоколЗапроса.Вставить("ПредставлениеТелоЗапроса");
	ПротоколЗапроса.Вставить("ПредставлениеТелоОтвета");
	ПротоколЗапроса.Вставить("ЯзыкТелаЗапроса", "plaintext");
	ПротоколЗапроса.Вставить("ЯзыкТелаОтвета", "plaintext");
	ПротоколЗапроса.Вставить("ПревьюКартинок", Новый Массив);
	
	ТипКонтентаЗапроса = "";
	Если КонтентСодержитТекст(ПротоколЗапроса.ЗаголовкиЗапроса, ТипКонтентаЗапроса) Тогда
		ПротоколЗапроса.ПредставлениеТелоЗапроса = ПолучитьПредставлениеТела(ПротоколЗапроса.ТелоЗапроса);
	Иначе
		ПротоколЗапроса.ПредставлениеТелоЗапроса = ПолучитьПредставлениеТела(ПротоколЗапроса.ТелоЗапроса, Истина);
	КонецЕсли;
	ПротоколЗапроса.ЯзыкТелаЗапроса = OneSniffer_РедакторКодаКлиентСервер.ЯзыкРедактораПоЗаголовкам(
		ПротоколЗапроса.ЗаголовкиЗапроса);
	Если ПротоколЗапроса.ЯзыкТелаЗапроса = "json" Тогда
		ПротоколЗапроса.ПредставлениеТелоЗапроса = ОтформатироватьJSONДляОтображения(
			ПротоколЗапроса.ПредставлениеТелоЗапроса);
	КонецЕсли;
	ПротоколЗапроса.ПредставлениеТелоЗапроса = ТекстДляОтображенияПоНастройке(
		ПротоколЗапроса.ПредставлениеТелоЗапроса);
	
	ТипКонтентаОтвета = "";
	Если КонтентСодержитТекст(ПротоколЗапроса.ЗаголовкиОтвета, ТипКонтентаОтвета) Тогда
		ПротоколЗапроса.ПредставлениеТелоОтвета = ПолучитьПредставлениеТела(ПротоколЗапроса.ТелоОтвета);
	Иначе
		ПротоколЗапроса.ПредставлениеТелоОтвета = ПолучитьПредставлениеТела(ПротоколЗапроса.ТелоОтвета, Истина);
	КонецЕсли;
	ПротоколЗапроса.ЯзыкТелаОтвета = OneSniffer_РедакторКодаКлиентСервер.ЯзыкРедактораПоЗаголовкам(
		ПротоколЗапроса.ЗаголовкиОтвета);
	Если ПротоколЗапроса.ЯзыкТелаОтвета = "json" Тогда
		ПротоколЗапроса.ПредставлениеТелоОтвета = ОтформатироватьJSONДляОтображения(
			ПротоколЗапроса.ПредставлениеТелоОтвета);
	КонецЕсли;
	ПротоколЗапроса.ПредставлениеТелоОтвета = ТекстДляОтображенияПоНастройке(
		ПротоколЗапроса.ПредставлениеТелоОтвета);
	
	ПротоколЗапроса.ПревьюКартинок = ИзвлечьПревьюКартинок(
		ПротоколЗапроса.ТелоОтвета, ПротоколЗапроса.ЗаголовкиОтвета);
	
	Возврат ПротоколЗапроса;
	
КонецФункции

// Получить протокол запроса лога.
//
// Параметры:
//  КлючЗаписи	 - Структура - ключи записи регистра сведений ЛогиТрафика.
// 
// Возвращаемое значение:
//  Структура - см. НовыйПротоколЗапросаHTTP.
//
Функция ПолучитьПротоколЗапросаЛога(Знач КлючЗаписи) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛогиТрафика.Событие КАК Событие,
	|	ЛогиТрафика.Дата КАК Дата,
	|	ЛогиТрафика.Метод КАК Метод,
	|	ЛогиТрафика.Сервер КАК Сервер,
	|	ЛогиТрафика.Порт КАК Порт,
	|	ЛогиТрафика.Адрес КАК Адрес,
	|	ЛогиТрафика.ЭтоЗащищенноеСоединение КАК ЭтоЗащищенноеСоединение,
	|	ЛогиТрафика.КодОтвета КАК КодОтвета,
	|	ЛогиТрафика.Длительность КАК Длительность,
	|	ЛогиТрафика.Клиент КАК Клиент,
	|	ЛогиТрафика.Содержание КАК Содержание,
	|	ЛогиТрафика.ВремяНачала КАК ВремяНачала,
	|	ЛогиТрафика.Входящий КАК Входящий
	|ИЗ
	|	РегистрСведений.ЛогиТрафика КАК ЛогиТрафика
	|ГДЕ
	|	ЛогиТрафика.ВремяНачала = &ВремяНачала
	|	И ЛогиТрафика.Сервер = &Сервер";
	Запрос.УстановитьПараметр("Сервер",      КлючЗаписи.Сервер);
	Запрос.УстановитьПараметр("ВремяНачала", КлючЗаписи.ВремяНачала);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПротоколЗапроса = НовыйПротоколЗапросаHTTP();
	
	ЗаполнитьЗначенияСвойств(ПротоколЗапроса, Выборка);
	
	Содержание = Выборка.Содержание.Получить();
	Если ТипЗнч(Содержание) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ПротоколЗапроса, Содержание);
	КонецЕсли;
	
	Возврат ПротоколЗапроса;
	
КонецФункции

// Конструктор структуры протокола HTTP-запроса для редактора и импорта markdown.
//
// Возвращаемое значение:
//  Структура:
// * Событие - Строка
// * Дата - Дата
// * ВремяНачала - Число
// * Клиент - Строка
// * Метод - Строка
// * Сервер - Строка
// * Порт - Число
// * Адрес - Строка
// * ЭтоЗащищенноеСоединение - Булево
// * ЗаголовкиЗапроса - Соответствие из КлючИЗначение
// * ТелоЗапроса - Неопределено, ДвоичныеДанные
// * ТелоЗапросаСтрокой - Строка
// * Логин - Строка
// * Пароль - Строка
// * Прокси - ИнтернетПрокси, Неопределено
// * КодОтвета - Число
// * Размер - Число
// * Длительность - Число
// * ЗаголовкиОтвета - Соответствие из КлючИЗначение
// * ТелоОтвета - Неопределено, ДвоичныеДанные
// * ТелоОтветаСтрокой - Строка
// * Таймаут - Число, Неопределено
// * ПолныйТекст - Строка
// * Входящий - Булево
//
Функция НовыйПротоколЗапросаHTTP()
		
	ПротоколЗапроса = Новый Структура;
	ПротоколЗапроса.Вставить("Событие",   "");
	ПротоколЗапроса.Вставить("Дата",      Дата(1,1,1));
	ПротоколЗапроса.Вставить("ВремяНачала", 0);
	ПротоколЗапроса.Вставить("Клиент",    "");
	ПротоколЗапроса.Вставить("Метод",     "");
	ПротоколЗапроса.Вставить("Сервер",    "");
	ПротоколЗапроса.Вставить("Порт",      0);
	ПротоколЗапроса.Вставить("Адрес",     "");
	ПротоколЗапроса.Вставить("ЭтоЗащищенноеСоединение", Ложь);
	ПротоколЗапроса.Вставить("ЗаголовкиЗапроса", Новый Соответствие);
	ПротоколЗапроса.Вставить("ТелоЗапроса",      Неопределено);
	ПротоколЗапроса.Вставить("ТелоЗапросаСтрокой", "");
	ПротоколЗапроса.Вставить("Логин",     "");
	ПротоколЗапроса.Вставить("Пароль",    "");
	ПротоколЗапроса.Вставить("Прокси",    Неопределено);
	ПротоколЗапроса.Вставить("КодОтвета",    0);
	ПротоколЗапроса.Вставить("Размер", 0);
	ПротоколЗапроса.Вставить("Длительность", 0);
	ПротоколЗапроса.Вставить("ЗаголовкиОтвета", Новый Соответствие);
	ПротоколЗапроса.Вставить("ТелоОтвета",      Неопределено);
	ПротоколЗапроса.Вставить("ТелоОтветаСтрокой",      "");
	ПротоколЗапроса.Вставить("Таймаут",         Неопределено);
	ПротоколЗапроса.Вставить("ПолныйТекст",     "");
	ПротоколЗапроса.Вставить("Входящий",        Ложь);
	
	Возврат ПротоколЗапроса;
	
КонецФункции

Функция КонтентСодержитТекст(Знач Заголовки, ТипКонтента = "")
	
//	ТипКонтента = "";
	Если ТипЗнч(Заголовки) = Тип("Соответствие") Или ТипЗнч(Заголовки) = Тип("ФиксированноеСоответствие") Тогда
		ТипКонтента = НРег(Заголовки.Получить("Content-Type"));
		Если ПустаяСтрока(ТипКонтента) Тогда // Обход, когда заголовок в нижнем регистре.
			ТипКонтента = НРег(Заголовки.Получить("content-type"));
		КонецЕсли;
	КонецЕсли;
	
	Если ТипКонтента = ""
		Или СтрНайти(ТипКонтента, "text")
		Или СтрНайти(ТипКонтента, "json")
		Или СтрНайти(ТипКонтента, "xml")
		Или СтрНайти(ТипКонтента, "x-www-form-urlencoded") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьПредставлениеТела(Значение, ПолучитьBase64 = Ложь)
	
	Результат = Значение;
	Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
		// Новый формат получения
		Если Не ПолучитьBase64 Тогда
			Результат = ПолучитьСтрокуИзДвоичныхДанных(Значение, КодировкаТекста.UTF8);
		Иначе
			Результат = Base64Строка(Значение);
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Красиво форматирует JSON-строку; при ошибке разбора возвращает исходный текст.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ОтформатироватьJSONДляОтображения(Текст) Экспорт
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаJSON = СокрЛП(Строка(Текст));
	Если СтрДлина(СтрокаJSON) < 2 Тогда
		Возврат Строка(Текст);
	КонецЕсли;
	
	ПервыйСимвол = Лев(СтрокаJSON, 1);
	Если ПервыйСимвол <> "{" И ПервыйСимвол <> "[" Тогда
		Возврат Строка(Текст);
	КонецЕсли;
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		
		ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, " ");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку(ПараметрыЗаписи);
		ЗаписатьJSON(ЗаписьJSON, Данные);
		Возврат ЗаписьJSON.Закрыть();
	Исключение
		Возврат Строка(Текст);
	КонецПопытки;
	
КонецФункции

Функция ПолучитьДеревоЗначенийИзJSON(Значение, ПрочитатьВСоответствие = Ложь)
	
	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый ДеревоЗначений;
	Результат.Колонки.Добавить("Значение");
	
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		Если ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
			// Новый формат получения
			Тело = ПолучитьСтрокуИзДвоичныхДанных(Значение, КодировкаТекста.UTF8);
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
			Тело = Значение;
		Иначе
			НоваяСтрока = Результат.Строки.Добавить();
			НоваяСтрока.Значение = Значение;
			Возврат Результат;
		КонецЕсли;
		
		Если ПустаяСтрока(Тело) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ЧтениеJSON.УстановитьСтроку(Тело);
		ДанныеТела = ПрочитатьJSON(ЧтениеJSON, ПрочитатьВСоответствие);
		ЧтениеJSON.Закрыть();
		Если ЗначениеЗаполнено(ДанныеТела) Тогда
			ЗаполнитьДеревоВРекурсии(Результат, ДанныеТела);
		КонецЕсли;
	Исключение
		Если СтрДлина(Тело) > 500 Тогда
			Тело = Лев(Тело, 500) + "...";
		КонецЕсли;
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Чтение JSON", УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыСведений.ЛогиТрафика,, ТекстОшибки + Символы.ПС + Тело);
		НоваяСтрока = Результат.Строки.Добавить();
		НоваяСтрока.Значение = "<Ошибка чтения JSON>";
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьДеревоВРекурсии(СтрокаДерева, Значение)
	
	Если ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("Массив")
		Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		ОднаСтрока = Значение.Количество() = 1;
		Если ТипЗнч(СтрокаДерева) <> Тип("ДеревоЗначений") Тогда
			Если ТипЗнч(Значение) = Тип("Массив") Тогда
				СтрокаДерева.Значение = "[]";
			ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
				СтрокаДерева.Значение = "{}";
			КонецЕсли;
		КонецЕсли;
		ПерваяСтрока = Истина;
		Для каждого ЭлементКоллекции Из Значение Цикл
			// Если одна строка или в составе коллекция то не группируем.
			Если (ОднаСтрока 
				Или ТипЗнч(ЭлементКоллекции) = Тип("Структура") 
				Или ТипЗнч(ЭлементКоллекции) = Тип("Соответствие")
				Или ТипЗнч(ЭлементКоллекции) = Тип("Массив")) Тогда
					Если ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Тогда
						НоваяСтрока = СтрокаДерева.Строки.Добавить();
					ИначеЕсли Значение.Количество() = 1 Тогда
						НоваяСтрока = СтрокаДерева;
					ИначеЕсли СтрокаДерева.Родитель = Неопределено Тогда
						НоваяСтрока = СтрокаДерева.Строки.Добавить();
					ИначеЕсли ПерваяСтрока Тогда
						НоваяСтрока = СтрокаДерева;
					Иначе
						НоваяСтрока = СтрокаДерева.Родитель.Строки.Добавить();
					КонецЕсли;
			Иначе
				НоваяСтрока = СтрокаДерева.Строки.Добавить();
			КонецЕсли;
			ЗаполнитьДеревоВРекурсии(НоваяСтрока, ЭлементКоллекции);
			ПерваяСтрока = Ложь;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("КлючИЗначение") Тогда
		Если ТипЗнч(Значение.Значение) = Тип("Структура")
			Или ТипЗнч(Значение.Значение) = Тип("Соответствие")
			Или ТипЗнч(Значение.Значение) = Тип("Массив") Тогда
			СтрокаДерева.Значение = Значение.Ключ;
			НоваяСтрока = СтрокаДерева.Строки.Добавить();
			ЗаполнитьДеревоВРекурсии(НоваяСтрока, Значение.Значение);
		Иначе
			Данные = Значение.Значение;
			Если ТипЗнч(Данные) = Тип("Число") Тогда
				Данные = Формат(Данные, "ЧГ=");
			ИначеЕсли ТипЗнч(Данные) = Тип("Строка") Тогда
				Данные = """" + Данные + """";
			КонецЕсли;
			СтрокаДерева.Значение = Значение.Ключ + ": " + Данные;
		КонецЕсли;
	Иначе
		Если ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Тогда
			НоваяСтрока = СтрокаДерева.Строки.Добавить();
			НоваяСтрока.Значение = Значение;
		Иначе
			СтрокаДерева.Значение = Значение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтрокуURLЗапроса(Метод, Сервер, ЗащищенноеСоединение, Порт, Адрес, ИсключитьПараметры = Ложь) Экспорт
	
	СтрокаПорт = ?(Не ЗначениеЗаполнено(Порт) Или Порт = 80 Или Порт = 443, "", ":" + Формат(Порт, "ЧГ="));
	Результат = "" + ?(Метод = "", "", ВРег(Метод) + " ")
		+ ?(ЗащищенноеСоединение = Неопределено Или ЗащищенноеСоединение = Ложь, "http://", "https://")
		+ Сервер + СтрокаПорт + ?(Лев(Адрес, 1) = "/", "", "/") + Адрес;
		
	Если ИсключитьПараметры Тогда
		РазделительПараметры = СтрНайти(Результат, "?");
		Если РазделительПараметры <> 0 Тогда
			Результат = Лев(Результат, РазделительПараметры - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получить текст лога.
//
// Параметры:
//  КлючЗаписи		 - Структура - ключи записи регистра сведений ЛогиТрафика
//  ВключатьОтвет	 - Булево - признак включения ответа запроса.
//  БезАвторизации - Булево
//  ДляОтображения - Булево - усечь длинный текст для Monaco (экспорт — Ложь).
// 
// Возвращаемое значение:
//  Строка - содержание записи лога.
//
Функция ПолучитьТекстЛога(КлючЗаписи, ВключатьОтвет = Ложь, БезАвторизации = Ложь, ДляОтображения = Истина) Экспорт
	
	ПротоколЗапроса = ПолучитьПротоколЗапросаЛога(КлючЗаписи);
	Если ПротоколЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Текст = Новый ТекстовыйДокумент;
	
	Текст.ДобавитьСтроку("### " + ПротоколЗапроса.Событие + ?(ПротоколЗапроса.Входящий, " [incoming]", ""));
	Текст.ДобавитьСтроку(ПолучитьСтрокуURLЗапроса(ПротоколЗапроса.Метод, ПротоколЗапроса.Сервер,
		ПротоколЗапроса.ЭтоЗащищенноеСоединение, ПротоколЗапроса.Порт, ПротоколЗапроса.Адрес));
	
	ЗаголовкиЗапроса = ПротоколЗапроса.ЗаголовкиЗапроса;
	Если ЗначениеЗаполнено(ЗаголовкиЗапроса) Тогда
		Для каждого ЭлементКоллекции Из ЗаголовкиЗапроса Цикл
			Если БезАвторизации И ИменаЗаголовкаAuthorization().Найти(ЭлементКоллекции.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Текст.ДобавитьСтроку(ЭлементКоллекции.Ключ + ": " + ЭлементКоллекции.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоколЗапроса.ТелоЗапроса) Тогда
		Текст.ДобавитьСтроку("");
		ТелоЗапроса = ПолучитьПредставлениеТела(
			ПротоколЗапроса.ТелоЗапроса,
			Не КонтентСодержитТекст(ПротоколЗапроса.ЗаголовкиЗапроса));
		Если OneSniffer_РедакторКодаКлиентСервер.ЯзыкРедактораПоЗаголовкам(
			ПротоколЗапроса.ЗаголовкиЗапроса) = "json" Тогда
			ТелоЗапроса = ОтформатироватьJSONДляОтображения(ТелоЗапроса);
		КонецЕсли;
		Текст.ДобавитьСтроку(ТелоЗапроса);
	КонецЕсли;
	
	Если ВключатьОтвет Тогда
		Текст.ДобавитьСтроку("");
		ВставкаСодержимогоОтветаВПротокол(Текст, ПротоколЗапроса);
	КонецЕсли;
	
	РезультатТекст = Текст.ПолучитьТекст();
	Если ДляОтображения Тогда
		РезультатТекст = ТекстДляОтображенияПоНастройке(РезультатТекст);
	КонецЕсли;
	Возврат РезультатТекст;
	
КонецФункции

// Текст ответа лога для отдельного редактора: статус, заголовки, тело (без табов протокола).
//
// Параметры:
//  КлючЗаписи - Структура - ключи записи регистра сведений ЛогиТрафика.
//  ДляОтображения - Булево - усечь длинный текст для Monaco (экспорт — Ложь).
//
// Возвращаемое значение:
//  Строка, Неопределено - текст ответа или Неопределено, если запись не найдена.
//
Функция ПолучитьТекстОтветаЛога(КлючЗаписи, ДляОтображения = Истина) Экспорт
	
	ПротоколЗапроса = ПолучитьПротоколЗапросаЛога(КлючЗаписи);
	Если ПротоколЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Текст = Новый ТекстовыйДокумент;
	ВставкаСодержимогоОтветаВПротокол(Текст, ПротоколЗапроса, Ложь);
	РезультатТекст = Текст.ПолучитьТекст();
	Если ДляОтображения Тогда
		РезультатТекст = ТекстДляОтображенияПоНастройке(РезультатТекст);
	КонецЕсли;
	Возврат РезультатТекст;
	
КонецФункции

// Собирает многострочную команду curl по ключу записи лога.
//
// Параметры:
//  КлючЗаписи - Структура - ключи записи регистра сведений ЛогиТрафика
//  БезАвторизации - Булево - исключить заголовок Authorization
//
// Возвращаемое значение:
//  Строка, Неопределено - текст curl или Неопределено, если протокол недоступен
//
Функция ПолучитьКодCurl(КлючЗаписи, БезАвторизации = Ложь) Экспорт
	
	ПротоколЗапроса = ПолучитьПротоколЗапросаЛога(КлючЗаписи);
	Если ПротоколЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаЗапроса = ПолучитьСтрокуURLЗапроса(
		ПротоколЗапроса.Метод,
		ПротоколЗапроса.Сервер,
		ПротоколЗапроса.ЭтоЗащищенноеСоединение,
		ПротоколЗапроса.Порт,
		ПротоколЗапроса.Адрес);
	
	Части = Новый Массив;
	Части.Добавить("curl --request --ssl-no-revoke " + СтрокаЗапроса);
	
	ЗаголовкиЗапроса = ПротоколЗапроса.ЗаголовкиЗапроса;
	Если ЗначениеЗаполнено(ЗаголовкиЗапроса) Тогда
		Для Каждого ЭлементКоллекции Из ЗаголовкиЗапроса Цикл
			Если БезАвторизации И ИменаЗаголовкаAuthorization().Найти(ЭлементКоллекции.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЗначениеЗаголовка = СтрЗаменить(Строка(ЭлементКоллекции.Значение), """", "\""");
			Части.Добавить(СтрШаблон("  --header ""%1: %2""",
				ЭлементКоллекции.Ключ, ЗначениеЗаголовка));
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПротоколЗапроса.ТелоЗапроса) Тогда
		ТелоЗапроса = ПолучитьПредставлениеТела(ПротоколЗапроса.ТелоЗапроса,
			Не КонтентСодержитТекст(ПротоколЗапроса.ЗаголовкиЗапроса));
		Если OneSniffer_РедакторКодаКлиентСервер.ЯзыкРедактораПоЗаголовкам(
			ПротоколЗапроса.ЗаголовкиЗапроса) = "json" Тогда
			ТелоЗапроса = ОтформатироватьJSONДляОтображения(ТелоЗапроса);
		КонецЕсли;
		ТелоЗапроса = СтрЗаменить(ТелоЗапроса, """", "\""");
		Части.Добавить(СтрШаблон("  --data-raw ""%1""", ТелоЗапроса));
	КонецЕсли;
	
	Если Части.Количество() = 1 Тогда
		Возврат Части[0];
	КонецЕсли;
	
	Результат = Части[0];
	Для Индекс = 1 По Части.ВГраница() Цикл
		Результат = Результат + " \" + Символы.ПС + Части[Индекс];
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Вставляет блок ответа в текстовый протокол.
//
// Параметры:
//  Текст - ТекстовыйДокумент
//  ПротоколЛогЗапроса - Структура - см. НовыйПротоколЗапросаHTTP
//  СОтступами - Булево - Истина: префикс таб (для markdown-протокола);
//                        Ложь: плоский текст для отдельного редактора ответа.
//
Процедура ВставкаСодержимогоОтветаВПротокол(Текст, ПротоколЛогЗапроса, СОтступами = Истина)
	
	Если ПротоколЛогЗапроса.Свойство("HTTPОтвет") = Ложь Тогда
		КодОтвета = ПротоколЛогЗапроса.КодОтвета;
		ТелоОтвета = ПротоколЛогЗапроса.ТелоОтвета;
		ЗаголовкиОтвета = ПротоколЛогЗапроса.ЗаголовкиОтвета;
	Иначе
		КодОтвета = ПротоколЛогЗапроса.HTTPОтвет.КодСостояния;
		ТелоОтвета = ПротоколЛогЗапроса.HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		ЗаголовкиОтвета = ПротоколЛогЗапроса.HTTPОтвет.Заголовки;
	КонецЕсли;
	
	Префикс = ?(СОтступами, Символы.Таб, "");
	
	Текст.ДобавитьСтроку(
		СтрШаблон("# HTTP/1.1 %1 %2 - %3.%4%5",
			Формат(КодОтвета, "ЧН="),
			РасшифровкаКодаСостоянияHTTP(КодОтвета),
			Формат(ПротоколЛогЗапроса.Дата, "ДФ='dd.MM.yyyy HH:mm:ss'"),
			Формат(ПротоколЛогЗапроса.ВремяНачала%1000, "ЧЦ=3; ЧВН="),
			?(ЗначениеЗаполнено(ПротоколЛогЗапроса.Длительность) И ПротоколЛогЗапроса.Длительность > 0,
				СтрШаблон(" (%1 sec)", Формат(ПротоколЛогЗапроса.Длительность, "ЧДЦ=3; ЧН=0")),
				"")));
	Если ЗначениеЗаполнено(ЗаголовкиОтвета) Тогда
		Для каждого ЭлементКоллекции Из ЗаголовкиОтвета Цикл
			Текст.ДобавитьСтроку(Префикс + ЭлементКоллекции.Ключ + ": " + ЭлементКоллекции.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТелоОтвета) Тогда
		Текст.ДобавитьСтроку(Префикс);
		ПредставлениеТелаОтвета = ПолучитьПредставлениеТела(ТелоОтвета, Не КонтентСодержитТекст(ЗаголовкиОтвета));
		Если OneSniffer_РедакторКодаКлиентСервер.ЯзыкРедактораПоЗаголовкам(ЗаголовкиОтвета) = "json" Тогда
			ПредставлениеТелаОтвета = ОтформатироватьJSONДляОтображения(ПредставлениеТелаОтвета);
		КонецЕсли;
		Если СОтступами Тогда
			ПредставлениеТелаОтвета = Префикс + СтрЗаменить(ПредставлениеТелаОтвета, Символы.ПС, Символы.ПС + Префикс);
		КонецЕсли;
		
		Представление = Новый ТекстовыйДокумент;
		Представление.УстановитьТекст(ПредставлениеТелаОтвета);
		Для НомерСтроки = 1 По Представление.КоличествоСтрок() Цикл
			СтрокаПредставления = Представление.ПолучитьСтроку(НомерСтроки);
			Текст.ДобавитьСтроку(СтрокаПредставления);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция РасшифровкаКодаСостоянияHTTP(КодСостояния) Экспорт
	
	Если  КодСостояния = 200 Тогда Расшифровка = "ОК"
	ИначеЕсли КодСостояния = 304 Тогда Расшифровка = "Not Modified"
	ИначеЕсли КодСостояния = 400 Тогда Расшифровка = "Bad Request"
	ИначеЕсли КодСостояния = 401 Тогда Расшифровка = "Unauthorized"
	ИначеЕсли КодСостояния = 402 Тогда Расшифровка = "Payment Required"
	ИначеЕсли КодСостояния = 403 Тогда Расшифровка = "Forbidden"
	ИначеЕсли КодСостояния = 404 Тогда Расшифровка = "Not Found"
	ИначеЕсли КодСостояния = 405 Тогда Расшифровка = "Method Not Allowed"
	ИначеЕсли КодСостояния = 406 Тогда Расшифровка = "Not Acceptable"
	ИначеЕсли КодСостояния = 407 Тогда Расшифровка = "Proxy Authentication Required"
	ИначеЕсли КодСостояния = 408 Тогда Расшифровка = "Request Timeout"
	ИначеЕсли КодСостояния = 409 Тогда Расшифровка = "Conflict"
	ИначеЕсли КодСостояния = 410 Тогда Расшифровка = "Gone"
	ИначеЕсли КодСостояния = 411 Тогда Расшифровка = "Length Required"
	ИначеЕсли КодСостояния = 412 Тогда Расшифровка = "Precondition Failed"
	ИначеЕсли КодСостояния = 413 Тогда Расшифровка = "Request Entity Too Large"
	ИначеЕсли КодСостояния = 414 Тогда Расшифровка = "Request-URL Too Long"
	ИначеЕсли КодСостояния = 415 Тогда Расшифровка = "Unsupported Media-Type"
	ИначеЕсли КодСостояния = 416 Тогда Расшифровка = "Requested Range Not Satisfiable"
	ИначеЕсли КодСостояния = 417 Тогда Расшифровка = "Expectation Failed"
	ИначеЕсли КодСостояния = 429 Тогда Расшифровка = "Too Many Requests"
	ИначеЕсли КодСостояния = 500 Тогда Расшифровка = "Internal Server Error"
	ИначеЕсли КодСостояния = 501 Тогда Расшифровка = "Not Implemented"
	ИначеЕсли КодСостояния = 502 Тогда Расшифровка = "Bad Gateway"
	ИначеЕсли КодСостояния = 503 Тогда Расшифровка = "Server Unavailable"
	ИначеЕсли КодСостояния = 504 Тогда Расшифровка = "Gateway Timeout"
	ИначеЕсли КодСостояния = 505 Тогда Расшифровка = "HTTP Version Not Supported"
	ИначеЕсли КодСостояния = 506 Тогда Расшифровка = "Variant Also Negotiates"
	ИначеЕсли КодСостояния = 507 Тогда Расшифровка = "Insufficient Storage"
	ИначеЕсли КодСостояния = 509 Тогда Расшифровка = "Bandwidth Limit Exceeded"
	ИначеЕсли КодСостояния = 510 Тогда Расшифровка = "Not Extended"
	ИначеЕсли КодСостояния = 511 Тогда Расшифровка = "Network Authentication Required"
	Иначе                              Расшифровка = "Unknow code answer";
	КонецЕсли;
	
	Возврат Расшифровка;
	
КонецФункции

// Загрузить логи HTTPИз файла.
// 
// Параметры:
//  Адрес - Строка
//  Отказ - Булево
//  ТекстОшибки - Строка
//
Процедура ЗагрузитьЛогиHTTPИзФайла(Знач Адрес, Отказ = Ложь, ТекстОшибки = "") Экспорт
	
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес); // ДвоичныеДанные
		Текст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные);
		
		//* TODO Написать разработчикам платформы! Проверить повторяется ли это в текущей платформе
		// Обход ошибки платформы выгрузки CR CR LF
		Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Иначе
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Прочитать(Адрес);
		Текст = ТекстовыйДокумент.ПолучитьТекст();
	КонецЕсли;
	
	ПротоколыЗапросов = ПрочитатьПротоколыЗапросовИзСтроки(Текст, Отказ, ТекстОшибки);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Для Каждого ПротоколЗапроса Из ПротоколыЗапросов Цикл
		
		Запись = РегистрыСведений.ЛогиТрафика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ПротоколЗапроса);
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Отказ = Истина;
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Дубль лога, см. %1'"), ПротоколЗапроса.Событие);
			Прервать;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Запись, ПротоколЗапроса);
		Содержание = РегистрыСведений.ЛогиТрафика.НовыйСодержание(
			Перечисления.НаправлениеHTTPЛога.Исходящий,
			Перечисления.НазначениеЛога.Регистр);
		Содержание.ЗаголовкиЗапроса = ПротоколЗапроса.ЗаголовкиЗапроса;
		Содержание.ТелоЗапроса = ПротоколЗапроса.ТелоЗапроса;
		Содержание.ЗаголовкиОтвета = ПротоколЗапроса.ЗаголовкиОтвета;
		Содержание.ТелоОтвета = ПротоколЗапроса.ТелоОтвета;
		Запись.Содержание = Новый ХранилищеЗначения(Содержание, Новый СжатиеДанных(5));
		
		Запись.Записать(Истина);
		
	КонецЦикла;
	
	Если Не Отказ Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

// Прочитать протоколы запросов из строки.
// 
// Параметры:
//  ТекстЗапроса - Строка
//  Отказ - Булево
//  ТекстОшибки - Неопределено, Строка - текст ошибки.
// 
// Возвращаемое значение:
//  Массив из см. НовыйПротоколЗапросаHTTP - Прочитать протоколы запросов из строки
//
Функция ПрочитатьПротоколыЗапросовИзСтроки(Знач ТекстЗапроса, Отказ = Ложь, ТекстОшибки = Неопределено)
	
	СписокЗапросов = Новый Массив; // Массив из см. НовыйПротоколЗапросаHTTP
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(ТекстЗапроса);
	
	Если СтрНайти(ТекстЗапроса, "### ") = 0  Тогда
		Текст.ВставитьСтроку(0, "### ЛогированиеТрафика.ПроизвольныйЗапрос");
	КонецЕсли;
	
	ПротоколЗапроса = НовыйПротоколЗапросаHTTP();
	
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл
		
		Стр = Текст.ПолучитьСтроку(НомерСтроки);
		
		Если СтрНачинаетсяС(Стр, "### ") Тогда
			Если ЗначениеЗаполнено(ПротоколЗапроса.Адрес) Тогда
				ПротоколЗапроса.ТелоЗапроса = ПолучитьДвоичныеДанныеИзСтроки(ПротоколЗапроса.ТелоЗапросаСтрокой);
				СписокЗапросов.Добавить(ПротоколЗапроса);
				ПротоколЗапроса = НовыйПротоколЗапросаHTTP();
			КонецЕсли;
			КлючВходящий = " [incoming]";
			Если СтрНайти(Стр, КлючВходящий) Тогда
				ПротоколЗапроса.Входящий = Истина;
				Стр = СтрЗаменить(Стр, КлючВходящий, "");
			КонецЕсли;
			ПротоколЗапроса.Событие = ПротоколЗапроса.Событие + Сред(Стр, 5);
			НомерСтроки = НомерСтроки + 1;
			Стр = Текст.ПолучитьСтроку(НомерСтроки);
			
			// Прочитать адрес запроса в протокол
			ИндексПервогоПробела = СтрНайти(Стр, " ");
			Метод = ВРег(Лев(Стр, ИндексПервогоПробела - 1));
			АдресЗапроса = Сред(Стр, ИндексПервогоПробела + 1);
			Если Не ЗначениеЗаполнено(ПротоколЗапроса.Метод) И Не ПустаяСтрока(АдресЗапроса) Тогда
				Если Метод <> "" И СтрНайти("GET, POST, PATCH, DELETE, PUT", Метод) Тогда
					ПротоколЗапроса.Метод = Метод;
					СтруктураАдреса = СтруктураURI(АдресЗапроса);
					ПротоколЗапроса.Сервер = СтруктураАдреса.Хост;
					ПротоколЗапроса.Адрес = "/" + СтруктураАдреса.ПутьНаСервере;
					ПротоколЗапроса.ЭтоЗащищенноеСоединение = ?(НРег(СтруктураАдреса.Схема) = "https", Истина, Ложь);
					ПротоколЗапроса.Порт = СтруктураАдреса.Порт;
					
				КонецЕсли;
			КонецЕсли;
			СоединитьСтроки(ПротоколЗапроса.ПолныйТекст, Стр);
			
			// Прочитать заголовки.
			Пока НомерСтроки <= Текст.КоличествоСтрок() Цикл
				НомерСтроки = НомерСтроки + 1;
				Стр = Текст.ПолучитьСтроку(НомерСтроки);
				ИндексРазделителя = СтрНайти(Стр, ": ");
				Если ИндексРазделителя = 0 Тогда
					Прервать;
				КонецЕсли;
				СоединитьСтроки(ПротоколЗапроса.ПолныйТекст, Стр);
				ПротоколЗапроса.ЗаголовкиЗапроса.Вставить(Лев(Стр, ИндексРазделителя - 1),
					Сред(Стр, ИндексРазделителя + 2));
			КонецЦикла;
		КонецЕсли;
		
		// Проверка на ответ.
		Если СтрНачинаетсяС(Стр, "# HTTP") Тогда
			ПрочитатьЗаголовокОтветаВПротоколЗапроса(Сред(Стр, 3), ПротоколЗапроса);
			ОжидаемЗаголовкиОтвета = Истина;
			Если СтрНайти(Стр, "ERROR") = Истина Тогда
				ОжидаемЗаголовкиОтвета = Ложь;
			КонецЕсли;
			
			ТекстОтвета = Новый ТекстовыйДокумент;
			Пока НомерСтроки <= Текст.КоличествоСтрок() Цикл
				НомерСтроки = НомерСтроки + 1;
				Стр = Текст.ПолучитьСтроку(НомерСтроки);
				Если Лев(Стр, 1) <> Символы.Таб Тогда
					Прервать;
				КонецЕсли;
				Если Стр = Символы.Таб Тогда
					Если ОжидаемЗаголовкиОтвета Тогда
						ОжидаемЗаголовкиОтвета = Ложь;
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				Если ОжидаемЗаголовкиОтвета Тогда
					Раздел = СтрНайти(Стр, ": ");
					Если Раздел > 0 Тогда
						ПротоколЗапроса.ЗаголовкиОтвета.Вставить(Сред(Стр, 2, Раздел - 2), Сред(Стр, Раздел + 2));
						Продолжить;
					Иначе
						ОжидаемЗаголовкиОтвета = Ложь;
					КонецЕсли;
				КонецЕсли;
				ТекстОтвета.ДобавитьСтроку(Сред(Стр, 2));
			КонецЦикла;
			ПротоколЗапроса.ТелоОтветаСтрокой = ТекстОтвета.ПолучитьТекст();
			Если КонтентСодержитТекст(ПротоколЗапроса.ЗаголовкиОтвета) Тогда
				ПротоколЗапроса.ТелоОтвета = ПолучитьДвоичныеДанныеИзСтроки(ПротоколЗапроса.ТелоОтветаСтрокой);
			Иначе
				ПротоколЗапроса.ТелоОтвета = Base64Значение(ПротоколЗапроса.ТелоОтветаСтрокой);
			КонецЕсли;
			ПротоколЗапроса.Размер = ПротоколЗапроса.ТелоОтвета.Размер()/1000;
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(Стр) Тогда
			Продолжить;
		КонецЕсли;
		
		СоединитьСтроки(ПротоколЗапроса.ПолныйТекст, Стр);
		СоединитьСтроки(ПротоколЗапроса.ТелоЗапросаСтрокой, Стр);
		
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПротоколЗапроса.Адрес) Тогда
		ПротоколЗапроса.ТелоЗапроса = ПолучитьДвоичныеДанныеИзСтроки(ПротоколЗапроса.ТелоЗапросаСтрокой);
		СписокЗапросов.Добавить(ПротоколЗапроса);
	КонецЕсли;
	
	Возврат СписокЗапросов;
	
КонецФункции

// Разбирает строку URI на составные части и возвращает в виде структуры.
// На основе RFC 3986.
//
// Параметры:
//  СтрокаURI - Строка - ссылка на ресурс в формате:
//                       <схема>://<логин>:<пароль>@<хост>:<порт>/<путь>?<параметры>#<якорь>.
//
// Возвращаемое значение:
//  Структура - составные части URI согласно формату:
//   * Схема         - Строка - схема из URI.
//   * Логин         - Строка - логин из URI.
//   * Пароль        - Строка - пароль из URI.
//   * ИмяСервера    - Строка - часть <хост>:<порт> из URI.
//   * Хост          - Строка - хост из URI.
//   * Порт          - Строка - порт из URI.
//   * ПутьНаСервере - Строка - часть <путь>?<параметры>#<якорь> из URI.
//
Функция СтруктураURI(Знач СтрокаURI) Экспорт
	
	СтрокаURI = СокрЛП(СтрокаURI);
	
	// схема
	Схема = "";
	Позиция = СтрНайти(СтрокаURI, "://");
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(СтрокаURI, Позиция - 1));
		СтрокаURI = Сред(СтрокаURI, Позиция + 3);
	КонецЕсли;
	
	// Строка соединения и путь на сервере.
	СтрокаСоединения = СтрокаURI;
	ПутьНаСервере = "";
	Позиция = СтрНайти(СтрокаСоединения, "/");
	Если Позиция > 0 Тогда
		ПутьНаСервере = Сред(СтрокаСоединения, Позиция + 1);
		СтрокаСоединения = Лев(СтрокаСоединения, Позиция - 1);
	КонецЕсли;
	
	// Информация пользователя и имя сервера.
	СтрокаАвторизации = "";
	ИмяСервера = СтрокаСоединения;
	Позиция = СтрНайти(СтрокаСоединения, "@", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		СтрокаАвторизации = Лев(СтрокаСоединения, Позиция - 1);
		ИмяСервера = Сред(СтрокаСоединения, Позиция + 1);
	КонецЕсли;
	
	// логин и пароль
	Логин = СтрокаАвторизации;
	Пароль = "";
	Позиция = СтрНайти(СтрокаАвторизации, ":");
	Если Позиция > 0 Тогда
		Логин = Лев(СтрокаАвторизации, Позиция - 1);
		Пароль = Сред(СтрокаАвторизации, Позиция + 1);
	КонецЕсли;
	
	// хост и порт
	Хост = ИмяСервера;
	Порт = 0;;
	Позиция = СтрНайти(ИмяСервера, ":");
	Если Позиция > 0 Тогда
		Хост = Лев(ИмяСервера, Позиция - 1);
		Порт = Число(Сред(ИмяСервера, Позиция + 1));
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Схема", Схема);
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Пароль", Пароль);
	Результат.Вставить("ИмяСервера", ИмяСервера);
	Результат.Вставить("Хост", Хост);
	Если Порт = 0 Тогда
		Порт = ?(Схема = "https", 443, 80);
	КонецЕсли;
	Результат.Вставить("Порт", Порт);
	Результат.Вставить("ПутьНаСервере", ПутьНаСервере);
	
	Возврат Результат;
	
КонецФункции

Процедура СоединитьСтроки(Строка1, Знач Строка2, Знач Разделитель = Неопределено)
	
	Если Разделитель = Неопределено Тогда
		Разделитель = Символы.ПС;
	КонецЕсли;
	Строка1 = Строка1 + ?(ПустаяСтрока(Строка1), "", Разделитель) + Строка2;
	
КонецПроцедуры

Процедура ПрочитатьЗаголовокОтветаВПротоколЗапроса(Стр, ПротоколЗапроса)
	
	// КодСостояния
	ПозицияПробел = СтрНайти(Стр, " ");
	Подстрока = Сред(Стр, ПозицияПробел + 1);
	ПозицияПробел2 = СтрНайти(Подстрока, " ");
	ПодстрокаКодСостояния = Лев(Подстрока, ПозицияПробел2 - 1);
	Если ВРег(ПодстрокаКодСостояния) <> "ERROR" Тогда
		Попытка
			ПротоколЗапроса.КодОтвета = Число(ПодстрокаКодСостояния);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	// Дата
	ПозицияДатаВремя = СтрНайти(Стр, " - ");
	Если ПозицияДатаВремя Тогда
		ПодстрокаДата = Сред(Стр, ПозицияДатаВремя + 3, 19);
		ПодстрокаМиллисекунды = Сред(Стр, ПозицияДатаВремя + 19 + 4);
		Миллисекунды = 0;
		ПозицияДлительность = СтрНайти(ПодстрокаМиллисекунды, " (");
		Если ПозицияДлительность Тогда
			ПодстрокаДлительность = Сред(ПодстрокаМиллисекунды, ПозицияДлительность + 2);
			ПодстрокаМиллисекунды = Лев(ПодстрокаМиллисекунды, ПозицияДлительность - 1);
			Миллисекунды = Число(ПодстрокаМиллисекунды);
			ПозицияКонецДлительность = СтрНайти(ПодстрокаДлительность, " ");
			ПодстрокаДлительность = Лев(ПодстрокаДлительность, ПозицияКонецДлительность - 1);
			ПротоколЗапроса.Длительность = Число(ПодстрокаДлительность);
		Иначе
			Миллисекунды = Число(ПодстрокаМиллисекунды);
		КонецЕсли;
		ПротоколЗапроса.Дата = Дата(ПодстрокаДата);
		ПротоколЗапроса.ВремяНачала = (ПротоколЗапроса.Дата - Дата(1,1,1)) * 1000 + Миллисекунды;
	Иначе
		ПротоколЗапроса.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	ПротоколЗапроса.ВремяНачала = (УниверсальноеВремя(ПротоколЗапроса.Дата) - Дата(1,1,1)) * 1000 + Миллисекунды;
	
КонецПроцедуры

#Область ВыполнениеЗапроса

// Выполнение произвольного запроса.
//
// Параметры:
//   ТекстЗапроса - Строка - строка запроса сервиса
//   Отказ - Булево - результат исполнения.
//   ТекстОшибки - Строка -возвращаемая ошибка.
//   КлючЗаписиЛога - Структура - отбор записи логов.
//
Процедура ВыполнитьЗапросПоСтроке(Знач ТекстЗапроса, Отказ, ТекстОшибки = "", КлючЗаписиЛога = Неопределено) Экспорт
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	КэшОтветов = Новый Массив;
	КлючНачалаЗапроса = "### ";
	Пока Истина Цикл
		ПозицияВторогоРазделителя = СтрНайти(ТекстЗапроса, КлючНачалаЗапроса,,, 2);
		Если ПозицияВторогоРазделителя = 0 Тогда
			ВыполнитьЗапросHTTP(ТекстЗапроса, КэшОтветов, КлючЗаписиЛога, Отказ, ТекстОшибки);
			Прервать;
		Иначе
			ВложенныйТекст = Лев(ТекстЗапроса, ПозицияВторогоРазделителя - 1);
			ВыполнитьЗапросHTTP(ВложенныйТекст, КэшОтветов, КлючЗаписиЛога, Отказ, ТекстОшибки);
			ТекстЗапроса = Сред(ТекстЗапроса, ПозицияВторогоРазделителя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьЗапросHTTP(СтрокаЗапроса, КэшОтветов, КлючЗаписиЛога, Отказ, ТекстОшибки)
	
	//СтруктураURL = Новый Структура;
	ПроверитьУстановитьПеременныеВСтроке(СтрокаЗапроса, КэшОтветов);
	СписокПротоколов = ПрочитатьПротоколыЗапросовИзСтроки(СтрокаЗапроса);
	Если Не ЗначениеЗаполнено(СписокПротоколов) Тогда
		Возврат;
	КонецЕсли;
	ПротоколЗапроса = СписокПротоколов[0];
	
	// Проверка авторизации в запросе.
	Если ЗначениеЗаполнено(ПротоколЗапроса.Логин) Тогда
		Авторизация = ПолучитьЗначениеЗаголовкаAuthorization(ПротоколЗапроса.ЗаголовкиЗапроса);
		Если Авторизация <> Неопределено И СтрНачинаетсяС(Авторизация, "Basic ") Тогда
			СтрокаПоиска = Сред(Авторизация, 7);
			ЛогинПароль = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(СтрокаПоиска));
			МассивРазделения = СтрРазделить(ЛогинПароль, ":");
			Если МассивРазделения.Количество() = 2 Тогда
				ПротоколЗапроса.Логин = МассивРазделения[0];
				ПротоколЗапроса.Пароль = МассивРазделения[1];
				УдалитьЗаголовокAuthorization(ПротоколЗапроса.ЗаголовкиЗапроса);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Соединение = НовыйHTTPСоединениеПоПараметрам(ПротоколЗапроса, ТекстОшибки);
	Если Соединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(ПротоколЗапроса.Адрес);
	Для каждого ЭлементКоллекции Из ПротоколЗапроса.ЗаголовкиЗапроса Цикл
		Запрос.Заголовки.Вставить(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
	КонецЦикла;
	
	Запрос.УстановитьТелоИзДвоичныхДанных(ПротоколЗапроса.ТелоЗапроса);
	Попытка
		
		Ответ = _HTTPСоединение._ВызватьHTTPМетод(Соединение, Строка(ПротоколЗапроса.Метод), Запрос, , ПротоколЗапроса.Событие);
		
		ТипКонтента = ТипКонтентаОтвета(Ответ);
		Если ТипКонтента = Неопределено Или СтрНайти(ТипКонтента, "image") Тогда
			КэшОтветов.Добавить();
		ИначеЕсли СтрНайти(ТипКонтента, "text") Тогда
			КэшОтветов.Добавить(Ответ.ПолучитьТелоКакСтроку());
		Иначе
			КэшОтветов.Добавить(ЗначениеИзСтрокиJSON(Ответ.ПолучитьТелоКакСтроку(), Истина));
		КонецЕсли;
		
	Исключение
		
		Отказ = Истина;
		ТекстОшибки = 
			НСтр("ru = 'Ошибка выполнения запроса к сервису.'") + Символы.ПС
			+ ПолучитьСтрокуURLЗапроса(ПротоколЗапроса.Метод, ПротоколЗапроса.Сервер,
				ПротоколЗапроса.ЭтоЗащищенноеСоединение, ПротоколЗапроса.Порт, ПротоколЗапроса.Адрес)
			+ Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
	КонецПопытки;
	
КонецПроцедуры

Функция ТипКонтентаОтвета(Ответ)
	
	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ответ.Заголовки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Ответ.Заголовки.Получить("Content-Type");
	
КонецФункции

#КонецОбласти

// Выполняется поиск по маске {{[....}}, например {{[0].ticket}}
Процедура ПроверитьУстановитьПеременныеВСтроке(СтрокаПроверки, КэшРезультатов) Экспорт
	
	Если СтрЧислоВхождений(СтрокаПроверки, "{{[") > 0 Тогда
		
		МассивЗамен = Новый Массив;
		Для ИндексВхождения = 1 По СтрЧислоВхождений(СтрокаПроверки, "{{[") Цикл
			СтрокаПоиска = Сред(СтрокаПроверки, СтрНайти(СтрокаПроверки, "{{[",,, ИндексВхождения));
			СтрокаПоиска = Лев(СтрокаПоиска, СтрНайти(СтрокаПоиска, "}}",,, 1) + 1);
			Если ПустаяСтрока(СтрокаПоиска) Тогда
				Продолжить;
			КонецЕсли;
			СтрокаВыражения = Сред(СтрокаПоиска, 3, СтрДлина(СтрокаПоиска) - 4);
			Попытка
				СтрокаЗамены = Вычислить("КэшРезультатов" + СтрокаВыражения);
			Исключение
				СтрокаЗамены = "=== ERROR [" + СтрокаВыражения + "===";
			КонецПопытки;
			МассивЗамен.Добавить(Новый Структура("Ключ, Значение",
				СтрокаПоиска, СтрокаЗамены));
		КонецЦикла;
			
		Если МассивЗамен.Количество() > 0 Тогда
			Для каждого ЭлементКоллекции Из МассивЗамен Цикл
				СтрокаПроверки = СтрЗаменить(СтрокаПроверки, ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
			КонецЦикла;
		КонецЕсли;
		
	ИначеЕсли СтрНайти(СтрокаПроверки, "{{") > 0 Тогда
		
		// Параметры в адресной строке.
		Если СтрНайти(СтрокаПроверки, "{{$guid}}") <> 0 Тогда
			СтрокаПроверки = СтрЗаменить(СтрокаПроверки, "{{$guid}}",
				Строка(Новый УникальныйИдентификатор));
		ИначеЕсли СтрНайти(СтрокаПроверки, "{{$time}}") <> 0 Тогда
			СтрокаПроверки = СтрЗаменить(СтрокаПроверки, "{{$time}}",
				Строка(ТекущаяУниверсальнаяДатаВМиллисекундах()));
		ИначеЕсли СтрНайти(СтрокаПроверки, "{{") <> 0 Тогда
			ТегНачала = "{{";
			ТегОкончания = "}}";
			ИндексНачала = СтрНайти(СтрокаПроверки, ТегНачала);
			Подстрока = Сред(СтрокаПроверки, ИндексНачала + СтрДлина(ТегНачала));
			ИндексОкончания = СтрНайти(Подстрока, ТегОкончания);
			СтрокаВычисления = Лев(Подстрока, ИндексОкончания - 1);
			СтрокаЗамены = Сред(СтрокаПроверки, ИндексНачала, СтрДлина(ТегНачала) + ИндексОкончания);
			Значение = Вычислить(СтрокаВычисления);
			СтрокаПроверки = СтрЗаменить(СтрокаПроверки, СтрокаЗамены, Значение);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Конструктор HTTPСоединение по полям протокола запроса (см. НовыйПротоколЗапросаHTTP).
//
// Параметры:
//  ПараметрыЗапроса - Структура - см. НовыйПротоколЗапросаHTTP
//  ТекстОшибки - Строка - краткое описание ошибки при неудачном создании соединения
//
// Возвращаемое значение:
//  HTTPСоединение, Неопределено
//
Функция НовыйHTTPСоединениеПоПараметрам(ПараметрыЗапроса, ТекстОшибки = """");
	
	Если ПараметрыЗапроса.ЭтоЗащищенноеСоединение Тогда
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(ПараметрыЗапроса.Сервер, ПараметрыЗапроса.Порт,
			ПараметрыЗапроса.Логин, ПараметрыЗапроса.Пароль, ПараметрыЗапроса.Прокси, ПараметрыЗапроса.Таймаут,
			ЗащищенноеСоединение);
		Возврат Соединение;
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(
			СобытиеВызватьHTTPМетод(),
			УровеньЖурналаРегистрации.Ошибка,,
			,
			ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции

// Краткий комментарий для записи успешного HTTP-вызова в журнал регистрации.
//
// Параметры:
//  ЛогЗапроса - см. РегистрыСведений.ЛогиТрафика.НовыйЛог
//
// Возвращаемое значение:
//  Строка
//
Функция КомментарийЗаписиЖурналаHTTP(ЛогЗапроса) Экспорт
	
	HTTPОтвет = Неопределено;
	КодОтвета = 0;
	Если ЛогЗапроса.Свойство("HTTPОтвет", HTTPОтвет) И HTTPОтвет <> Неопределено Тогда
		КодОтвета = HTTPОтвет.КодСостояния;
	ИначеЕсли ЗначениеЗаполнено(ЛогЗапроса.КодОтвета) Тогда
		КодОтвета = ЛогЗапроса.КодОтвета;
	КонецЕсли;
	
	Возврат СтрШаблон("%1 %2 — %3",
		ВРег(Строка(ЛогЗапроса.Метод)),
		РегистрыСведений.ЛогиТрафика.ПолучитьСтрокуURLЗапроса(ЛогЗапроса),
		Формат(КодОтвета, "ЧГ="));
	
КонецФункции

// Имена заголовка Authorization (каноническое и устаревшее).
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаЗаголовкаAuthorization() Экспорт
	
	Имена = Новый Массив;
	Имена.Добавить("Authorization");
	Имена.Добавить("Autorization");
	Возврат Имена;
	
КонецФункции

// Значение заголовка Authorization с учётом устаревшего имени.
//
// Параметры:
//  Заголовки - Соответствие
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ПолучитьЗначениеЗаголовкаAuthorization(Заголовки) Экспорт
	
	Для Каждого ИмяЗаголовка Из ИменаЗаголовкаAuthorization() Цикл
		Значение = Заголовки.Получить(ИмяЗаголовка);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Удаляет заголовок Authorization (все варианты имени).
//
// Параметры:
//  Заголовки - Соответствие
//
Процедура УдалитьЗаголовокAuthorization(Заголовки) Экспорт
	
	Для Каждого ИмяЗаголовка Из ИменаЗаголовкаAuthorization() Цикл
		Заголовки.Удалить(ИмяЗаголовка);
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает заголовок Authorization в каноническом виде.
//
// Параметры:
//  Заголовки - Соответствие
//  Значение - Строка
//
Процедура УстановитьЗаголовокAuthorization(Заголовки, Значение) Экспорт
	
	УдалитьЗаголовокAuthorization(Заголовки);
	Заголовки.Вставить("Authorization", Значение);
	
КонецПроцедуры

// Подготавливает значение Authorization для записи в лог: Bearer + Base64 сохраняется,
// прочие форматы заменяются на ***.
//
// Параметры:
//  Значение - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеAuthorizationДляЛога(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат "***";
	КонецЕсли;
	
	ЗначениеНРег = НРег(Значение);
	Если СтрНачинаетсяС(ЗначениеНРег, "basic ") Тогда
		ПозицияПробела = СтрНайти(Значение, " ");
		Токен = СокрЛП(Сред(Значение, ПозицияПробела + 1));
		Если ПустаяСтрока(Токен) Тогда
			Возврат "***";
		КонецЕсли;
		Возврат "Bearer " + Токен;
	ИначеЕсли СтрНачинаетсяС(ЗначениеНРег, "bearer ") Тогда
		ПозицияПробела = СтрНайти(Значение, " ");
		Токен = СокрЛП(Сред(Значение, ПозицияПробела + 1));
		Если ПустаяСтрока(Токен) Тогда
			Возврат "***";
		КонецЕсли;
		Возврат "Bearer " + Токен;
	КонецЕсли;
	
	Возврат "***";
	
КонецФункции

// Маскирует значения чувствительных HTTP-заголовков.
// Authorization с Bearer/Basic сохраняется в закодированном виде для формы авторизации.
//
// Параметры:
//  Заголовки - Соответствие
//
Процедура МаскироватьСекретныеЗаголовки(Заголовки) Экспорт
	
	Если Заголовки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаAuthorization = Новый Массив;
	ИменаAuthorization.Добавить("authorization");
	ИменаAuthorization.Добавить("autorization");
	
	ПолностьюМаскируемыеИмена = Новый Массив;
	ПолностьюМаскируемыеИмена.Добавить("cookie");
	ПолностьюМаскируемыеИмена.Добавить("x-api-key");
	
	Для Каждого ЭлементЗаголовка Из Заголовки Цикл
		ИмяВНижнемРегистре = НРег(Строка(ЭлементЗаголовка.Ключ));
		Если ИменаAuthorization.Найти(ИмяВНижнемРегистре) <> Неопределено Тогда
			Заголовки[ЭлементЗаголовка.Ключ] = ЗначениеAuthorizationДляЛога(ЭлементЗаголовка.Значение);
		ИначеЕсли ПолностьюМаскируемыеИмена.Найти(ИмяВНижнемРегистре) <> Неопределено Тогда
			Заголовки[ЭлементЗаголовка.Ключ] = "***";
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Подготавливает структуру лога к записи в регистр или журнал.
//
// Параметры:
//  ЛогЗапроса - Структура - рабочий лог HTTP-запроса
//  Назначение - ПеречислениеСсылка.НазначениеЛога
//  ИмяВыходногоФайла - Строка - если ответ сохранён в файл при ВызватьHTTPМетод
//
// Возвращаемое значение:
//  Структура
//
Функция ПодготовитьЛог(ЛогЗапроса, Назначение, Знач ИмяВыходногоФайла = "") Экспорт
	
	Настройки = ЗагрузитьНастройкиЛогирования();
	
	ОбеспечитьТелоОтветаВЛоге(ЛогЗапроса, ИмяВыходногоФайла);
	
	Результат = ОбщегоНазначения.СкопироватьРекурсивно(ЛогЗапроса);
	
	Результат.Длительность = ДлительностьЛогЗапроса(ЛогЗапроса);
	
	ДополнитьЛогДаннымиОтвета(Результат, ЛогЗапроса, Настройки, ИмяВыходногоФайла);
	
	Входящий = Ложь;
	Если Результат.Свойство("Входящий") Тогда
		Входящий = Результат.Входящий;
	КонецЕсли;
	
	// Размер — до усечения/очистки тел.
	УстановитьРазмерЛога(Результат);
	
	Содержание = РегистрыСведений.ЛогиТрафика.ПодготовитьСодержание(
		Результат.Содержание,
		Назначение,
		Входящий);
	МаскироватьСекретныеЗаголовки(Содержание.ЗаголовкиЗапроса);
	МаскироватьСекретныеЗаголовки(Содержание.ЗаголовкиОтвета);
	Результат.Содержание = Содержание;
	
	Если Назначение = Перечисления.НазначениеЛога.Журнал Тогда
		
		Результат.Метод = Строка(Результат.Метод);
		
		Если Не Настройки.ЗаписыватьВЖРТело Тогда
			Результат.Содержание.ТелоЗапроса = "";
			Результат.Содержание.ТелоОтвета = "";
		Иначе
			ЛимитТелаКБ = Настройки.МаксимальныйРазмерТела;
			Результат.Содержание.ТелоЗапроса = УсечьТелоПоЛимитуКБ(
				Результат.Содержание.ТелоЗапроса,
				ЛимитТелаКБ,
				Результат.Содержание.ЗаголовкиЗапроса);
			Результат.Содержание.ТелоОтвета = УсечьТелоПоЛимитуКБ(
				Результат.Содержание.ТелоОтвета,
				ЛимитТелаКБ,
				Результат.Содержание.ЗаголовкиОтвета);
		КонецЕсли;
		
	ИначеЕсли Назначение = Перечисления.НазначениеЛога.Регистр Тогда
		
		Если Настройки.ЗаписыватьВРСТело Тогда
			ЛимитТелаКБ = Настройки.МаксимальныйРазмерТела;
			Результат.Содержание.ТелоЗапроса = ТелоЛогаКакДвоичныеДанные(Результат.Содержание.ТелоЗапроса);
			ТелоОтвета = ТелоЛогаКакДвоичныеДанные(Результат.Содержание.ТелоОтвета);
			Результат.Содержание.ТелоЗапроса = УсечьТелоПоЛимитуКБ(
				Результат.Содержание.ТелоЗапроса,
				ЛимитТелаКБ,
				Результат.Содержание.ЗаголовкиЗапроса);
			Результат.Содержание.ТелоОтвета = УсечьТелоПоЛимитуКБ(
				ТелоОтвета,
				ЛимитТелаКБ,
				Результат.Содержание.ЗаголовкиОтвета);
		Иначе
			Результат.Содержание.ТелоЗапроса = Неопределено;
			Результат.Содержание.ТелоОтвета = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Результат.Свойство("HTTPОтвет") Тогда
		Результат.Удалить("HTTPОтвет");
	КонецЕсли;
	
	Если Результат.Свойство("ВремяНачалаЗамера") Тогда
		Результат.Удалить("ВремяНачалаЗамера");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Длительность HTTP-запроса в секундах для записи в лог.
//
// Параметры:
//  ЛогЗапроса - Структура - рабочий лог
//
// Возвращаемое значение:
//  Число - для исходящих — от ВремяНачала создания лога; для входящих — от ВремяНачалаЗамера или 0
//
Функция ДлительностьЛогЗапроса(ЛогЗапроса)
	
	Входящий = Ложь;
	Если ЛогЗапроса.Свойство("Входящий") Тогда
		Входящий = ЛогЗапроса.Входящий;
	КонецЕсли;
	
	Если Входящий Тогда
		
		ВремяНачалаЗамера = Неопределено;
		Если ЛогЗапроса.Свойство("ВремяНачалаЗамера", ВремяНачалаЗамера)
			И ЗначениеЗаполнено(ВремяНачалаЗамера) Тогда
			Возврат (ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачалаЗамера) / 1000;
		КонецЕсли;
		
		Возврат 0;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛогЗапроса.ВремяНачала) Тогда
		Возврат (ТекущаяУниверсальнаяДатаВМиллисекундах() - ЛогЗапроса.ВремяНачала) / 1000;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Данные для записи в журнал регистрации (JSON-представление лога).
//
// Параметры:
//  ЛогЗапроса - см. РегистрыСведений.ЛогиТрафика.НовыйЛог
//
// Возвращаемое значение:
//  Строка
//
Функция ДанныеДляЗаписиВЖурналРегистрации(ЛогЗапроса) Экспорт
	
	ЛогЖурнала = ПодготовитьЛог(ЛогЗапроса, Перечисления.НазначениеЛога.Журнал);
	Возврат ЗначениеВJSON(ЛогЖурнала);
	
КонецФункции

Процедура ДополнитьЛогДаннымиОтвета(Результат, ЛогЗапроса, Настройки, Знач ИмяВыходногоФайла = "")
	
	HTTPОтвет = Неопределено;
	Если ЛогЗапроса.Свойство("HTTPОтвет", HTTPОтвет) И HTTPОтвет <> Неопределено Тогда
		
		Результат.КодОтвета = HTTPОтвет.КодСостояния;
		Результат.Содержание.ЗаголовкиОтвета = ОбщегоНазначения.СкопироватьРекурсивно(HTTPОтвет.Заголовки);
		
		ПисатьТело = Настройки.ЗаписыватьВЖРТело Или Настройки.ЗаписыватьВРСТело;
		НуженРазмерОтвета = Не ИспользоватьРазмерТелаЗапроса(Результат);
		
		Если ПисатьТело Или НуженРазмерОтвета Тогда
			
			ТелоОтвета = Неопределено;
			Если ТелоЛогаЗаполнено(Результат.Содержание.ТелоОтвета) Тогда
				ТелоОтвета = Результат.Содержание.ТелоОтвета;
			ИначеЕсли ТелоЛогаЗаполнено(ЛогЗапроса.Содержание.ТелоОтвета) Тогда
				ТелоОтвета = ЛогЗапроса.Содержание.ТелоОтвета;
				Если ПисатьТело Тогда
					Результат.Содержание.ТелоОтвета = ТелоОтвета;
				КонецЕсли;
			Иначе
				ТелоОтвета = ТелоHTTPОтвета(HTTPОтвет, ИмяВыходногоФайла);
				Если ТелоЛогаЗаполнено(ТелоОтвета) И ПисатьТело Тогда
					Результат.Содержание.ТелоОтвета = ТелоОтвета;
					ЛогЗапроса.Содержание.ТелоОтвета = ТелоОтвета;
				КонецЕсли;
			КонецЕсли;
			
			Если Не ПисатьТело И ТелоЛогаЗаполнено(ТелоОтвета) Тогда
				// Временно для расчёта размера; очистится в ПодготовитьЛог при записи без тела.
				Результат.Содержание.ТелоОтвета = ТелоОтвета;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Исходящий POST/PUT/PATCH — размер ушедшего тела запроса; иначе размер ответа.
//
Процедура УстановитьРазмерЛога(ЛогЗапроса)
	
	Если Не ЛогЗапроса.Свойство("Размер") Тогда
		ЛогЗапроса.Вставить("Размер", 0);
	КонецЕсли;
	
	РазмерКБ = 0;
	Если ИспользоватьРазмерТелаЗапроса(ЛогЗапроса) Тогда
		РазмерКБ = РазмерТелаЛогаВКБ(ЛогЗапроса.Содержание.ТелоЗапроса);
	ИначеЕсли ТипЗнч(ЛогЗапроса.Содержание) = Тип("Структура") Тогда
		РазмерКБ = РазмерТелаЛогаВКБ(ЛогЗапроса.Содержание.ТелоОтвета);
	КонецЕсли;
	
	ЛогЗапроса.Размер = РазмерКБ;
	
	// Совместимость со старыми записями ЖР / копиями структур.
	Если ЛогЗапроса.Свойство("РазмерОтвета") Тогда
		ЛогЗапроса.РазмерОтвета = РазмерКБ;
	КонецЕсли;
	
КонецПроцедуры

Функция ИспользоватьРазмерТелаЗапроса(ЛогЗапроса)
	
	Если ТипЗнч(ЛогЗапроса) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Входящий = Ложь;
	Если ЛогЗапроса.Свойство("Входящий") Тогда
		Входящий = ЛогЗапроса.Входящий;
	КонецЕсли;
	Если Входящий Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЛогЗапроса.Свойство("Метод") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Метод = ЛогЗапроса.Метод;
	Если Метод = Перечисления.МетодHTTP.POST
		Или Метод = Перечисления.МетодHTTP.PUT
		Или Метод = Перечисления.МетодHTTP.PATCH Тогда
		Возврат ТелоЛогаЗаполнено(ЛогЗапроса.Содержание.ТелоЗапроса);
	КонецЕсли;
	
	Если ТипЗнч(Метод) = Тип("Строка") Тогда
		МетодВРег = ВРег(Метод);
		Если МетодВРег = "POST" Или МетодВРег = "PUT" Или МетодВРег = "PATCH" Тогда
			Возврат ТелоЛогаЗаполнено(ЛогЗапроса.Содержание.ТелоЗапроса);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция РазмерТелаЛогаВКБ(Тело)
	
	ДвоичныеДанные = ТелоЛогаКакДвоичныеДанные(Тело);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат ДвоичныеДанные.Размер() / 1000;
	
КонецФункции

// Усекает тело по лимиту КБ: текст — префикс + маркер; бинарь — заглушка.
//
// Параметры:
//  Тело - Строка, ДвоичныеДанные, Неопределено
//  ЛимитКБ - Число - 0 без лимита
//  Заголовки - Соответствие, ФиксированноеСоответствие, Неопределено
//
// Возвращаемое значение:
//  Строка, ДвоичныеДанные, Неопределено
//
Функция УсечьТелоПоЛимитуКБ(Тело, ЛимитКБ, Заголовки)
	
	Если ЛимитКБ <= 0 Или Тело = Неопределено Тогда
		Возврат Тело;
	КонецЕсли;
	
	ВернутьСтроку = ТипЗнч(Тело) = Тип("Строка");
	Если ВернутьСтроку Тогда
		Если ПустаяСтрока(Тело) Тогда
			Возврат Тело;
		КонецЕсли;
		ДвоичныеДанныеТела = ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8);
	ИначеЕсли ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		Если Тело.Размер() = 0 Тогда
			Возврат Тело;
		КонецЕсли;
		ДвоичныеДанныеТела = Тело;
	Иначе
		Возврат Тело;
	КонецЕсли;
	
	РазмерБайт = ДвоичныеДанныеТела.Размер();
	МаксБайтов = ЛимитКБ * 1024;
	Если РазмерБайт <= МаксБайтов Тогда
		Возврат Тело;
	КонецЕсли;
	
	БылоКБ = Окр(РазмерБайт / 1024, 1);
	
	Если КонтентСодержитТекст(Заголовки) Тогда
		Маркер = СтрШаблон(
			НСтр("ru = '%1[OneSniffer: тело усечено при записи. Было ~%2 КБ, лимит %3 КБ]'"),
			Символы.ПС + Символы.ПС + "… ",
			Формат(БылоКБ, "ЧГ=0; ЧДЦ=1"),
			Формат(ЛимитКБ, "ЧГ=0"));
		Префикс = ПрефиксДвоичныхДанных(ДвоичныеДанныеТела, МаксБайтов);
		МаркерДвоичные = ПолучитьДвоичныеДанныеИзСтроки(Маркер, КодировкаТекста.UTF8);
		Части = Новый Массив;
		Части.Добавить(Префикс);
		Части.Добавить(МаркерДвоичные);
		РезультатДвоичные = СоединитьДвоичныеДанные(Части);
	Иначе
		Маркер = СтрШаблон(
			НСтр("ru = '[OneSniffer: тело не сохранено (binary). Было ~%1 КБ, лимит %2 КБ]'"),
			Формат(БылоКБ, "ЧГ=0; ЧДЦ=1"),
			Формат(ЛимитКБ, "ЧГ=0"));
		РезультатДвоичные = ПолучитьДвоичныеДанныеИзСтроки(Маркер, КодировкаТекста.UTF8);
	КонецЕсли;
	
	Если ВернутьСтроку Тогда
		Возврат ПолучитьСтрокуИзДвоичныхДанных(РезультатДвоичные, КодировкаТекста.UTF8);
	КонецЕсли;
	
	Возврат РезультатДвоичные;
	
КонецФункции

Функция ПрефиксДвоичныхДанных(ДвоичныеДанные, МаксБайтов)
	
	Поток = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(Поток);
	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные);
	ЧтениеДанных.КопироватьВ(ЗаписьДанных, МаксБайтов);
	ЗаписьДанных.Close();
	ЧтениеДанных.Закрыть();
	
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
КонецФункции


// Извлекает превью картинок из тела ответа для вкладки «Картинки».
//
// Параметры:
//  Тело - ДвоичныеДанные, Строка, Неопределено
//  Заголовки - Соответствие, ФиксированноеСоответствие, Неопределено
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя - Строка
//   * ДвоичныеДанные - ДвоичныеДанные, Неопределено
//   * Усечено - Булево
//   * Пояснение - Строка
//
Функция ИзвлечьПревьюКартинок(Тело, Заголовки) Экспорт
	
	Результат = Новый Массив;
	Если Тело = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипКонтента = "";
	Если ТипЗнч(Заголовки) = Тип("Соответствие")
		Или ТипЗнч(Заголовки) = Тип("ФиксированноеСоответствие") Тогда
		ТипКонтента = НРег(Строка(Заголовки.Получить("Content-Type")));
		Если ПустаяСтрока(ТипКонтента) Тогда
			ТипКонтента = НРег(Строка(Заголовки.Получить("content-type")));
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(ТипКонтента, "image") > 0 И ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		ЭлементПревью = Новый Структура("Имя, ДвоичныеДанные, Усечено, Пояснение",
			НСтр("ru = 'Тело ответа'"), Тело, Ложь, "");
		Результат.Добавить(ЭлементПревью);
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		ТекстТела = ПолучитьСтрокуИзДвоичныхДанных(Тело, КодировкаТекста.UTF8);
	Иначе
		ТекстТела = Строка(Тело);
	КонецЕсли;
	
	ЭтоJSON = СтрНайти(НРег(ТипКонтента), "json") > 0
		Или (ПустаяСтрока(ТипКонтента) И СтрНачинаетсяС(СокрЛ(ТекстТела), "{"));
	Если ПустаяСтрока(ТекстТела) Или Не ЭтоJSON Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДанныеJSON = ЗначениеИзСтрокиJSON(ТекстТела, Истина);
	Исключение
		Возврат Результат;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие") И ТипЗнч(ДанныеJSON) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеJSON) = Тип("Соответствие") Тогда
		Для Каждого Пара Из ДанныеJSON Цикл
			Если ТипЗнч(Пара.Значение) <> Тип("Строка") Тогда
				Продолжить;
			КонецЕсли;
			ЗначениеПоля = Пара.Значение;
			Если СтрДлина(ЗначениеПоля) < 32 Тогда
				Если СтрНайти(ЗначениеПоля, "...") > 0 Тогда
					ЭлементПревью = Новый Структура("Имя, ДвоичныеДанные, Усечено, Пояснение",
						Строка(Пара.Ключ), Неопределено, Истина,
						НСтр("ru = 'Изображение урезано при записи в лог'"));
					Результат.Добавить(ЭлементПревью);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Base64СтрокаДанных = ЗначениеПоля;
			Если СтрНачинаетсяС(НРег(Base64СтрокаДанных), "data:image") Тогда
				ПозицияЗапятой = СтрНайти(Base64СтрокаДанных, ",");
				Если ПозицияЗапятой = 0 Тогда
					Продолжить;
				КонецЕсли;
				Base64СтрокаДанных = Сред(Base64СтрокаДанных, ПозицияЗапятой + 1);
			ИначеЕсли Пара.Ключ <> "image" И Не ПохожеНаBase64Изображения(Base64СтрокаДанных) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				ДвоичныеДанныеКартинки = Base64Значение(Base64СтрокаДанных);
			Исключение
				Продолжить;
			КонецПопытки;
			
			Если ДвоичныеДанныеКартинки = Неопределено Или ДвоичныеДанныеКартинки.Размер() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ЭтоДвоичныеДанныеИзображения(ДвоичныеДанныеКартинки) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлементПревью = Новый Структура("Имя, ДвоичныеДанные, Усечено, Пояснение",
				Строка(Пара.Ключ), ДвоичныеДанныеКартинки, Ложь, "");
			Результат.Добавить(ЭлементПревью);
		КонецЦикла;
	КонецЕсли;
	
	Если Результат.Количество() = 0 Тогда
		ДобавитьПревьюПоURLИзJSON(Результат, ДанныеJSON);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Ищет URL картинки в JSON и скачивает превью без логирования HTTP.
//
Процедура ДобавитьПревьюПоURLИзJSON(Результат, ДанныеJSON)
	
	АдресURL = НайтиURLИзображенияВДанныхJSON(ДанныеJSON);
	Если ПустаяСтрока(АдресURL) Тогда
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанныеКартинки = СкачатьИзображениеПоURLБезЛогирования(АдресURL);
	Если ДвоичныеДанныеКартинки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементПревью = Новый Структура("Имя, ДвоичныеДанные, Усечено, Пояснение",
		НСтр("ru = 'По ссылке'"), ДвоичныеДанныеКартинки, Ложь, АдресURL);
	Результат.Добавить(ЭлементПревью);
	
КонецПроцедуры

// Рекурсивно ищет первый URL изображения (urls.regular/small/thumb или http(s) картинка).
//
Функция НайтиURLИзображенияВДанныхJSON(Данные, Глубина = 0)
	
	Если Глубина > 8 Или Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		
		Урлы = Данные.Получить("urls");
		Если ТипЗнч(Урлы) = Тип("Соответствие") Тогда
			Для Каждого ИмяПоля Из СтрРазделить("regular,small,thumb,full", ",") Цикл
				Кандидат = Урлы.Получить(ИмяПоля);
				Если ТипЗнч(Кандидат) = Тип("Строка") И ЭтоURLИзображения(Кандидат) Тогда
					Возврат Кандидат;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого Пара Из Данные Цикл
			Если ТипЗнч(Пара.Значение) = Тип("Строка") Тогда
				Если ЭтоURLИзображения(Пара.Значение) Тогда
					Возврат Пара.Значение;
				КонецЕсли;
			Иначе
				НайденныйURL = НайтиURLИзображенияВДанныхJSON(Пара.Значение, Глубина + 1);
				Если Не ПустаяСтрока(НайденныйURL) Тогда
					Возврат НайденныйURL;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Данные) = Тип("Массив") Тогда
		
		Для Каждого Элемент Из Данные Цикл
			НайденныйURL = НайтиURLИзображенияВДанныхJSON(Элемент, Глубина + 1);
			Если Не ПустаяСтрока(НайденныйURL) Тогда
				Возврат НайденныйURL;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ЭтоURLИзображения(СтрокаURL)
	
	Адрес = СокрЛП(СтрокаURL);
	АдресНРег = НРег(Адрес);
	Если Не СтрНачинаетсяС(АдресНРег, "https://") И Не СтрНачинаетсяС(АдресНРег, "http://") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СтрНайти(АдресНРег, "images.unsplash.com") > 0
		Или СтрНайти(АдресНРег, "plus.unsplash.com") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СтрНайти(АдресНРег, ".jpg") > 0
		Или СтрНайти(АдресНРег, ".jpeg") > 0
		Или СтрНайти(АдресНРег, ".png") > 0
		Или СтрНайти(АдресНРег, ".webp") > 0
		Или СтрНайти(АдресНРег, ".gif") > 0;
	
КонецФункции

// Скачивает изображение тихим HTTPСоединение (без _HTTPСоединение / логов).
//
Функция СкачатьИзображениеПоURLБезЛогирования(АдресURL)
	
	МаксРазмер = 2 * 1024 * 1024;
	
	Попытка
		ЧастиURI = СтруктураURI(АдресURL);
		Если ПустаяСтрока(ЧастиURI.Хост) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ЗащищенноеСоединение = Неопределено;
		Если ЧастиURI.Схема = "https" Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
		КонецЕсли;
		
		Соединение = Новый HTTPСоединение(ЧастиURI.Хост, ЧастиURI.Порт, , , , 15, ЗащищенноеСоединение);
		Путь = "/" + ЧастиURI.ПутьНаСервере;
		Ответ = Соединение.Получить(Новый HTTPЗапрос(Путь));
		Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		Если ДвоичныеДанные = Неопределено
			Или ДвоичныеДанные.Размер() = 0
			Или ДвоичныеДанные.Размер() > МаксРазмер Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Если Не ЭтоДвоичныеДанныеИзображения(ДвоичныеДанные) Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Возврат ДвоичныеДанные;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПохожеНаBase64Изображения(СтрокаBase64)
	
	Если СтрДлина(СтрокаBase64) < 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Префикс = Лев(СтрокаBase64, 20);
	Возврат СтрНачинаетсяС(Префикс, "/9j/") // jpeg
		Или СтрНачинаетсяС(Префикс, "iVBOR") // png
		Или СтрНачинаетсяС(Префикс, "R0lGOD") // gif
		Или СтрНачинаетсяС(Префикс, "UklGR"); // webp (RIFF)
	
КонецФункции

Функция ЭтоДвоичныеДанныеИзображения(ДвоичныеДанные)
	
	Попытка
		Картинка = Новый Картинка(ДвоичныеДанные);
		Возврат Картинка.Вид <> ВидКартинки.Пустая;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

// Событие очистить историю финиш.
// 
// Возвращаемое значение:
//  Строка
//
Функция СобытиеОчиститьИсториюФиниш()
	Возврат СтрШаблон("%1ОчиститьИсторию.Финиш", НаименованиеБиблиотеки());
КонецФункции

