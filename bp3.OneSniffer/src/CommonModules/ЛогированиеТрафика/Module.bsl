// @strict-types


#Область СлужебныйПрограммныйИнтерфейс

#Область НастройкиЛогирования

// Конструктор настроек логирования по умолчанию (все флаги выключены).
//
// Возвращаемое значение:
//  Структура:
// * ВключеноЛогирование - Булево
// * ПолучениеИсключенийВключено - Булево
// * ПолучатьИсключенияФЗ - Булево
// * ЗаписыватьВЖР - Булево
// * ЗаписыватьВРС - Булево
// * ЗаписыватьВРСТело - Булево
// * СрокХранения - Число - в днях
// * ЗаписыватьВЖРТело - Булево
// * МаксимальныйРазмерТела - Число - лимит тела в КБ при записи в РС/ЖР; 0 — без лимита
// * ДатаЧтенияЖР - Дата - курсор импорта из журнала регистрации
// * УсекатьДлинныйBase64 - Булево - усечение длинных base64 в тексте для UI
// * Редактор - Структура - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Функция НовыйНастройкиЛогирования() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ВключеноЛогирование", Ложь);
	Результат.Вставить("ПолучениеИсключенийВключено", Ложь);
	Результат.Вставить("ПолучатьИсключенияФЗ", Ложь);
	Результат.Вставить("ЗаписыватьВЖР", Ложь);
	Результат.Вставить("ЗаписыватьВРС", Ложь);
	Результат.Вставить("ЗаписыватьВРСТело", Ложь);
	Результат.Вставить("ЗаписыватьВЖРТело", Ложь);
	Результат.Вставить("МаксимальныйРазмерТела", 0);
//	Результат.Вставить("ВключенаТрассировка",  Ложь);
//	Результат.Вставить("ТаймаутЗапросов",      0);
//	Результат.Вставить("ПовторПриОшибкеСоединения", Ложь);
	Результат.Вставить("СрокХранения", 0);
	Результат.Вставить("ДатаЧтенияЖР", '00010101');
	Результат.Вставить("УсекатьДлинныйBase64", Ложь);
	Результат.Вставить("Редактор", OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию());
	Возврат Результат;
	
КонецФункции

// Сохраненные настройки логирования.
// 
// Возвращаемое значение:
//  см. НовыйНастройкиЛогирования
//
Функция ЗагрузитьНастройкиЛогирования() Экспорт
	
	НастройкиЛогирование = НовыйНастройкиЛогирования();
	
	ЗагруженныеНастройкиЛогирование = ПрочитатьНастройкиЛогированияИзРС();
	
	Если ТипЗнч(ЗагруженныеНастройкиЛогирование) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(НастройкиЛогирование, ЗагруженныеНастройкиЛогирование);
		Если Не ЗагруженныеНастройкиЛогирование.Свойство("ЗаписыватьВРСТело") Тогда
			// До разделения настроек тело в РС писалось при выключенном ЖР.
			НастройкиЛогирование.ЗаписыватьВРСТело = Истина;
		КонецЕсли;
	КонецЕсли;
	
	НастройкиЛогирование.Редактор = ЗагрузитьНастройкиРедактора();
	
	Возврат НастройкиЛогирование;
	
КонецФункции

// Настройки Monaco Editor (персональные, вложены в настройки логирования).
//
// Возвращаемое значение:
//  Структура - см. OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию
//
Функция ЗагрузитьНастройкиРедактора() Экспорт
	
	КлючОбъекта = КлючХранилищаНастроекЛогирования();
	ЗагруженныеНастройки = ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, "Настройки", Неопределено);
	Возврат НастройкиРедактораИзХранилища(ЗагруженныеНастройки);
	
КонецФункции

// Сохраняет настройки Monaco Editor в пользовательском хранилище.
//
// Параметры:
//  НастройкиРедактора - Структура
//
Процедура СохранитьНастройкиРедактора(НастройкиРедактора) Экспорт
	
	Редактор = OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию();
	Если ТипЗнч(НастройкиРедактора) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Редактор, НастройкиРедактора);
	КонецЕсли;
	
	КлючОбъекта = КлючХранилищаНастроекЛогирования();
	Пакет = Новый Структура;
	ЗагруженныеНастройки = ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, "Настройки", Неопределено);
	Если ТипЗнч(ЗагруженныеНастройки) = Тип("Структура") Тогда
		Пакет = ОбщегоНазначения.СкопироватьРекурсивно(ЗагруженныеНастройки);
	КонецЕсли;
	Пакет.Вставить("Редактор", Редактор);
	ХранилищеОбщихНастроекСохранить(КлючОбъекта, "Настройки", Пакет);
	
КонецПроцедуры

// Сохранить настройки логирования в РС (общие для ИБ).
// Настройки редактора при наличии в структуре пишутся в пользовательское хранилище.
//
// Параметры:
//  Настройки - Структура:
//
Процедура СохранитьНастройкиЛогирования(Настройки) Экспорт
	
	ПолныеНастройки = НовыйНастройкиЛогирования();
	ЗагруженныеНастройки = ПрочитатьНастройкиЛогированияИзРС();
	Если ТипЗнч(ЗагруженныеНастройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ПолныеНастройки, ЗагруженныеНастройки);
	КонецЕсли;
	
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ПолныеНастройки, Настройки, , "Редактор");
		Если Настройки.Свойство("Редактор") И ТипЗнч(Настройки.Редактор) = Тип("Структура") Тогда
			СохранитьНастройкиРедактора(Настройки.Редактор);
		КонецЕсли;
	КонецЕсли;
	
	ЗаписатьНастройкиЛогированияВРС(НастройкиЛогированияБезРедактора(ПолныеНастройки));
	
КонецПроцедуры

// Хранилище общих настроек сохранить.
// 
// Параметры:
//  КлючОбъекта - Строка
//  КлючНастроек - Строка
//  ЗначениеНастройки - Произвольный
//
Процедура ХранилищеОбщихНастроекСохранить(КлючОбъекта, КлючНастроек, ЗначениеНастройки) Экспорт
	
	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") <> Неопределено Тогда
		МодульОбщегоНазначенияВызовСервера = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияВызовСервера");
		МодульОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить(КлючОбъекта, КлючНастроек, ЗначениеНастройки);
		Возврат;
	КонецЕсли;
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, ЗначениеНастройки);
	
КонецПроцедуры

// Хранилище общих настроек загрузить.
// 
// Параметры:
//  КлючОбъекта - Строка
//  КлючНастроек - Строка
//  ЗначениеПоУмолчанию - Произвольный
// 
// Возвращаемое значение:
//  Произвольный -  Хранилище общих настроек загрузить
//
Функция ХранилищеОбщихНастроекЗагрузить(КлючОбъекта, КлючНастроек, ЗначениеПоУмолчанию) Экспорт
	
	Если Метаданные.Подсистемы.Найти("СтандартныеПодсистемы") <> Неопределено Тогда
		МодульОбщегоНазначенияВызовСервера = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияВызовСервера");
		Результат = МодульОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить(
			КлючОбъекта, КлючНастроек, ЗначениеПоУмолчанию);
		Возврат Результат;
	КонецЕсли;
	
	Результат = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек);
	
	Если Результат = Неопределено Тогда
		Результат = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОчисткаИстории

// Обработчик регламентного задания очистки устаревших логов.
//
Процедура ОчиститьИсториюЛоговРегламентноеЗадание() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.OneSniffer_ОчисткаЛоговТрафика);
	
	Настройки = ЗагрузитьНастройкиЛогирования();
	Если Настройки.СрокХранения <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЗаписатьСобытиеОчисткиИсторииСтарт(Настройки.СрокХранения);
	
	РезультатОчистки = РегистрыСведений.ЛогиТрафика.ОчиститьИсторию(Настройки.СрокХранения);
	
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - ВремяНачала;
	ЗаписатьСобытиеОчисткиИсторииФиниш(Настройки.СрокХранения, РезультатОчистки, Длительность);
	
КонецПроцедуры

// Состояние регламентного задания очистки для формы настроек.
//
// Возвращаемое значение:
//  Структура:
// * Описание - Строка
// * Идентификатор - УникальныйИдентификатор, Неопределено
// * РегламентныеЗаданияДоступны - Булево
// * ЗаданиеНайдено - Булево
// * Использование - Булево
// * ПредставлениеРасписания - Строка
//
Функция СостояниеРегламентногоЗаданияОчистки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Описание", "");
	Результат.Вставить("Идентификатор", Неопределено);
	Результат.Вставить("РегламентныеЗаданияДоступны", Ложь);
	Результат.Вставить("ЗаданиеНайдено", Ложь);
	Результат.Вставить("Использование", Ложь);
	Результат.Вставить("ПредставлениеРасписания", "");
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РегламентныеЗадания") Тогда
		Результат.Описание = НСтр(
			"ru = 'Регламентные задания недоступны (нет БСП). Обновите расширение в конфигурации с БСП.'");
		Возврат Результат;
	КонецЕсли;
	
	Результат.РегламентныеЗаданияДоступны = Истина;
	
	Попытка
		Идентификатор = РегламентныеЗаданияСервер.УникальныйИдентификатор(
			Метаданные.РегламентныеЗадания.OneSniffer_ОчисткаЛоговТрафика);
		Задание = РегламентныеЗаданияСервер.Задание(Идентификатор);
	Исключение
		Результат.Описание = НСтр(
			"ru = 'Задание не зарегистрировано. Обновите расширение / перезагрузите конфигурацию.'");
		Возврат Результат;
	КонецПопытки;
	
	Результат.Идентификатор = Идентификатор;
	Результат.ЗаданиеНайдено = Истина;
	Результат.Использование = Задание.Использование;
	Результат.ПредставлениеРасписания = ПредставлениеРасписанияРегламентногоЗадания(Задание.Расписание);
	
	Если Задание.Использование Тогда
		Шаблон = НСтр("ru = 'Регламентное задание включено. Расписание: %1'");
		Результат.Описание = СтрШаблон(Шаблон, Результат.ПредставлениеРасписания);
	Иначе
		Результат.Описание = НСтр(
			"ru = 'Регламентное задание отключено. Настройте в карточке регламентного задания.'");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеРасписанияРегламентногоЗадания(Расписание)
	
	Если Расписание = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	РасписаниеОбъект = Новый РасписаниеРегламентногоЗадания;
	Если ТипЗнч(Расписание) = Тип("РасписаниеРегламентногоЗадания") Тогда
		РасписаниеОбъект = Расписание;
	Иначе
		ЗаполнитьЗначенияСвойств(РасписаниеОбъект, Расписание);
	КонецЕсли;
	
	Представление = Строка(РасписаниеОбъект);
	Если ПустаяСтрока(Представление) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ВРег(Лев(Представление, 1)) + Сред(Представление, 2);
	
КонецФункции

// Запускает очистку логов вне очереди как длительную операцию БСП.
//
// Возвращаемое значение:
//  Структура - см. ДлительныеОперации.ВыполнитьПроцедуру
//
Функция ВыполнитьРегламентноеЗаданиеОчисткиСейчас() Экспорт
	
	ИмяПроцедуры = "ЛогированиеТрафика.ОчиститьИсториюЛоговРегламентноеЗадание";
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне();
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.СРасширениямиБазыДанных = Истина;
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Очистка логов трафика OneSniffer'");
	
	Возврат ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, ИмяПроцедуры);
	
КонецФункции

Процедура ЗаписатьСобытиеОчисткиИсторииСтарт(СрокХранения)
	
	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("СрокХранения", СрокХранения);
	
	ЗаписьЖурналаРегистрации(
		СобытиеОчиститьИсториюСтарт(),
		УровеньЖурналаРегистрации.Информация, , ,
		ЗначениеВJSON(ДанныеСобытия));
	
КонецПроцедуры

Процедура ЗаписатьСобытиеОчисткиИсторииФиниш(СрокХранения, РезультатОчистки, Длительность)
	
	ДанныеСобытия = Новый Структура;
	ДанныеСобытия.Вставить("СрокХранения", СрокХранения);
	ДанныеСобытия.Вставить("УдаленоЗаписей", РезультатОчистки.УдаленоЗаписей);
	ДанныеСобытия.Вставить("ДлительностьМс", Длительность);
	
	ЗаписьЖурналаРегистрации(
		СобытиеОчиститьИсториюФиниш(),
		УровеньЖурналаРегистрации.Информация, , ,
		ЗначениеВJSON(ДанныеСобытия));
	
КонецПроцедуры

Функция СобытиеОчиститьИсториюСтарт()
	Возврат СтрШаблон("%1ОчиститьИсторию.Старт", НаименованиеБиблиотеки());
КонецФункции

#КонецОбласти

#Область КонвертацияДанных

// Распаковывае файл формата gzip и возвращает его данные.
// 
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - Исходные двоичные данные gzip формата
// 
// Возвращаемое значение:
//  ДвоичныеДанные
//
Функция РаспаковатьФайлGZip(ДвоичныеДанные) Экспорт
	
	РазмерПрефикса = 10;
	РазмерПостфикса = 8;
	РазмерLHF = 34;
	РазмерDD = 16;
	РазмерCDH = 50;
	РазмерEOCD = 22;
	
	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные);
	ЧтениеДанных.Пропустить(РазмерПрефикса);
	РазмерДанных = ЧтениеДанных.ИсходныйПоток().Размер();
	
	СжатыйРазмер = РазмерДанных - РазмерПрефикса - РазмерПостфикса;
	НачальнаяЕмкость = РазмерLHF + СжатыйРазмер + РазмерDD + РазмерCDH + РазмерEOCD;
	ПотокВПамяти = Новый ПотокВПамяти(НачальнаяЕмкость);
	
	БуферLHF = Новый БуферДвоичныхДанных(РазмерLHF);
	БуферLHF.ЗаписатьЦелое32(0, 67324752);	// signature 0x04034b50
	БуферLHF.ЗаписатьЦелое16(4, 20);		// version
	БуферLHF.ЗаписатьЦелое16(6, 10);		// bit flags
	БуферLHF.ЗаписатьЦелое16(8, 8);			// compression method
	БуферLHF.ЗаписатьЦелое16(10, 0);		// time
	БуферLHF.ЗаписатьЦелое16(12, 0);		// date
	БуферLHF.ЗаписатьЦелое32(14, 0);		// crc-32
	БуферLHF.ЗаписатьЦелое32(18, 0);		// compressed size
	БуферLHF.ЗаписатьЦелое32(22, 0);		// uncompressed size
	БуферLHF.ЗаписатьЦелое16(26, 4);		// filename length - "data"
	БуферLHF.ЗаписатьЦелое16(28, 0);		// extra field length
	
	КодировкаТекстаСтроки = "ascii";
	ЗаписатьBOM = Ложь;
	БуферASCII = ПолучитьБуферДвоичныхДанныхИзСтроки("data", КодировкаТекстаСтроки, ЗаписатьBOM);
	БуферLHF.Записать(30, БуферASCII);
	
	ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти);
	ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(БуферLHF);
	ЧтениеДанных.КопироватьВ(ЗаписьДанных, СжатыйРазмер);
	ЗаписьДанных.Close();
	
	ДанныеCRC32 = ЧтениеДанных.ПрочитатьЦелое32();
	НесжатыйРазмер = ЧтениеДанных.ПрочитатьЦелое32();
	ЧтениеДанных.Закрыть();
	
	БуферDD = Новый БуферДвоичныхДанных(РазмерDD);
	БуферDD.ЗаписатьЦелое32(0, 134695760);
	БуферDD.ЗаписатьЦелое32(4, ДанныеCRC32);
	БуферDD.ЗаписатьЦелое32(8, СжатыйРазмер);
	БуферDD.ЗаписатьЦелое32(12, НесжатыйРазмер);
	
	БуферCDH = Новый БуферДвоичныхДанных(РазмерCDH);
	БуферCDH.ЗаписатьЦелое32(0, 33639248);			// signature 0x02014b50
	БуферCDH.ЗаписатьЦелое16(4, 798);				// version made by
	БуферCDH.ЗаписатьЦелое16(6, 20);				// version needed to extract
	БуферCDH.ЗаписатьЦелое16(8, 10);				// bit flags
	БуферCDH.ЗаписатьЦелое16(10, 8);				// compression method
	БуферCDH.ЗаписатьЦелое16(12, 0);				// time
	БуферCDH.ЗаписатьЦелое16(14, 0);				// date
	БуферCDH.ЗаписатьЦелое32(16, ДанныеCRC32);		// crc-32
	БуферCDH.ЗаписатьЦелое32(20, СжатыйРазмер);		// compressed size
	БуферCDH.ЗаписатьЦелое32(24, НесжатыйРазмер);	// uncompressed size
	БуферCDH.ЗаписатьЦелое16(28, 4);				// file name length
	БуферCDH.ЗаписатьЦелое16(30, 0);  				// extra field length
	БуферCDH.ЗаписатьЦелое16(32, 0);				// file comment length
	БуферCDH.ЗаписатьЦелое16(34, 0);				// disk number start
	БуферCDH.ЗаписатьЦелое16(36, 0);				// internal file attributes
	БуферCDH.ЗаписатьЦелое32(38, 2176057344);		// external file attributes
	БуферCDH.ЗаписатьЦелое32(42, 0);				// relative offset of local header
	БуферCDH.Записать(46, БуферASCII);
	
	БуферEOCD = Новый БуферДвоичныхДанных(РазмерEOCD);
	БуферEOCD.ЗаписатьЦелое32(0, 101010256);		// signature 0x06054b50
	БуферEOCD.ЗаписатьЦелое16(4, 0);				// number of this disk
	БуферEOCD.ЗаписатьЦелое16(6, 0);				// number of the disk with the start of the central directory
	БуферEOCD.ЗаписатьЦелое16(8, 1);				// total number of entries in the central directory on this disk
	БуферEOCD.ЗаписатьЦелое16(10, 1);				// total number of entries in the central directory
	БуферEOCD.ЗаписатьЦелое32(12, РазмерCDH);		// size of the central directory
										// offset of start of central directory with respect to the starting disk number
	БуферEOCD.ЗаписатьЦелое32(16, РазмерLHF + СжатыйРазмер + РазмерDD); 
	БуферEOCD.ЗаписатьЦелое16(20, 0);				// the starting disk number
	
	ЗаписьДанных = Новый ЗаписьДанных(ПотокВПамяти);
	ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(БуферDD);
	ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(БуферCDH);
	ЗаписьДанных.ЗаписатьБуферДвоичныхДанных(БуферEOCD);
	ЗаписьДанных.Close();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ЧтениеZipФайла = Новый ЧтениеZipФайла(ПотокВПамяти);
	Элемент = ЧтениеZipФайла.Элементы.Получить(0);
	ЧтениеZipФайла.Извлечь(Элемент, ИмяВременногоФайла, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
	ЧтениеZipФайла.Закрыть();
	
	РазделительПути = ПолучитьРазделительПути();
	ПутьКФайлу = СтрШаблон("%1%2%3", ИмяВременногоФайла, РазделительПути, Элемент.Имя);
	Результат = Новый ДвоичныеДанные(ПутьКФайлу);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Результат;
	
КонецФункции

// Возвращает тело HTTP-объекта как двоичные данные или пустую строку, если тело отсутствует.
//
// Параметры:
//  ИсточникТела - HTTPЗапрос, HTTPОтвет, HTTPСервисОтвет, HTTPСервисЗапрос, ДвоичныеДанные, Строка, Неопределено
//
// Возвращаемое значение:
//  ДвоичныеДанные, Строка - пустая строка при отсутствии тела
//
Функция ТелоHTTPКакДвоичныеДанные(ИсточникТела) Экспорт
	
	Если ИсточникТела = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТипИсточника = ТипЗнч(ИсточникТела);
	
	Если ТипИсточника = Тип("ДвоичныеДанные") Тогда
		Если ИсточникТела.Размер() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат ИсточникТела;
	КонецЕсли;
	
	Если ТипИсточника = Тип("Строка") Тогда
		Возврат ИсточникТела;
	КонецЕсли;
	
	ДвоичныеДанные = Неопределено;
	
	Если ТипИсточника = Тип("HTTPЗапрос")
		Или ТипИсточника = Тип("HTTPОтвет")
		Или ТипИсточника = Тип("HTTPСервисОтвет")
		Или ТипИсточника = Тип("HTTPСервисЗапрос") Тогда
		
		ДвоичныеДанные = ИсточникТела.ПолучитьТелоКакДвоичныеДанные();
		
	Иначе
		Возврат "";
	КонецЕсли;
	
	Если ДвоичныеДанные = Неопределено Или ДвоичныеДанные.Размер() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ДвоичныеДанные;
	
КонецФункции

// Извлекает тело HTTP-ответа с учётом gzip и сохранения в файл.
// Всегда через двоичные данные (как до рефакторинга #19): ветка ПолучитьТелоКакСтроку
// по Content-Type=text давала пустой результат на части ответов.
//
// Параметры:
//  HTTPОтвет - HTTPОтвет
//  ИмяВыходногоФайла - Строка
//
// Возвращаемое значение:
//  ДвоичныеДанные, Строка
//
Функция ТелоHTTPОтвета(HTTPОтвет, Знач ИмяВыходногоФайла = "") Экспорт
	
	Если HTTPОтвет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяВыходногоФайла) Тогда
		
		ФайлОтвета = Новый Файл(ИмяВыходногоФайла);
		Если ФайлОтвета.Существует() Тогда
			Возврат Новый ДвоичныеДанные(ИмяВыходногоФайла);
		КонецЕсли;
		
		Возврат "";
	КонецЕсли;
	
	ЗаголовокШифрованияGzip = HTTPОтвет.Заголовки.Получить("content-encoding");
	Если Не ЗначениеЗаполнено(ЗаголовокШифрованияGzip) Тогда
		ЗаголовокШифрованияGzip = HTTPОтвет.Заголовки.Получить("Content-Encoding");
	КонецЕсли;
	
	Если НРег(Строка(ЗаголовокШифрованияGzip)) = "gzip" Тогда
		
		ДвоичныеДанныеGzip = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
		Если ДвоичныеДанныеGzip = Неопределено Или ДвоичныеДанныеGzip.Размер() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат РаспаковатьФайлGZip(ДвоичныеДанныеGzip);
		
	КонецЕсли;
	
	Возврат ТелоHTTPКакДвоичныеДанные(HTTPОтвет);
	
КонецФункции

// Один раз снимает тело ответа в ЛогЗапроса.Содержание.ТелоОтвета.
// Нужен до записи в ЖР/РС: повторное чтение HTTPОтвет часто даёт пустое тело.
//
// Параметры:
//  ЛогЗапроса - Структура - см. РегистрыСведений.ЛогиТрафика.НовыйЛог
//  ИмяВыходногоФайла - Строка
//
Процедура ОбеспечитьТелоОтветаВЛоге(ЛогЗапроса, Знач ИмяВыходногоФайла = "") Экспорт
	
	Если ТипЗнч(ЛогЗапроса) <> Тип("Структура")
		Или Не ЛогЗапроса.Свойство("Содержание")
		Или ТипЗнч(ЛогЗапроса.Содержание) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТелоЛогаЗаполнено(ЛогЗапроса.Содержание.ТелоОтвета) Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = ЗагрузитьНастройкиЛогирования();
	Если Не Настройки.ЗаписыватьВЖРТело И Не Настройки.ЗаписыватьВРСТело Тогда
		Возврат;
	КонецЕсли;
	
	HTTPОтвет = Неопределено;
	Если Не ЛогЗапроса.Свойство("HTTPОтвет", HTTPОтвет) Или HTTPОтвет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТелоОтвета = ТелоHTTPОтвета(HTTPОтвет, ИмяВыходногоФайла);
	Если ТелоЛогаЗаполнено(ТелоОтвета) Тогда
		ЛогЗапроса.Содержание.ТелоОтвета = ТелоОтвета;
	КонецЕсли;
	
КонецПроцедуры

// Признак, что тело лога уже извлечено и его можно писать без повторного чтения HTTPОтвет.
//
// Параметры:
//  Тело - ДвоичныеДанные, Строка, Неопределено
//
// Возвращаемое значение:
//  Булево
//
Функция ТелоЛогаЗаполнено(Тело)
	
	Если Тело = Неопределено Или Тело = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("Строка") Тогда
		Возврат Не ПустаяСтрока(Тело);
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		Возврат Тело.Размер() > 0;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Преобразует тело лога к строке для JSON (ЖР).
//
// Параметры:
//  Тело - ДвоичныеДанные, Строка, Неопределено
//
// Возвращаемое значение:
//  Строка
//
Функция ТелоЛогаКакСтрока(Тело) Экспорт
	
	Если Тело = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("Строка") Тогда
		Возврат Тело;
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		Если Тело.Размер() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Тело);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Преобразует тело лога к двоичным данным для РС.
//
// Параметры:
//  Тело - ДвоичныеДанные, Строка, Неопределено
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено
//
Функция ТелоЛогаКакДвоичныеДанные(Тело) Экспорт
	
	Если Тело = Неопределено Или Тело = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("ДвоичныеДанные") Тогда
		Если Тело.Размер() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Тело;
	КонецЕсли;
	
	Если ТипЗнч(Тело) = Тип("Строка") Тогда
		Если ПустаяСтрока(Тело) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПолучитьДвоичныеДанныеИзСтроки(Тело);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СоответствиеВТаблицуЗначений(Соответствие, КолонкаКлюча, КолонкаЗначения) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить(КолонкаКлюча);
	Таблица.Колонки.Добавить(КолонкаЗначения);
	
	Если Соответствие = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Для каждого ЭлементКоллекции Из Соответствие Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока[КолонкаКлюча] = ЭлементКоллекции.Ключ;
		НоваяСтрока[КолонкаЗначения] = ЭлементКоллекции.Значение;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Получение данных из строки в формате JSON.
// 
// Параметры:
// 	СтрокаКонвертации - Строка - строка JSON
// 	ПрочитатьВСоответствие - Булево
// 	СвойстваСДатой - Строка - именя свойстсв с датой через запятую.
// 	
// Возвращаемое значение:
// 	Произвольный
//
Функция ЗначениеИзСтрокиJSON(Знач СтрокаКонвертации, ПрочитатьВСоответствие = Ложь, СвойстваСДатой = "") Экспорт
	
	Если ТипЗнч(СтрокаКонвертации) <> Тип("Строка")
		Или ПустаяСтрока(СтрокаКонвертации)
		Или Лев(СтрокаКонвертации, 1) = "<" Тогда
		Возврат СтрокаКонвертации;
	КонецЕсли;
	
	// Массив имен реквизитов для восстановления.
	РеквизитыДляВосстановления = Новый Массив; // Массив из Строка
	РеквизитыДляВосстановления.Добавить("ЗаголовкиЗапроса");
	РеквизитыДляВосстановления.Добавить("ЗаголовкиОтвета");
	
	Результат = СтрокаКонвертации;
	ЧтениеJSON = Новый ЧтениеJSON;
	Попытка
		
		ЧтениеJSON.УстановитьСтроку(СтрокаКонвертации);
		
		Результат = ПрочитатьJSON(
			ЧтениеJSON, 
			ПрочитатьВСоответствие, 
			СвойстваСДатой, , 
			"ФункцияВосстановленияЧтения", 
			ЛогированиеТрафика, , 
			РеквизитыДляВосстановления);
		
		ЧтениеJSON.Закрыть();
		
	Исключение
		
		ИмяСобытия = СтрШаблон("%1ЗначениеИзСтрокиJSON", НаименованиеБиблиотеки());
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия, 
			УровеньЖурналаРегистрации.Ошибка, , , 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
//		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Функция восстановления чтения.
// 
// Параметры:
//  Свойство - Строка
//  Значение - Строка
//  ДополнительныеПараметры - Структура
// 
// Возвращаемое значение:
//  Произвольный
//
Функция ФункцияВосстановленияЧтения(Свойство, Значение, ДополнительныеПараметры) Экспорт
	
	Если Свойство = "ЗаголовкиЗапроса" Или Свойство = "ЗаголовкиОтвета" Тогда
		Значение = ЗначениеИзСтрокиJSON(Значение, Истина);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

// Значение ВJSON.
// 
// Параметры:
//  Данные - Произвольный
// 
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВJSON(Знач Данные) Экспорт
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Значение = ЗаписьJSON.Закрыть();
	
	Возврат Значение;
	
КонецФункции

