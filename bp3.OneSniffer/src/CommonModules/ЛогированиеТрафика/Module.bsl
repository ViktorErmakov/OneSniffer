// Значение элемента коллекции ключ-значение по имени ключа.
//
// Параметры:
//  Коллекция - Структура, ФиксированнаяСтруктура, Соответствие из КлючИЗначение, Произвольный - коллекция для поиска:
//   * Ключ - Строка - имя ключа
//   * Значение - Произвольный - значение элемента
//  ИмяКлюча - Строка - искомый ключ
//  Значение - Произвольный - Возвращаемое значение: найденное значение элемента
//
// Возвращаемое значение:
//  Булево - Истина, если ключ найден
//
Функция ЗначениеПоКлючуВКоллекции(Коллекция, ИмяКлюча, Значение)
	
	Значение = Неопределено;
	ИскомыйКлюч = Строка(ИмяКлюча);
	
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		Если ЭлементКоллекции.Ключ = ИскомыйКлюч Тогда
			Значение = ЭлементКоллекции.Значение;
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Значение HTTP-заголовка без учета регистра его имени.
//
// Параметры:
//  Заголовки - Соответствие из КлючИЗначение - заголовки HTTP:
//   * Ключ - Строка - имя заголовка
//   * Значение - Строка - значение заголовка
//  ИмяКаноническое - Строка - каноническое имя заголовка, например "Content-Type"
//
// Возвращаемое значение:
//  Строка - пустая строка, если заголовок не найден
//
Функция ЗначениеЗаголовкаИгнорРегистра(Заголовки, ИмяКаноническое)
	
	Если ТипЗнч(Заголовки) <> Тип("Соответствие")
		И ТипЗнч(Заголовки) <> Тип("ФиксированноеСоответствие") Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяВНижнемРегистре = НРег(ИмяКаноническое);
	Для Каждого ЭлементЗаголовка Из Заголовки Цикл
		Если НРег(Строка(ЭлементЗаголовка.Ключ)) = ИмяВНижнемРегистре Тогда
			Возврат Строка(ЭлементЗаголовка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

