// Серверные методы Monaco Editor для OneSniffer (без ВызовСервера).

#Область ПрограммныйИнтерфейс

// Готовит ZIP-макет Monaco на форме: BinaryData во ВХ → реквизит АдресМакетаРедактора.
// Вызывать из ПриСозданииНаСервере форм с редактором.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//
Процедура ПодготовитьМакетРедактораНаФорме(Форма) Экспорт
	
	Если ПустаяСтрока(Форма.АдресМакетаРедактора) Тогда
		Форма.АдресМакетаРедактора = OneSniffer_РедакторКодаВызовСервера.АдресМакетаРедактора(
			Форма.УникальныйИдентификатор);
	КонецЕсли;
	
	Попытка
		АдресSingle = Форма.АдресМакетаРедактораSingle;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ПустаяСтрока(АдресSingle) Тогда
		Форма.АдресМакетаРедактораSingle = OneSniffer_РедакторКодаВызовСервера.АдресМакетаРедактораSingle(
			Форма.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
