// Серверные методы Monaco Editor для OneSniffer (без ВызовСервера).

#Область ПрограммныйИнтерфейс

// Загружает HTML-приложение в реквизит формы для поля HTML-документа.
// Веб-клиент: HTML-строка; тонкий / толстый клиент: навигационная ссылка ИБ и временное хранилище.
//
// Параметры:
//  ДвоичныеДанные - ДвоичныеДанные - страница приложения
//  Результат - Строка - значение реквизита формы
//  УникальныйИдентификатор - УникальныйИдентификатор - уникальный идентификатор формы
//
Процедура ЗагрузитьПриложение(ДвоичныеДанные, Результат, УникальныйИдентификатор) Экспорт
	
	// Решение проекта (совместимость расширения 8.3.16): веб определяем через БСП,
	// а не через КлиентскоеПриложение.ТипПриложения() как в Kanban (нужен 8.3.21+).
	Если ОбщегоНазначения.ЭтоВебКлиент() Тогда
		
		Результат = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанные);
		
	Иначе
		
		АдресВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		Результат = СтрШаблон(
			"%1/%2",
			ПолучитьНавигационнуюСсылкуИнформационнойБазы(),
			АдресВХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

// Готовит редакторы Monaco на форме: страница попадает прямо в реквизиты полей HTML.
// Вызывать из ПриСозданииНаСервере форм с редактором.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ИменаПолейHTML - Массив из Строка - имена реквизитов полей HTML-документа
//
Процедура ПодготовитьРедакторыНаФорме(Форма, ИменаПолейHTML) Экспорт
	
	ДвоичныеДанные = ПолучитьОбщийМакет("OneSniffer_MonacoEditorSingle");
	
	Для Каждого ИмяПоля Из ИменаПолейHTML Цикл
		ЗначениеПоля = "";
		ЗагрузитьПриложение(ДвоичныеДанные, ЗначениеПоля, Форма.УникальныйИдентификатор);
		Форма[ИмяПоля] = ЗначениеПоля;
	КонецЦикла;
	
КонецПроцедуры

// Сериализует значение в строку JSON.
//
// Параметры:
//  Значение - Структура, Массив, Соответствие
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВСтрокуJSON(Значение) Экспорт
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти
