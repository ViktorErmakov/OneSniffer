#Область ПрограммныйИнтерфейс

// Конструктор структуры лога входящего HTTP-запроса (без записи в РС/ЖР).
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//  ИмяСобытия - Строка - необязательное имя для группировки в списке логов
//
// Возвращаемое значение:
//  Структура - см. РегистрыСведений.ЛогиТрафика.НовыйЛогЗапроса; Входящий = Истина
//
Функция НовыйЛогВходящегоЗапроса(Знач Запрос, ИмяСобытия = "") Экспорт
	
	Возврат РегистрыСведений.ЛогиТрафика.НовыйЛогВходящегоЗапроса(Запрос, ИмяСобытия);
	
КонецФункции

// Записывает лог входящего HTTP-запроса в РС и/или ЖР по настройкам (аналог завершения _ВызватьHTTPМетод).
//
// Параметры:
//  ЛогЗапроса - см. НовыйЛогВходящегоЗапроса
//  Ответ - HTTPСервисОтвет - при успешной обработке; при исключении не передаётся
//  ИнформацияОбОшибке - ИнформацияОбОшибке - при исключении в обработчике; иначе не передаётся
//
Процедура ЗаписатьВходящийЛог(Знач ЛогЗапроса, Знач Ответ = Неопределено, ИнформацияОбОшибке = Неопределено) Экспорт
	
	НастройкиЛогирования = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	Если Не НастройкиЛогирования.ВключеноЛогирование Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоИсключение = (ИнформацияОбОшибке <> Неопределено);
	Если Не ЭтоИсключение И Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДляЗаписи = ЛогированиеТрафика.ДанныеДляЗаписиИсключения(ЛогЗапроса);
	ТекстОшибки = "";
	
	Если ЭтоИсключение Тогда
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		Если ЛогированиеТрафика.ЗаписыватьТелоВРС() Тогда
			ЛогЗапроса.Содержание.ТелоОтвета = ТекстОшибки;
		КонецЕсли;
		ЛогЗапроса.КодОтвета = 0;
		
		ЗаписьЖурналаРегистрации(
			ЛогированиеТрафика.СобытиеОбработатьHTTPСервис(),
			УровеньЖурналаРегистрации.Ошибка,,
			ДанныеДляЗаписи,
			ТекстОшибки);
		
		Если Не ТранзакцияАктивна()
			И НастройкиЛогирования.ЗаписыватьВРС Тогда
			РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса, , ТекстОшибки);
		КонецЕсли;
		
	Иначе
		
		ЛогЗапроса.КодОтвета = Ответ.КодСостояния;
		ЛогЗапроса.Содержание.ЗаголовкиОтвета = Ответ.Заголовки;
		Если ЛогированиеТрафика.ЗаписыватьТелоВРС() Или ЛогированиеТрафика.ЗаписыватьТелоВЖР() Тогда
			ЛогЗапроса.Содержание.ТелоОтвета = Ответ.ПолучитьТелоКакДвоичныеДанные();
		КонецЕсли;
		
		Если НастройкиЛогирования.ЗаписыватьВЖР Тогда
			
			КомментарийЖурнала = ЛогированиеТрафика.КомментарийЗаписиЖурналаHTTP(ЛогЗапроса);
			ЗаписьЖурналаРегистрации(
				ЛогированиеТрафика.СобытиеОбработатьHTTPСервис(),
				УровеньЖурналаРегистрации.Информация,,
				ДанныеДляЗаписи,
				КомментарийЖурнала);
			
		КонецЕсли;
		
		Если НастройкиЛогирования.ЗаписыватьВРС Тогда
			РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
