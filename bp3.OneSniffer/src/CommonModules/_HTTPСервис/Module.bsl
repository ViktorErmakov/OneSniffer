// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Записывает лог входящего HTTP-запроса в РС и/или ЖР по настройкам.
// Вызывается один раз в конце обработки — при успехе с Ответ, при ошибке с ИнформацияОбОшибке.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//  ИмяСобытия - Строка - необязательное имя для группировки в списке логов
//  Ответ - HTTPСервисОтвет - при успешной обработке; при исключении не передаётся
//  ИнформацияОбОшибке - ИнформацияОбОшибке - при исключении в обработчике; иначе не передаётся
//  ВремяНачалаЗамера - Число - необязательно; миллисекунды универсального времени (см. ТекущаяУниверсальнаяДатаВМиллисекундах).
//      Если не передано — длительность в логе будет 0; если передано — время обработки от этой отметки до записи лога, с.
//
Процедура ЗаписатьВходящийЛог(
	Знач Запрос,
	Знач ИмяСобытия,
	Знач Ответ = Неопределено,
	ИнформацияОбОшибке = Неопределено,
	ВремяНачалаЗамера = Неопределено) Экспорт
	
	НастройкиЛогирования = ЛогированиеТрафика.ЭффективныеНастройкиЛогирования();
	Если Не НастройкиЛогирования.ВключеноЛогирование Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоИсключение = (ИнформацияОбОшибке <> Неопределено);
	
	Параметры = Новый Структура;
	Параметры.Вставить("HTTPСервисЗапрос", Запрос);
	Параметры.Вставить("ИмяСобытия", ИмяСобытия);
	
	ЛогЗапроса = РегистрыСведений.ЛогиТрафика.НовыйЛог(
		Перечисления.НаправлениеHTTPЛога.Входящий,
		Перечисления.НазначениеЛога.Рабочий,
		Параметры);
	
	Если ЗначениеЗаполнено(ВремяНачалаЗамера) Тогда
		ЛогЗапроса.Вставить("ВремяНачалаЗамера", ВремяНачалаЗамера);
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Если ЭтоИсключение Тогда
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЛогЗапроса.КодОтвета = 0;
		Если НастройкиЛогирования.ЗаписыватьВРСТело Тогда
			ЛогЗапроса.Содержание.ТелоОтвета = ТекстОшибки;
		КонецЕсли;
		
		ДанныеДляЗаписи = ЛогированиеТрафика.ДанныеДляЗаписиВЖурналРегистрации(ЛогЗапроса);
		
		ЗаписьЖурналаРегистрации(
			ЛогированиеТрафика.СобытиеОбработатьHTTPСервис(),
			УровеньЖурналаРегистрации.Ошибка,,
			ДанныеДляЗаписи,
			ТекстОшибки);
		
		Если Не ТранзакцияАктивна()
			И НастройкиЛогирования.ЗаписыватьВРС Тогда
			РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса, , ТекстОшибки);
		КонецЕсли;
		
	Иначе
		
		ЛогЗапроса.КодОтвета = Ответ.КодСостояния;
		ЛогЗапроса.Содержание.ЗаголовкиОтвета = Ответ.Заголовки;
		Если НастройкиЛогирования.ЗаписыватьВРСТело Или НастройкиЛогирования.ЗаписыватьВЖРТело Тогда
			ЛогЗапроса.Содержание.ТелоОтвета = ЛогированиеТрафика.ТелоHTTPКакДвоичныеДанные(Ответ);
		КонецЕсли;
		
		Если НастройкиЛогирования.ЗаписыватьВЖР Тогда
			
			ДанныеДляЗаписи = ЛогированиеТрафика.ДанныеДляЗаписиВЖурналРегистрации(ЛогЗапроса);
			КомментарийЖурнала = ЛогированиеТрафика.КомментарийЗаписиЖурналаHTTP(ЛогЗапроса);
			ЗаписьЖурналаРегистрации(
				ЛогированиеТрафика.СобытиеОбработатьHTTPСервис(),
				УровеньЖурналаРегистрации.Информация,,
				ДанныеДляЗаписи,
				КомментарийЖурнала);
			
		КонецЕсли;
		
		Если НастройкиЛогирования.ЗаписыватьВРС Тогда
			РегистрыСведений.ЛогиТрафика.ЗаписатьЛог(ЛогЗапроса);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
