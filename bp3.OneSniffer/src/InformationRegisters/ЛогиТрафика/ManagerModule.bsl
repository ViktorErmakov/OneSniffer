#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Конструктор пустой структуры лога по шаблону менеджера записи РС ЛогиТрафика.
//
// Возвращаемое значение:
//  Структура:
// * НомерСеанса - Число
// * ВремяНачала - Число
// * Дата - Дата
// * Сервер - Строка
// * Метод - ПеречислениеСсылка.МетодHTTP
// * Адрес - Строка
// * Входящий - Булево
// * Длительность - Число
// * Клиент - Строка
// * КодОтвета - Число
// * Пользователь - Строка
// * Порт - Число
// * РазмерОтвета - Число
// * Событие - Строка
// * Содержание - см. НовыйСодержание
// * ЭтоЗащищенноеСоединение - Булево
// * Разделитель - Булево
//
Функция НовыйСтруктураМенеджераЗаписи() Экспорт
	
	// Подготовим данные для записи возможного исключения.
	СтруктураЗаписи = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(
		СоздатьМенеджерЗаписи(), 
		Метаданные.РегистрыСведений.ЛогиТрафика);
	
	//@skip-warning
	Возврат СтруктураЗаписи;
	
КонецФункции

// Единый конструктор лога HTTP-запроса.
//
// Параметры:
//  Направление - ПеречислениеСсылка.НаправлениеHTTPЛога
//  Назначение - ПеречислениеСсылка.НазначениеЛога
//  Параметры - Структура:
// * HTTPСервисЗапрос - HTTPСервисЗапрос - для входящего
// * Соединение - HTTPСоединение - для исходящего
// * HTTPЗапрос - HTTPЗапрос - для исходящего
// * ИмяМетода - Строка - для исходящего
// * ИмяСобытия - Строка
//
// Возвращаемое значение:
//  Структура - рабочий лог
//
Функция НовыйЛог(Направление, Назначение, Параметры) Экспорт
	
	ЛогЗапроса = НовыйСтруктураМенеджераЗаписи();
	ИмяСобытия = "";
	Если Параметры.Свойство("ИмяСобытия") Тогда
		ИмяСобытия = Параметры.ИмяСобытия;
	КонецЕсли;
	
	ЛогЗапроса.Событие = ИмяСобытия;
	ЛогЗапроса.Дата = ТекущаяДатаСеанса();
	ЛогЗапроса.ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	ЛогЗапроса.Пользователь = Пользователи.ТекущийПользователь().ПолноеНаименование();
	ЛогЗапроса.НомерСеанса = НомерСеансаИнформационнойБазы();
	ЛогЗапроса.Вставить("HTTPОтвет", Неопределено);
	
	Если Направление = Перечисления.НаправлениеHTTPЛога.Входящий Тогда
		ЗаполнитьВходящийЛог(ЛогЗапроса, Назначение, Параметры);
	Иначе
		ЗаполнитьИсходящийЛог(ЛогЗапроса, Назначение, Параметры);
	КонецЕсли;
	
	Возврат ЛогЗапроса;
	
КонецФункции

// Конструктор содержания лога с учётом направления и назначения.
//
// Параметры:
//  Направление - ПеречислениеСсылка.НаправлениеHTTPЛога
//  Назначение - ПеречислениеСсылка.НазначениеЛога
//
// Возвращаемое значение:
//  Структура
//
Функция НовыйСодержание(Направление, Назначение) Экспорт
	
	ПустоеТело = ПустоеТелоСодержания(Назначение);
	ПустыеЗаголовки = Новый Соответствие;
	
	Содержание = Новый Структура;
	Содержание.Вставить("ЗаголовкиЗапроса", ПустыеЗаголовки);
	Содержание.Вставить("ТелоЗапроса", ПустоеТело);
	Содержание.Вставить("ЗаголовкиОтвета", ПустыеЗаголовки);
	Содержание.Вставить("ТелоОтвета", ПустоеТело);
	
	Возврат Содержание;
	
КонецФункции

// Приводит содержание лога к целевому назначению хранения.
//
// Параметры:
//  Содержание - Структура, Неопределено
//  Назначение - ПеречислениеСсылка.НазначениеЛога
//  Входящий - Булево
//
// Возвращаемое значение:
//  Структура
//
Функция ПодготовитьСодержание(Содержание, Назначение, Входящий = Ложь) Экспорт
	
	Направление = ?(Входящий,
		Перечисления.НаправлениеHTTPЛога.Входящий,
		Перечисления.НаправлениеHTTPЛога.Исходящий);
	Результат = НовыйСодержание(Направление, Назначение);
	
	Если ТипЗнч(Содержание) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, Содержание);
	КонецЕсли;
	
	Результат.ЗаголовкиЗапроса = ЗаголовкиСодержанияКСоответствию(Результат.ЗаголовкиЗапроса);
	Результат.ЗаголовкиОтвета = ЗаголовкиСодержанияКСоответствию(Результат.ЗаголовкиОтвета);
	
	Если Назначение = Перечисления.НазначениеЛога.Журнал Тогда
		
		Если ЛогированиеТрафика.ЗаписыватьТелоВЖР() Тогда
			Результат.ТелоЗапроса = ЛогированиеТрафика.ТелоЛогаКакСтрока(Результат.ТелоЗапроса);
			Результат.ТелоОтвета = ЛогированиеТрафика.ТелоЛогаКакСтрока(Результат.ТелоОтвета);
		Иначе
			Результат.ТелоЗапроса = "";
			Результат.ТелоОтвета = "";
		КонецЕсли;
		
	ИначеЕсли Назначение = Перечисления.НазначениеЛога.Регистр Тогда
		
		Если ЛогированиеТрафика.ЗаписыватьТелоВРС() Тогда
			Результат.ТелоЗапроса = ЛогированиеТрафика.ТелоЛогаКакДвоичныеДанные(Результат.ТелоЗапроса);
			Результат.ТелоОтвета = ЛогированиеТрафика.ТелоЛогаКакДвоичныеДанные(Результат.ТелоОтвета);
		Иначе
			Результат.ТелоЗапроса = Неопределено;
			Результат.ТелоОтвета = Неопределено;
		КонецЕсли;
		
	Иначе
		
		Результат.ТелоЗапроса = ЛогированиеТрафика.ТелоHTTPКакДвоичныеДанные(Результат.ТелоЗапроса);
		Результат.ТелоОтвета = ЛогированиеТрафика.ТелоHTTPКакДвоичныеДанные(Результат.ТелоОтвета);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Записать лог.
// 
// Параметры:
//  ЛогЗапроса - см. НовыйЛог
//  ИмяВыходногоФайла - Строка -  Имя выходного файла
//  ТекстОшибки - Строка -  Текст ошибки
//
Процедура ЗаписатьЛог(ЛогЗапроса, Знач ИмяВыходногоФайла = "", Знач ТекстОшибки = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		
		ЛогДляЗаписи = ОбщегоНазначения.СкопироватьРекурсивно(ЛогЗапроса);
		
		HTTPОтвет = Неопределено;
		ЛогЗапроса.Свойство("HTTPОтвет", HTTPОтвет);
		
		Если HTTPОтвет <> Неопределено И Не ПустаяСтрока(ИмяВыходногоФайла) Тогда
			ЛогДляЗаписи.КодОтвета = HTTPОтвет.КодСостояния;
			ЛогДляЗаписи.Содержание.ЗаголовкиОтвета = HTTPОтвет.Заголовки;
			ЛогДляЗаписи.Содержание.ТелоОтвета = ЛогированиеТрафика.ТелоHTTPОтвета(HTTPОтвет, ИмяВыходногоФайла);
			Если ЛогДляЗаписи.Свойство("HTTPОтвет") Тогда
				ЛогДляЗаписи.Удалить("HTTPОтвет");
			КонецЕсли;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ЛогДляЗаписи.Содержание.ТелоОтвета = ТекстОшибки;
		КонецЕсли;
		
		ПодготовленныйЛог = ЛогированиеТрафика.ПодготовитьЛог(
			ЛогДляЗаписи,
			Перечисления.НазначениеЛога.Регистр);
		
		Запись = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ПодготовленныйЛог, , "Содержание");
		
		Запись.Содержание = Новый ХранилищеЗначения(ПодготовленныйЛог.Содержание, Новый СжатиеДанных(5));
		
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаВМоделиСервиса") 
			И Метаданные.ОбщиеМодули.Найти("РаботаВМоделиСервиса") <> Неопределено Тогда
			
			МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
			Запись.Разделитель = МодульРаботаВМоделиСервиса.ЗначениеРазделителяСеанса();
			
		КонецЕсли;
		
		Запись.Записать(Истина);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ШаблонОшибки = НСтр("ru = 'Метод: %2.%1%3%1%4'");
		ТекстОшибкиИсключения = СтрШаблон(
			ШаблонОшибки, 
			Символы.ПС, 
			ЛогЗапроса.Событие, 
			ПолучитьСтрокуURLЗапроса(ЛогЗапроса), 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ШаблонСобытия = НСтр("ru = '%1Запись лога.'");
		ИмяСобытия = СтрШаблон(ШаблонСобытия, ЛогированиеТрафика.НаименованиеБиблиотеки());
		ЗаписьЖурналаРегистрации(
			ИмяСобытия, 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ЛогиТрафика, , ТекстОшибкиИсключения);
		
		УстановитьПривилегированныйРежим(Ложь);
		
	КонецПопытки;
	
//	ЗаписатьЛогЗапросаВФайл(ЛогЗапроса, ТекстОшибки);
	
КонецПроцедуры

// Очистить историю.
// 
// Параметры:
//  СрокХранения - Число - количество дней.
//
Процедура ОчиститьИсторию(СрокХранения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛогиТрафика.НомерСеанса КАК НомерСеанса,
	|	ЛогиТрафика.Дата КАК Дата,
	|	ЛогиТрафика.Сервер КАК Сервер,
	|	ЛогиТрафика.ВремяНачала КАК ВремяНачала
	|ИЗ
	|	РегистрСведений.ЛогиТрафика КАК ЛогиТрафика
	|ГДЕ
	|	ЛогиТрафика.Дата < &СрокХранения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Запрос.УстановитьПараметр("СрокХранения", ТекущаяДатаСеанса() - СрокХранения * 24*60*60);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЛогиТрафика");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("НомерСеанса", "НомерСеанса");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ВремяНачала", "ВремяНачала");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Дата", "Дата");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Сервер", "Сервер");
		Блокировка.Заблокировать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НомерСеанса.Установить(Выборка.НомерСеанса);
			НаборЗаписей.Отбор.ВремяНачала.Установить(Выборка.ВремяНачала);
			НаборЗаписей.Отбор.Дата.Установить(Выборка.Дата);
			НаборЗаписей.Отбор.Сервер.Установить(Выборка.Сервер);
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИмяСобытия = СтрШаблон(
			НСтр("ru = '%1.Очистить историю'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			ЛогированиеТрафика.НаименованиеБиблиотеки());
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия, 
			УровеньЖурналаРегистрации.Ошибка, , , 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получить строку URLЗапроса.
// 
// Параметры:
//  ЛогЗапроса - см. НовыйЛог
//  ИсключитьПараметры - Булево
// 
// Возвращаемое значение:
//  Строка -  Получить строку URLЗапроса
//
Функция ПолучитьСтрокуURLЗапроса(ЛогЗапроса, ИсключитьПараметры = Ложь) Экспорт
	
	Метод = Строка(ЛогЗапроса.Метод);
	Сервер = ЛогЗапроса.Сервер;
	ЗащищенноеСоединение = ЛогЗапроса.ЭтоЗащищенноеСоединение;
	Порт = ЛогЗапроса.Порт;
	Адрес = ЛогЗапроса.Адрес;
	
	Шаблон = НСтр("ru ='%1%2%3%4%5%6'");
	Результат = СтрШаблон(Шаблон, 
		?(ПустаяСтрока(Метод), "", СтрШаблон("%1 ", ВРег(Метод))), 
		?(Не ЗащищенноеСоединение, "http://", "https://"), 
		Сервер, 
		?(Порт = 0 Или Порт = 80 Или Порт = 443, "", СтрШаблон(":%1", Формат(Порт, "ЧГ="))), 
		?(Лев(Адрес, 1) = "/", "", "/"), 
		Адрес);
		
	Если ИсключитьПараметры Тогда
		РазделительПараметры = СтрНайти(Результат, "?");
		Если РазделительПараметры <> 0 Тогда
			Результат = Лев(Результат, РазделительПараметры - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АдресРесурсаВходящегоЗапроса(Запрос)
	
	Адрес = Запрос.ОтносительныйURL;
	Если Запрос.ПараметрыЗапроса.Количество() = 0 Тогда
		Возврат Адрес;
	КонецЕсли;
	
	ПараметрыСтроки = Новый Массив;
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		ПараметрыСтроки.Добавить(Параметр.Ключ + "=" + Параметр.Значение);
	КонецЦикла;
	
	Возврат Адрес + "?" + СтрСоединить(ПараметрыСтроки, "&");
	
КонецФункции

Функция ДанныеURIВходящегоЗапроса(Запрос)
	
	Результат = Новый Структура("Сервер, Порт, ЗащищенноеСоединение", "", 0, Ложь);
	БазовыйURL = СокрЛП(Запрос.БазовыйURL);
	
	Если ПустаяСтрока(БазовыйURL) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураURI = ЛогированиеТрафика.СтруктураURI(БазовыйURL);
	Результат.Сервер = СтруктураURI.Хост;
	Результат.Порт = СтруктураURI.Порт;
	Результат.ЗащищенноеСоединение = (НРег(СтруктураURI.Схема) = "https");
	
	Возврат Результат;
	
КонецФункции

Функция КлиентВходящегоЗапроса(Запрос)
	
	ЗаголовкиВходящегоЗапроса = Новый Массив;
	ЗаголовкиВходящегоЗапроса.Добавить("X-Real-IP");
	ЗаголовкиВходящегоЗапроса.Добавить("X-Forwarded-For");
	ЗаголовкиВходящегоЗапроса.Добавить("Remote-Addr");
	Для Каждого ИмяЗаголовка Из ЗаголовкиВходящегоЗапроса Цикл
		Значение = Запрос.Заголовки.Получить(ИмяЗаголовка);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат СокрЛП(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура ЗаполнитьВходящийЛог(ЛогЗапроса, Назначение, Параметры)
	
	Запрос = Параметры.HTTPСервисЗапрос;
	ИмяМетода = ВРег(СокрЛП(Запрос.HTTPМетод));
	Попытка
		Метод = Перечисления.МетодHTTP[ИмяМетода];
	Исключение
		Метод = Перечисления.МетодHTTP.GET;
	КонецПопытки;
	
	АдресРесурса = АдресРесурсаВходящегоЗапроса(Запрос);
	ДанныеURI = ДанныеURIВходящегоЗапроса(Запрос);
	
	ЛогЗапроса.Метод = Метод;
	ЛогЗапроса.Входящий = Истина;
	ЛогЗапроса.ЭтоЗащищенноеСоединение = ДанныеURI.ЗащищенноеСоединение;
	ЛогЗапроса.Сервер = ДанныеURI.Сервер;
	ЛогЗапроса.Порт = ДанныеURI.Порт;
	ЛогЗапроса.Адрес = АдресРесурса;
	ЛогЗапроса.Клиент = КлиентВходящегоЗапроса(Запрос);
	ЛогЗапроса.КодОтвета = 0;
	
	ЛогированиеТрафика.ИмяСобытия(ЛогЗапроса.Событие, АдресРесурса);
	Если ПустаяСтрока(ЛогЗапроса.Событие) Тогда
		ЛогЗапроса.Событие = НСтр("ru = 'Входящий HTTP'");
	КонецЕсли;
	
	Содержание = НовыйСодержание(Перечисления.НаправлениеHTTPЛога.Входящий, Назначение);
	Содержание.ЗаголовкиЗапроса = ОбщегоНазначения.СкопироватьРекурсивно(Запрос.Заголовки, Ложь);
	
	Если ЛогированиеТрафика.ЗаписыватьТелоЗапроса() Тогда
		Содержание.ТелоЗапроса = ЛогированиеТрафика.ТелоHTTPКакДвоичныеДанные(Запрос);
	КонецЕсли;
	
	ЛогЗапроса.Содержание = Содержание;
	
КонецПроцедуры

Процедура ЗаполнитьИсходящийЛог(ЛогЗапроса, Назначение, Параметры)
	
	Соединение = Параметры.Соединение;
	HTTPЗапрос = Параметры.HTTPЗапрос;
	ИмяМетода = Параметры.ИмяМетода;
	
	Попытка
		Метод = Перечисления.МетодHTTP[ИмяМетода];
	Исключение
		Метод = Перечисления.МетодHTTP.GET;
	КонецПопытки;
	
	ЛогЗапроса.Метод = Метод;
	ЛогЗапроса.Входящий = Ложь;
	ЛогЗапроса.ЭтоЗащищенноеСоединение = (Соединение.ЗащищенноеСоединение <> Неопределено);
	ЛогЗапроса.Сервер = ?(ТипЗнч(Соединение) = Тип("HTTPСоединение"), Соединение.Сервер, "");
	Если ТипЗнч(Соединение) = Тип("HTTPСоединение") Тогда
		ЛогЗапроса.Порт = Соединение.Порт;
	КонецЕсли;
	ЛогЗапроса.Адрес = HTTPЗапрос.АдресРесурса;
	ЛогЗапроса.Клиент = ИмяКомпьютера();
	
	Содержание = НовыйСодержание(Перечисления.НаправлениеHTTPЛога.Исходящий, Назначение);
	Содержание.ЗаголовкиЗапроса = HTTPЗапрос.Заголовки;
	
	Если ЛогированиеТрафика.ЗаписыватьТелоЗапроса() Тогда
		Содержание.ТелоЗапроса = ЛогированиеТрафика.ТелоHTTPКакДвоичныеДанные(HTTPЗапрос);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Соединение.Пользователь)
		И ЛогированиеТрафика.ПолучитьЗначениеЗаголовкаAuthorization(Содержание.ЗаголовкиЗапроса) = Неопределено Тогда
		
		АвторизацияOAuth = СтрШаблон(
			"Bearer %1",
			Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(
				СтрШаблон("%1:%2", Соединение.Пользователь, Соединение.Пароль))));
		
		ЛогированиеТрафика.УстановитьЗаголовокAuthorization(Содержание.ЗаголовкиЗапроса, АвторизацияOAuth);
		
	КонецЕсли;
	
	ЛогЗапроса.Содержание = Содержание;
	
КонецПроцедуры

Функция ПустоеТелоСодержания(Назначение)
	
	Если Назначение = Перечисления.НазначениеЛога.Журнал Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ЗаголовкиСодержанияКСоответствию(Заголовки)
	
	Если Заголовки = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	
	Если ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
		Возврат Заголовки;
	КонецЕсли;
	
	Возврат Новый Соответствие;
	
КонецФункции

#КонецОбласти

#КонецЕсли