// @strict-types


#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Конструктор пустой структуры лога по шаблону менеджера записи РС ЛогиТрафика.
//
// Возвращаемое значение:
//  Структура:
// * НомерСеанса - Число
// * ВремяНачала - Число
// * Дата - Дата
// * Сервер - Строка
// * Метод - ПеречислениеСсылка.МетодHTTP
// * Адрес - Строка
// * Входящий - Булево
// * Длительность - Число
// * Клиент - Строка
// * КодОтвета - Число
// * Пользователь - Строка
// * Порт - Число
// * РазмерОтвета - Число
// * Событие - Строка
// * Содержание - см. НовыйСодержаниеЗапроса
// * ЭтоЗащищенноеСоединение - Булево
// * Разделитель - Булево
//
Функция НовыйСтруктураМенеджераЗаписи() Экспорт
	
	// Подготовим данные для записи возможного исключения.
	СтруктураЗаписи = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(
		СоздатьМенеджерЗаписи(), 
		Метаданные.РегистрыСведений.ЛогиТрафика);
	
	//@skip-warning
	Возврат СтруктураЗаписи;
	
КонецФункции

// Конструктор лога исходящего HTTP-запроса (перед вызовом метода соединения).
//
// Параметры:
//  Соединение - HTTPСоединение
//  Запрос - HTTPЗапрос
//  ИмяМетода - Строка - имя HTTP-метода: GET, POST, …
//  ИмяСобытия - Строка - необязательное имя для группировки в списке логов
//
// Возвращаемое значение:
//  Структура - см. НовыйЛогЗапроса
//
Функция НовыйЛогИсходящегоЗапроса(Соединение, Запрос, ИмяМетода, ИмяСобытия = "") Экспорт
	
//	// Добавление идентификатора для отслеживания запросов.
//	Если НастройкиЛогирования.ВключенаТрассировка Тогда
//		HTTPЗапрос.Заголовки.Вставить("x-b3-traceid", СгенерироватьИдентификатор());
//		HTTPЗапрос.Заголовки.Вставить("x-b3-spanid",  СгенерироватьИдентификатор());
//	КонецЕсли;
	
	Метод = Перечисления.МетодHTTP[ИмяМетода];
	ЛогЗапроса = НовыйЛогЗапроса(Метод, ИмяСобытия, Соединение, Запрос);
	ЛогЗапроса.Событие = ИмяСобытия;
	ЛогированиеТрафика.ИмяСобытия(ЛогЗапроса.Событие, Запрос.АдресРесурса);
	
	Возврат ЛогЗапроса;
	
КонецФункции

// Конструктор лога входящего HTTP-запроса (HTTP-сервис, до формирования ответа).
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//  ИмяСобытия - Строка - необязательное имя для группировки в списке логов
//
// Возвращаемое значение:
//  Структура - см. НовыйЛогЗапроса; Входящий = Истина
//
Функция НовыйЛогВходящегоЗапроса(Запрос, ИмяСобытия = "") Экспорт
	
	ИмяМетода = ВРег(СокрЛП(Запрос.HTTPМетод));
	Попытка
		Метод = Перечисления.МетодHTTP[ИмяМетода];
	Исключение
		Метод = Перечисления.МетодHTTP.GET;
	КонецПопытки;
	
	АдресРесурса = АдресРесурсаВходящегоЗапроса(Запрос);
	ДанныеURI = ДанныеURIВходящегоЗапроса(Запрос);
	
	ЛогЗапроса = НовыйСтруктураМенеджераЗаписи();
	ЛогЗапроса.Метод = Метод;
	ЛогЗапроса.Событие = ИмяСобытия;
	ЛогЗапроса.Дата = ТекущаяДатаСеанса();
	ЛогЗапроса.ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ЛогЗапроса.Входящий = Истина;
	ЛогЗапроса.ЭтоЗащищенноеСоединение = ДанныеURI.ЗащищенноеСоединение;
	ЛогЗапроса.Сервер = ДанныеURI.Сервер;
	ЛогЗапроса.Порт = ДанныеURI.Порт;
	ЛогЗапроса.Адрес = АдресРесурса;
	ЛогЗапроса.Пользователь = Пользователи.ТекущийПользователь().ПолноеНаименование();
	ЛогЗапроса.Клиент = КлиентВходящегоЗапроса(Запрос);
	ЛогЗапроса.НомерСеанса = НомерСеансаИнформационнойБазы();
	ЛогЗапроса.Вставить("HTTPОтвет", Неопределено);
	ЛогЗапроса.КодОтвета = 0;
	
	ЛогированиеТрафика.ИмяСобытия(ЛогЗапроса.Событие, АдресРесурса);
	Если ПустаяСтрока(ЛогЗапроса.Событие) Тогда
		ЛогЗапроса.Событие = НСтр("ru = 'Входящий HTTP'");
	КонецЕсли;
	
	Содержание = НовыйСодержаниеЗапроса();
	Содержание.ЗаголовкиЗапроса = Запрос.Заголовки;
	
	Если ЛогированиеТрафика.ЗаписыватьТелоЗапроса() Тогда
		Содержание.ТелоЗапроса = Запрос.ПолучитьТелоКакДвоичныеДанные();
	КонецЕсли;
	
	ЛогЗапроса.Содержание = Содержание;
	
	Возврат ЛогЗапроса;
	
КонецФункции

// Записать лог.
// 
// Параметры:
//  ЛогЗапроса - см. НовыйЛогЗапроса
//  ИмяВыходногоФайла - Строка -  Имя выходного файла
//  ТекстОшибки - Строка -  Текст ошибки
//
Процедура ЗаписатьЛог(ЛогЗапроса, ИмяВыходногоФайла = "", ТекстОшибки = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		
		Запись = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, ЛогЗапроса, , "Содержание");
		
		HTTPОтвет = Неопределено;
		ЛогЗапроса.Свойство("HTTPОтвет", HTTPОтвет);
		
		СохраненнаяДлительность = Неопределено;
		ЕстьСохраненнаяДлительность = ЛогЗапроса.Свойство("Длительность", СохраненнаяДлительность)
			И ЗначениеЗаполнено(СохраненнаяДлительность);
		
		Если HTTPОтвет = Неопределено И ЕстьСохраненнаяДлительность Тогда
			Запись.Длительность = СохраненнаяДлительность;
		Иначе
			Запись.Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - ЛогЗапроса.ВремяНачала) / 1000;
		КонецЕсли;
		
		Содержание = НовыйСодержаниеЗапроса();
		СодержаниеЛога = Неопределено;
		Если ЛогЗапроса.Свойство("Содержание", СодержаниеЛога) Тогда
			ЗаполнитьЗначенияСвойств(Содержание, СодержаниеЛога);
		КонецЕсли;
		
		ЗаписыватьТелоВРС = ЛогированиеТрафика.ЗаписыватьТелоВРС();
		
		Если HTTPОтвет <> Неопределено Тогда
			
			Если ПустаяСтрока(ИмяВыходногоФайла) Тогда
				
				Если HTTPОтвет.Заголовки["content-encoding"] = "gzip" Тогда
					ДвоичныеДанныеОтвета = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
					ТелоОтвета = ЛогированиеТрафика.РаспаковатьФайлGZip(ДвоичныеДанныеОтвета);
				Иначе
					ТелоОтвета = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
				КонецЕсли;
				
			Иначе
				ФайлОтвета = Новый Файл(ИмяВыходногоФайла);
				Если ФайлОтвета.Существует() Тогда
					ТелоОтвета = Новый ДвоичныеДанные(ИмяВыходногоФайла);
				Иначе
					ТелоОтвета = Неопределено;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗаписыватьТелоВРС И ТелоОтвета <> Неопределено Тогда
				
				Запись.РазмерОтвета = ТелоОтвета.Размер()/1000;
				
				// Это операция нужна что бы у изображений сократить строку base64 в целях оптимизации хранения логов.
				Если ТипЗнч(ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
					
					ТелоОтветаСтрока = ПолучитьСтрокуИзДвоичныхДанных(ТелоОтвета, КодировкаТекста.UTF8);
					Если Не ПустаяСтрока(ТелоОтветаСтрока) Тогда
						ТелоОтветаJSON = ЛогированиеТрафика.ЗначениеИзСтрокиJSON(ТелоОтветаСтрока);
						Для Каждого СтрокаТелаОтвета Из ТелоОтветаJSON Цикл
							Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТелаОтвета, "image") 
								И СтрокаТелаОтвета.Ключ = "image" Тогда
								СтрокаТелаОтвета.Значение = СтрШаблон("%1...", Сред(СтрокаТелаОтвета.Значение, 1, 30));
							КонецЕсли;
						КонецЦикла;
						ТелоОтветаСтрока = ЛогированиеТрафика.ЗначениеВJSON(ТелоОтветаJSON);
						ТелоОтвета = ПолучитьДвоичныеДанныеИзСтроки(ТелоОтветаСтрока)
					КонецЕсли;
					
				КонецЕсли;
				
				Содержание.ТелоОтвета = ТелоОтвета;
				
			ИначеЕсли ТелоОтвета <> Неопределено Тогда
				Запись.РазмерОтвета = ТелоОтвета.Размер()/1000;
			КонецЕсли;
			
			Запись.КодОтвета           = HTTPОтвет.КодСостояния;
			Содержание.ЗаголовкиОтвета = HTTPОтвет.Заголовки;
		ИначеЕсли ЛогЗапроса.Входящий И ЗначениеЗаполнено(ЛогЗапроса.КодОтвета) Тогда
			
			Запись.КодОтвета = ЛогЗапроса.КодОтвета;
			
			Если ЗаписыватьТелоВРС И ЗначениеЗаполнено(Содержание.ТелоОтвета)
				И ТипЗнч(Содержание.ТелоОтвета) = Тип("ДвоичныеДанные") Тогда
				Запись.РазмерОтвета = Содержание.ТелоОтвета.Размер() / 1000;
			КонецЕсли;
			
		ИначеЕсли Не ПустаяСтрока(ТекстОшибки) И ЗаписыватьТелоВРС Тогда
			Содержание.ТелоОтвета    = ТекстОшибки;
		ИначеЕсли ЗаписыватьТелоВРС И ЗначениеЗаполнено(Содержание.ТелоОтвета)
			И ТипЗнч(Содержание.ТелоОтвета) = Тип("Строка") Тогда
			Содержание.ТелоОтвета = ПолучитьДвоичныеДанныеИзСтроки(Содержание.ТелоОтвета);
		КонецЕсли;
		
		Если ЗаписыватьТелоВРС И ЗначениеЗаполнено(Содержание.ТелоЗапроса)
			И ТипЗнч(Содержание.ТелоЗапроса) = Тип("Строка") Тогда
			Содержание.ТелоЗапроса = ПолучитьДвоичныеДанныеИзСтроки(Содержание.ТелоЗапроса);
		КонецЕсли;
		
		Если Не ЗаписыватьТелоВРС Тогда
			Содержание.ТелоЗапроса = Неопределено;
			Содержание.ТелоОтвета = Неопределено;
		КонецЕсли;
		
		ЛогированиеТрафика.МаскироватьСекретныеЗаголовки(Содержание.ЗаголовкиЗапроса);
		ЛогированиеТрафика.МаскироватьСекретныеЗаголовки(Содержание.ЗаголовкиОтвета);
		
		Запись.Содержание = Новый ХранилищеЗначения(Содержание, Новый СжатиеДанных(5));
		
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаВМоделиСервиса") 
			И Метаданные.ОбщиеМодули.Найти("РаботаВМоделиСервиса") <> Неопределено Тогда
			
			МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
			Запись.Разделитель = МодульРаботаВМоделиСервиса.ЗначениеРазделителяСеанса();
			
		КонецЕсли;
		
		Запись.Записать(Истина);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ШаблонОшибки = НСтр("ru = 'Метод: %2.%1%3%1%4'");
		ТекстОшибки = СтрШаблон(
			ШаблонОшибки, 
			Символы.ПС, 
			ЛогЗапроса.Событие, 
			ПолучитьСтрокуURLЗапроса(ЛогЗапроса), 
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ШаблонСобытия = НСтр("ru = '%1Запись лога.'");
		ИмяСобытия = СтрШаблон(ШаблонСобытия, ЛогированиеТрафика.НаименованиеБиблиотеки());
		ЗаписьЖурналаРегистрации(
			ИмяСобытия, 
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ЛогиТрафика, , ТекстОшибки);
		
	КонецПопытки;
	
//	ЗаписатьЛогЗапросаВФайл(ЛогЗапроса, ТекстОшибки);
	
КонецПроцедуры

// Очистить историю.
// 
// Параметры:
//  СрокХранения - Число - количество дней.
//
Процедура ОчиститьИсторию(СрокХранения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛогиТрафика.НомерСеанса КАК НомерСеанса,
	|	ЛогиТрафика.Дата КАК Дата,
	|	ЛогиТрафика.Сервер КАК Сервер,
	|	ЛогиТрафика.ВремяНачала КАК ВремяНачала
	|ИЗ
	|	РегистрСведений.ЛогиТрафика КАК ЛогиТрафика
	|ГДЕ
	|	ЛогиТрафика.Дата < &СрокХранения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Запрос.УстановитьПараметр("СрокХранения", ТекущаяДатаСеанса() - СрокХранения * 24*60*60);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЛогиТрафика");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("НомерСеанса", "НомерСеанса");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ВремяНачала", "ВремяНачала");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Дата", "Дата");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Сервер", "Сервер");
		Блокировка.Заблокировать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.НомерСеанса.Установить(Выборка.НомерСеанса);
			НаборЗаписей.Отбор.ВремяНачала.Установить(Выборка.ВремяНачала);
			НаборЗаписей.Отбор.Дата.Установить(Выборка.Дата);
			НаборЗаписей.Отбор.Сервер.Установить(Выборка.Сервер);
			
			НаборЗаписей.Записать();
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ИмяСобытия = СтрШаблон(
			НСтр("ru = '%1.Очистить историю'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			ЛогированиеТрафика.НаименованиеБиблиотеки());
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия, 
			УровеньЖурналаРегистрации.Ошибка, , , 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Конструктор лога исходящего запроса: заполняет реквизиты и содержание по HTTPСоединение и HTTPЗапрос.
//
// Параметры:
//  Метод - ПеречислениеСсылка.МетодHTTP
//  Событие - Строка
//  Соединение - HTTPСоединение
//  HTTPЗапрос - HTTPЗапрос
//
// Возвращаемое значение:
//  Структура:
// * НомерСеанса - Число
// * ВремяНачала - Число
// * Дата - Дата
// * Сервер - Строка
// * Метод - ПеречислениеСсылка.МетодHTTP
// * Адрес - Строка
// * Входящий - Булево
// * Длительность - Число
// * Клиент - Строка
// * КодОтвета - Число
// * Пользователь - Строка
// * Порт - Число
// * РазмерОтвета - Число
// * Событие - Строка
// * Содержание - см. НовыйСодержаниеЗапроса
// * ЭтоЗащищенноеСоединение - Булево
// * Разделитель - Булево
// * HTTPОтвет - Неопределено, HTTPОтвет - ответ сервиса.
//
Функция НовыйЛогЗапроса(Метод, Событие, Соединение, HTTPЗапрос) Экспорт
	
	НовыйЛогЗапроса = НовыйСтруктураМенеджераЗаписи();
	НовыйЛогЗапроса.Метод = Метод; // POST, GET...
	НовыйЛогЗапроса.Событие = Событие;
	НовыйЛогЗапроса.Дата = ТекущаяДатаСеанса();
	НовыйЛогЗапроса.ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НовыйЛогЗапроса.ЭтоЗащищенноеСоединение = (Соединение.ЗащищенноеСоединение <> Неопределено);
	НовыйЛогЗапроса.Сервер = ?(ТипЗнч(Соединение) = Тип("HTTPСоединение"), Соединение.Сервер, "");
	Если ТипЗнч(Соединение) = Тип("HTTPСоединение") Тогда
		НовыйЛогЗапроса.Порт = Соединение.Порт;
	КонецЕсли;
	НовыйЛогЗапроса.Адрес  = HTTPЗапрос.АдресРесурса;
	НовыйЛогЗапроса.Пользователь = Пользователи.ТекущийПользователь().ПолноеНаименование();
	НовыйЛогЗапроса.Клиент = ИмяКомпьютера();
	НовыйЛогЗапроса.НомерСеанса = НомерСеансаИнформационнойБазы();
	НовыйЛогЗапроса.Вставить("HTTPОтвет", Неопределено);
	
	Содержание = НовыйСодержаниеЗапроса();
	Содержание.ЗаголовкиЗапроса = HTTPЗапрос.Заголовки;
	
	Если ЛогированиеТрафика.ЗаписыватьТелоЗапроса() Тогда
		Содержание.ТелоЗапроса = HTTPЗапрос.ПолучитьТелоКакДвоичныеДанные();
	КонецЕсли;
	
	// Проверка авторизации
	Если ЗначениеЗаполнено(Соединение.Пользователь)
		И ЛогированиеТрафика.ПолучитьЗначениеЗаголовкаAuthorization(Содержание.ЗаголовкиЗапроса) = Неопределено Тогда
		
		АвторизацияOAuth = СтрШаблон(
			"Bearer %1",
			Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(
				СтрШаблон("%1:%2", Соединение.Пользователь, Соединение.Пароль))));
		
		ЛогированиеТрафика.УстановитьЗаголовокAuthorization(Содержание.ЗаголовкиЗапроса, АвторизацияOAuth);
		
	КонецЕсли;
	
	НовыйЛогЗапроса.Содержание = Содержание;
	
	Возврат НовыйЛогЗапроса;
	
КонецФункции

// Дополняет содержание лога ключами шаблона по умолчанию.
//
// Параметры:
//  Содержание - Структура, Неопределено
//
// Возвращаемое значение:
//  см. НовыйСодержаниеЗапроса
//
Функция НормализоватьСодержаниеЗапроса(Содержание) Экспорт
	
	Результат = НовыйСодержаниеЗапроса();
	
	Если ТипЗнч(Содержание) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Результат, Содержание);
	КонецЕсли;
	
	Если Результат.ЗаголовкиЗапроса = Неопределено Тогда
		Результат.ЗаголовкиЗапроса = Новый Соответствие;
	КонецЕсли;
	
	Если Результат.ЗаголовкиОтвета = Неопределено Тогда
		Результат.ЗаголовкиОтвета = Новый Соответствие;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Конструктор структуры содержания лога (заголовки и тела запроса/ответа).
//
// Возвращаемое значение:
//  Структура:
// * ЗаголовкиЗапроса - Соответствие из КлючИЗначение
// * ТелоЗапроса - Неопределено, ДвоичныеДанные, Строка
// * ЗаголовкиОтвета - Соответствие из КлючИЗначение
// * ТелоОтвета - Неопределено, ДвоичныеДанные, Строка
//
Функция НовыйСодержаниеЗапроса() Экспорт
	
	Содержание = Новый Структура;
	Содержание.Вставить("ЗаголовкиЗапроса", Новый Соответствие());
	Содержание.Вставить("ТелоЗапроса", Неопределено);
	Содержание.Вставить("ЗаголовкиОтвета", Новый Соответствие());
	Содержание.Вставить("ТелоОтвета", Неопределено);
	
	Возврат Содержание;

КонецФункции

// Получить строку URLЗапроса.
// 
// Параметры:
//  ЛогЗапроса - см. НовыйЛогЗапроса
//  ИсключитьПараметры - Булево
// 
// Возвращаемое значение:
//  Строка -  Получить строку URLЗапроса
//
Функция ПолучитьСтрокуURLЗапроса(ЛогЗапроса, ИсключитьПараметры = Ложь) Экспорт
	
	Метод = Строка(ЛогЗапроса.Метод);
	Сервер = ЛогЗапроса.Сервер;
	ЗащищенноеСоединение = ЛогЗапроса.ЭтоЗащищенноеСоединение;
	Порт = ЛогЗапроса.Порт;
	Адрес = ЛогЗапроса.Адрес;
	
	Шаблон = НСтр("ru ='%1%2%3%4%5%6'");
	Результат = СтрШаблон(Шаблон, 
		?(ПустаяСтрока(Метод), "", СтрШаблон("%1 ", ВРег(Метод))), 
		?(Не ЗащищенноеСоединение, "http://", "https://"), 
		Сервер, 
		?(Порт = 0 Или Порт = 80 Или Порт = 443, "", СтрШаблон(":%1", Формат(Порт, "ЧГ="))), 
		?(Лев(Адрес, 1) = "/", "", "/"), 
		Адрес);
		
	Если ИсключитьПараметры Тогда
		РазделительПараметры = СтрНайти(Результат, "?");
		Если РазделительПараметры <> 0 Тогда
			Результат = Лев(Результат, РазделительПараметры - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция АдресРесурсаВходящегоЗапроса(Запрос)
	
	Адрес = Запрос.ОтносительныйURL;
	Если Запрос.ПараметрыЗапроса.Количество() = 0 Тогда
		Возврат Адрес;
	КонецЕсли;
	
	ПараметрыСтроки = Новый Массив;
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		ПараметрыСтроки.Добавить(Параметр.Ключ + "=" + Параметр.Значение);
	КонецЦикла;
	
	Возврат Адрес + "?" + СтрСоединить(ПараметрыСтроки, "&");
	
КонецФункции

Функция ДанныеURIВходящегоЗапроса(Запрос)
	
	Результат = Новый Структура("Сервер, Порт, ЗащищенноеСоединение", "", 0, Ложь);
	БазовыйURL = СокрЛП(Запрос.БазовыйURL);
	
	Если ПустаяСтрока(БазовыйURL) Тогда
		Возврат Результат;
	КонецЕсли;
	
	СтруктураURI = ЛогированиеТрафика.СтруктураURI(БазовыйURL);
	Результат.Сервер = СтруктураURI.Хост;
	Результат.Порт = СтруктураURI.Порт;
	Результат.ЗащищенноеСоединение = (НРег(СтруктураURI.Схема) = "https");
	
	Возврат Результат;
	
КонецФункции

Функция КлиентВходящегоЗапроса(Запрос)
	
	ЗаголовкиВходящегоЗапроса = Новый Массив;
	ЗаголовкиВходящегоЗапроса.Добавить("X-Real-IP");
	ЗаголовкиВходящегоЗапроса.Добавить("X-Forwarded-For");
	ЗаголовкиВходящегоЗапроса.Добавить("Remote-Addr");
	Для Каждого ИмяЗаголовка Из ЗаголовкиВходящегоЗапроса Цикл
		Значение = Запрос.Заголовки.Получить(ИмяЗаголовка);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат СокрЛП(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#КонецЕсли