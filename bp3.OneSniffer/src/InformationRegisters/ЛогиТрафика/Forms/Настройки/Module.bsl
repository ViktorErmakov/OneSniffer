// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиЛогирования = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	НастройкиЛогирования.Свойство("ВключеноЛогирование", ВключеноЛогирование);
	НастройкиЛогирования.Свойство("ПолучениеИсключенийВключено", ПолучениеИсключенийВключено);
	НастройкиЛогирования.Свойство("ПолучатьИсключенияФЗ", ПолучатьИсключенияФЗ);
	НастройкиЛогирования.Свойство("ЗаписыватьВЖР", ЗаписыватьВЖР);
	НастройкиЛогирования.Свойство("ЗаписыватьВРС", ЗаписыватьВРС);
	НастройкиЛогирования.Свойство("ЗаписыватьВРСТело", ЗаписыватьВРСТело);
	НастройкиЛогирования.Свойство("ЗаписыватьВЖРТело", ЗаписыватьВЖРТело);
	НастройкиЛогирования.Свойство("МаксимальныйРазмерТела", МаксимальныйРазмерТела);
	НастройкиЛогирования.Свойство("СрокХранения", СрокХранения);
	
	НастройкиРедактора = НастройкиЛогирования.Редактор;
	Тема = НастройкиРедактора.Тема;
	РазмерШрифта = НастройкиРедактора.РазмерШрифта;
	РазмерТабуляции = НастройкиРедактора.РазмерТабуляции;
	ПереносСтрок = НастройкиРедактора.ПереносСтрок;
	Миникарта = НастройкиРедактора.Миникарта;
	НомераСтрок = НастройкиРедактора.НомераСтрок;
	Сворачивание = НастройкиРедактора.Сворачивание;
	ФорматироватьПриВставке = НастройкиРедактора.ФорматироватьПриВставке;
	НастроитьСписокВыбораТемы();
	
	КонстантаСуществует = Метаданные.Константы.Найти("OneSniffer_ДатаЧтенияЖР") <> Неопределено;
	Если КонстантаСуществует Тогда
		ДатаЧтенияЖР = Константы.OneSniffer_ДатаЧтенияЖР.Получить();
	Иначе
		ДатаЧтенияЖР = '00010101';
	КонецЕсли;
	
	ОбновитьСостояниеРегламентногоЗаданияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_РегламентныеЗадания" Тогда
		ОбновитьСостояниеРегламентногоЗаданияНаСервере();
		УстановитьВидимостьДоступность();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользованиеЛогированияПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеИсключенийВключеноПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьВЖРПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьВРСПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьВРСТелоПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьВЖРТелоПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура СрокХраненияПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
	ОбновитьСостояниеРегламентногоЗаданияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРегламентноеЗаданиеНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(ИдентификаторРегламентногоЗаданияОчистки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Регламентное задание не найдено. Обновите расширение и перезагрузите конфигурацию.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Действие", "Изменить");
	ПараметрыФормы.Вставить("Идентификатор", ИдентификаторРегламентногоЗаданияОчистки);
	ОткрытьФорму(
		"Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание",
		ПараметрыФормы,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыполнитьРегламентноеЗаданиеСейчасНажатие(Элемент)
	
	Если СрокХранения <= 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите срок хранения больше 0 для автоматической очистки.'"));
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Ответ = Ждать ВопросАсинх(
			НСтр("ru = 'Форма изменена. Записать настройки перед выполнением очистки?'"),
			РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ПроверитьЗначенияНастроекРедактора() Тогда
			Возврат;
		КонецЕсли;
		
		СохраненныеНастройки = ГотовоНаСервере();
		Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
			Оповестить("OneSniffer_НастройкиЛогирования", СохраненныеНастройки);
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапуститьОчисткуЛоговСейчас();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьОчисткуЛоговСейчас()
	
	ДлительнаяОперация = ВыполнитьРегламентноеЗаданиеСейчасНаСервере();
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения(
		"ВыполнитьРегламентноеЗаданиеСейчасЗавершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Выполняется очистка логов...'");
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Готово(Команда)
	
	Если Не ПроверитьЗначенияНастроекРедактора() Тогда
		Возврат;
	КонецЕсли;
	
	БылаМодифицированность = Модифицированность;
	СохраненныеНастройки = ГотовоНаСервере();
	Если БылаМодифицированность И ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
		Оповестить("OneSniffer_НастройкиЛогирования", СохраненныеНастройки);
	КонецЕсли;
	Закрыть(БылаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Записывает настройки при модифицированности формы.
//
// Возвращаемое значение:
//  Структура, Неопределено - сохранённый снимок или Неопределено, если записи не было
//
&НаСервере
Функция ГотовоНаСервере()
	
	Если Не Модифицированность Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
	Настройки.ВключеноЛогирование  = ВключеноЛогирование;
	Настройки.ПолучениеИсключенийВключено = ПолучениеИсключенийВключено;
	Настройки.ПолучатьИсключенияФЗ = ПолучатьИсключенияФЗ;
	Настройки.ЗаписыватьВЖР = ЗаписыватьВЖР;
	Настройки.ЗаписыватьВРС = ЗаписыватьВРС;
	Настройки.ЗаписыватьВРСТело = ЗаписыватьВРСТело;
	Настройки.ЗаписыватьВЖРТело = ЗаписыватьВЖРТело;
	Настройки.МаксимальныйРазмерТела = МаксимальныйРазмерТела;
	Настройки.СрокХранения = СрокХранения;
	
	НастройкиРедактора = OneSniffer_РедакторКодаКлиентСервер.НастройкиРедактораПоУмолчанию();
	НастройкиРедактора.Тема = Тема;
	НастройкиРедактора.РазмерШрифта = РазмерШрифта;
	НастройкиРедактора.РазмерТабуляции = РазмерТабуляции;
	НастройкиРедактора.ПереносСтрок = ПереносСтрок;
	НастройкиРедактора.Миникарта = Миникарта;
	НастройкиРедактора.НомераСтрок = НомераСтрок;
	НастройкиРедактора.Сворачивание = Сворачивание;
	НастройкиРедактора.ФорматироватьПриВставке = ФорматироватьПриВставке;
	Настройки.Редактор = НастройкиРедактора;
	
	ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
	
	КонстантаСуществует = Метаданные.Константы.Найти("OneSniffer_ДатаЧтенияЖР") <> Неопределено;
	Если КонстантаСуществует Тогда
		Константы.OneSniffer_ДатаЧтенияЖР.Установить(ДатаЧтенияЖР);
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Возврат Настройки;
	
КонецФункции

&НаСервере
Процедура НастроитьСписокВыбораТемы()
	
	Элементы.Тема.СписокВыбора.Очистить();
	Элементы.Тема.СписокВыбора.Добавить("vs", НСтр("ru = 'Светлая (Visual Studio)'"));
	Элементы.Тема.СписокВыбора.Добавить("vs-dark", НСтр("ru = 'Тёмная (Visual Studio)'"));
	Элементы.Тема.СписокВыбора.Добавить("hc-black", НСтр("ru = 'Высокая контрастность'"));
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗначенияНастроекРедактора()
	
	Если РазмерШрифта < 10 Или РазмерШрифта > 24 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Размер шрифта должен быть от 10 до 24.'"),
			,
			"РазмерШрифта");
		Возврат Ложь;
	КонецЕсли;
	
	ДопустимыеТемы = Новый Массив;
	ДопустимыеТемы.Добавить("vs");
	ДопустимыеТемы.Добавить("vs-dark");
	ДопустимыеТемы.Добавить("hc-black");
	Если ДопустимыеТемы.Найти(Тема) = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выберите тему из списка.'"),
			,
			"Тема");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ОбновитьСостояниеРегламентногоЗаданияНаСервере()
	
	Состояние = ЛогированиеТрафика.СостояниеРегламентногоЗаданияОчистки();
	РегламентныеЗаданияДоступны = Состояние.РегламентныеЗаданияДоступны;
	РегламентноеЗаданиеНайдено = Состояние.ЗаданиеНайдено;
	РегламентноеЗаданиеИспользуется = Состояние.Использование;
	ИдентификаторРегламентногоЗаданияОчистки = Состояние.Идентификатор;
	ПредставлениеРасписанияОчистки = Состояние.ПредставлениеРасписания;
	СообщениеОРегламентномЗадании = Состояние.Описание;
	КонстантыДоступны = Метаданные.Константы.Найти("OneSniffer_ДатаЧтенияЖР") <> Неопределено;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВыполнитьРегламентноеЗаданиеСейчасНаСервере()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РегламентныеЗадания") Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Регламентные задания недоступны (нет БСП).'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЛогированиеТрафика.ВыполнитьРегламентноеЗаданиеОчисткиСейчас();
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьРегламентноеЗаданиеСейчасЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		Оповестить("Запись_ЛогиТрафика");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	
	// Иерархия: ВключеноЛогирование -> назначение (РС/ЖР) -> тело назначения.
	// МаксимальныйРазмерТела - только при эффективной записи тела хотя бы в одно хранилище.
	// Дочерние значения при выключенном родителе сохраняются, но недоступны.
	Элементы.ПолучениеИсключенийВключено.Доступность = ВключеноЛогирование;
	Элементы.ЗаписыватьВЖР.Доступность = ВключеноЛогирование;
	Элементы.ЗаписыватьВРС.Доступность = ВключеноЛогирование;
	Элементы.ПолучатьИсключенияФЗ.Доступность = ВключеноЛогирование И ПолучениеИсключенийВключено;
	Элементы.ДатаЧтенияЖР.Доступность = ВключеноЛогирование И ПолучениеИсключенийВключено;
	
	ЗаписыватьВЖРДоступно = ВключеноЛогирование И ЗаписыватьВЖР;
	ЗаписыватьВРСДоступно = ВключеноЛогирование И ЗаписыватьВРС;
	Элементы.ЗаписыватьВЖРТело.Доступность = ЗаписыватьВЖРДоступно;
	Элементы.ЗаписыватьВРСТело.Доступность = ЗаписыватьВРСДоступно;
	
	ПисатьТелоВРС = ЗаписыватьВРСДоступно И ЗаписыватьВРСТело;
	ПисатьТелоВЖР = ЗаписыватьВЖРДоступно И ЗаписыватьВЖРТело;
	Элементы.МаксимальныйРазмерТела.Доступность = ПисатьТелоВРС Или ПисатьТелоВЖР;
	
	ПоказыватьБлокРегламентногоЗадания = СрокХранения > 0;
	УстановитьВидимостьЭлемента("ГруппаРегламентногоЗадания", ПоказыватьБлокРегламентногоЗадания);
	
	Если Не ПоказыватьБлокРегламентногоЗадания Тогда
		Возврат;
	КонецЕсли;
	
	БлокДоступен = РегламентныеЗаданияДоступны И РегламентноеЗаданиеНайдено;
	УстановитьВидимостьЭлемента("СообщениеРегламентноеЗаданиеНедоступно", Не БлокДоступен);
	УстановитьВидимостьЭлемента("ГруппаНастройкиРегламентногоЗадания", БлокДоступен);
	
	Если Не БлокДоступен Тогда
		ЭлементСообщения = Элементы.Найти("СообщениеРегламентноеЗаданиеНедоступно");
		Если ЭлементСообщения <> Неопределено Тогда
			ЭлементСообщения.Заголовок = СообщениеОРегламентномЗадании;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Элементы.НастроитьРегламентноеЗадание.Доступность = Истина;
	Элементы.ВыполнитьРегламентноеЗаданиеСейчас.Доступность = Истина;
	
	УстановитьПредставлениеРасписанияОчистки();
	
	Элементы.НастроитьРегламентноеЗадание.Доступность = КонстантыДоступны;
	УстановитьВидимостьЭлемента("СообщениеРегламентноеЗаданиеНедоступно", Не КонстантыДоступны);
	УстановитьВидимостьЭлемента("СообщениеКонстантыНедоступны", Не КонстантыДоступны);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеРасписанияОчистки()
	
	Если РегламентноеЗаданиеИспользуется Тогда
		Если ПустаяСтрока(ПредставлениеРасписанияОчистки) Тогда
			ТекстСостояния = НСтр("ru = 'Расписание не задано'");
		Иначе
			ТекстСостояния = ПредставлениеРасписанияОчистки;
		КонецЕсли;
	Иначе
		ТекстСостояния = НСтр("ru = 'Отключено'");
	КонецЕсли;
	
	Элементы.НастроитьРегламентноеЗадание.Заголовок = ТекстСостояния;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлемента(ИмяЭлемента, Видимость)
	
	Элемент = Элементы.Найти(ИмяЭлемента);
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
