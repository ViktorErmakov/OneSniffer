// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НастройкиЛогирования = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	НастройкиЛогирования.Свойство("ВключеноЛогирование", ВключеноЛогирование);
	НастройкиЛогирования.Свойство("ПолучениеИсключенийВключено", ПолучениеИсключенийВключено);
	НастройкиЛогирования.Свойство("ПолучатьИсключенияФЗ", ПолучатьИсключенияФЗ);
	НастройкиЛогирования.Свойство("ЗаписыватьВЖР", ЗаписыватьВЖР);
	НастройкиЛогирования.Свойство("ЗаписыватьВРС", ЗаписыватьВРС);
	НастройкиЛогирования.Свойство("ЗаписыватьВРСТело", ЗаписыватьВРСТело);
	НастройкиЛогирования.Свойство("ЗаписыватьВЖРТело", ЗаписыватьВЖРТело);
	НастройкиЛогирования.Свойство("СрокХранения", СрокХранения);
	
	ДатаЧтенияЖР = Константы.OneSniffer_ДатаЧтенияЖР.Получить();
	ОбновитьСостояниеРегламентногоЗаданияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_РегламентныеЗадания" Тогда
		ОбновитьСостояниеРегламентногоЗаданияНаСервере();
		УстановитьВидимостьДоступность();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользованиеЛогированияПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеИсключенийВключеноПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьВЖРПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписыватьВРСПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура СрокХраненияПриИзменении(Элемент)
	УстановитьВидимостьДоступность();
	ОбновитьСостояниеРегламентногоЗаданияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РегламентноеЗаданиеИспользуетсяПриИзменении(Элемент)
	
	Если СрокХранения <= 0 Тогда
		РегламентноеЗаданиеИспользуется = Ложь;
		Возврат;
	КонецЕсли;
	
	Попытка
		УстановитьИспользованиеРегламентногоЗаданияНаСервере(РегламентноеЗаданиеИспользуется);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбновитьСостояниеРегламентногоЗаданияНаСервере();
	КонецПопытки;
	
	УстановитьВидимостьДоступность();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРегламентноеЗаданиеНажатие(Элемент)
	
	Если Не ЗначениеЗаполнено(ИдентификаторРегламентногоЗаданияОчистки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Регламентное задание не найдено. Обновите расширение и перезагрузите конфигурацию.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Действие", "Изменить");
	ПараметрыФормы.Вставить("Идентификатор", ИдентификаторРегламентногоЗаданияОчистки);
	ОткрытьФорму(
		"Обработка.РегламентныеИФоновыеЗадания.Форма.РегламентноеЗадание",
		ПараметрыФормы,
		ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРегламентноеЗаданиеСейчасНажатие(Элемент)
	
	Если СрокХранения <= 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Укажите срок хранения больше 0 для автоматической очистки.'"));
		Возврат;
	КонецЕсли;
	
	РезультатЗапуска = ВыполнитьРегламентноеЗаданиеСейчасНаСервере();
	Если РезультатЗапуска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатЗапуска.ПроцедураУжеВыполняется Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Очистка уже выполняется. Дождитесь завершения фонового задания.'"));
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Очистка запущена в фоне.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Готово(Команда)
	
	ГотовоНаСервере();
	Закрыть(Модифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ГотовоНаСервере()
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	Настройки = ЛогированиеТрафика.НовыйНастройкиЛогирования();
	Настройки.ВключеноЛогирование  = ВключеноЛогирование;
	Настройки.ПолучениеИсключенийВключено = ПолучениеИсключенийВключено;
	Настройки.ПолучатьИсключенияФЗ = ПолучатьИсключенияФЗ;
	Настройки.ЗаписыватьВЖР = ЗаписыватьВЖР;
	Настройки.ЗаписыватьВРС = ЗаписыватьВРС;
	Настройки.ЗаписыватьВРСТело = ЗаписыватьВРСТело;
	Настройки.ЗаписыватьВЖРТело = ЗаписыватьВЖРТело;
	Настройки.СрокХранения = СрокХранения;
	ЛогированиеТрафика.СохранитьНастройкиЛогирования(Настройки);
	
	Константы.OneSniffer_ДатаЧтенияЖР.Установить(ДатаЧтенияЖР);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеРегламентногоЗаданияНаСервере()
	
	Состояние = ЛогированиеТрафика.СостояниеРегламентногоЗаданияОчистки();
	РегламентныеЗаданияДоступны = Состояние.РегламентныеЗаданияДоступны;
	РегламентноеЗаданиеНайдено = Состояние.ЗаданиеНайдено;
	РегламентноеЗаданиеИспользуется = Состояние.Использование;
	ИдентификаторРегламентногоЗаданияОчистки = Состояние.Идентификатор;
	ПредставлениеРасписанияОчистки = Состояние.ПредставлениеРасписания;
	СообщениеОРегламентномЗадании = Состояние.Описание;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИспользованиеРегламентногоЗаданияНаСервере(Использование)
	
	ЛогированиеТрафика.УстановитьИспользованиеРегламентногоЗаданияОчистки(Использование);
	ОбновитьСостояниеРегламентногоЗаданияНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьРегламентноеЗаданиеСейчасНаСервере()
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РегламентныеЗадания") Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Регламентные задания недоступны (нет БСП).'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат ЛогированиеТрафика.ВыполнитьРегламентноеЗаданиеОчисткиСейчас();
	Исключение
		ОбщегоНазначения.СообщитьПользователю(ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	
	Элементы.ПолучениеИсключенийВключено.Доступность = ВключеноЛогирование;
	Элементы.ЗаписыватьВЖР.Доступность = ВключеноЛогирование;
	Элементы.ЗаписыватьВРС.Доступность = ВключеноЛогирование;
	Элементы.ПолучатьИсключенияФЗ.Доступность = ВключеноЛогирование И ПолучениеИсключенийВключено;
	Элементы.ДатаЧтенияЖР.Доступность = ВключеноЛогирование И ПолучениеИсключенийВключено;
	Элементы.ЗаписыватьВЖРТело.Доступность = ВключеноЛогирование И ЗаписыватьВЖР;
	Элементы.ЗаписыватьВРСТело.Доступность = ВключеноЛогирование И ЗаписыватьВРС;
	
	ПоказыватьБлокРегламентногоЗадания = СрокХранения > 0;
	УстановитьВидимостьЭлемента("ГруппаРегламентногоЗадания", ПоказыватьБлокРегламентногоЗадания);
	
	Если Не ПоказыватьБлокРегламентногоЗадания Тогда
		Возврат;
	КонецЕсли;
	
	БлокДоступен = РегламентныеЗаданияДоступны И РегламентноеЗаданиеНайдено;
	УстановитьВидимостьЭлемента("СообщениеРегламентноеЗаданиеНедоступно", Не БлокДоступен);
	УстановитьВидимостьЭлемента("ГруппаНастройкиРегламентногоЗадания", БлокДоступен);
	
	Если Не БлокДоступен Тогда
		ЭлементСообщения = Элементы.Найти("СообщениеРегламентноеЗаданиеНедоступно");
		Если ЭлементСообщения <> Неопределено Тогда
			ЭлементСообщения.Заголовок = СообщениеОРегламентномЗадании;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Элементы.РегламентноеЗаданиеИспользуется.Доступность = Истина;
	Элементы.НастроитьРегламентноеЗадание.Доступность = Истина;
	Элементы.ВыполнитьРегламентноеЗаданиеСейчас.Доступность = Истина;
	
	УстановитьПредставлениеРасписанияОчистки();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредставлениеРасписанияОчистки()
	
	ЭлементРасписания = Элементы.Найти("ПредставлениеРасписанияОчистки");
	Если ЭлементРасписания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РегламентноеЗаданиеИспользуется Тогда
		Если ПустаяСтрока(ПредставлениеРасписанияОчистки) Тогда
			ТекстРасписания = НСтр("ru = 'Расписание не задано — нажмите «Настроить…»'");
		Иначе
			ТекстРасписания = ПредставлениеРасписанияОчистки;
		КонецЕсли;
	Иначе
		ТекстРасписания = НСтр("ru = 'Автоочистка отключена'");
	КонецЕсли;
	
	ЭлементРасписания.Заголовок = ТекстРасписания;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлемента(ИмяЭлемента, Видимость)
	
	Элемент = Элементы.Найти(ИмяЭлемента);
	Если Элемент <> Неопределено Тогда
		Элемент.Видимость = Видимость;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
