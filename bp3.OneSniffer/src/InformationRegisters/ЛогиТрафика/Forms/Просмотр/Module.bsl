&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.АдресХранилища) Тогда
		АдресТекстаПротокола = Параметры.АдресХранилища;
		Заголовок = Параметры.Заголовок;
	ИначеЕсли ЗначениеЗаполнено(Параметры.Ключ) Тогда
		АдресТекстаПротокола = ПоместитьВоВременноеХранилище(
			ЛогированиеТрафика.ПолучитьТекстЛога(Параметры.Ключ), УникальныйИдентификатор);
	КонецЕсли;
	
	Если Параметры.Свойство("Язык") И ЗначениеЗаполнено(Параметры.Язык) Тогда
		ЯзыкРедактора = Параметры.Язык;
	Иначе
		ЯзыкРедактора = "rest";
	КонецЕсли;
	
	РедактированиеРазрешено = Параметры.Свойство("Редактирование") И Параметры.Редактирование = Истина;
	Элементы.СохранитьКнопка.Видимость = РедактированиеРазрешено;
	Элементы.Закрыть.Видимость = Не РедактированиеРазрешено;
	
	ИменаПолейРедакторов = Новый Массив;
	ИменаПолейРедакторов.Добавить("HTMLТекст");
	OneSniffer_РедакторКода.ПодготовитьРедакторыНаФорме(ЭтотОбъект, ИменаПолейРедакторов);
	
КонецПроцедуры

// Готовит текст протокола для редактора: состояние ждёт ready страницы.
//
// Параметры:
//  Отказ - Булево
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстПротокола = "";
	Если ЗначениеЗаполнено(АдресТекстаПротокола) Тогда
		ТекстПротокола = ПолучитьИзВременногоХранилища(АдресТекстаПротокола);
		УдалитьИзВременногоХранилища(АдресТекстаПротокола);
		АдресТекстаПротокола = "";
	КонецЕсли;
	
	Язык = ЯзыкРедактора;
	Если Не ЗначениеЗаполнено(Язык) Тогда
		Язык = "rest";
	КонецЕсли;
	
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТекст", ТекстПротокола, Язык, Не РедактированиеРазрешено);
	
КонецПроцедуры

// ПриНажатии поля HTML Monaco: туннель V8Proxy (см. правило моста HTML-1C V8Proxy).
//
// Параметры:
//  Элемент - ПолеФормы
//  ДанныеСобытия - Структура
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура HTMLТекстПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	OneSniffer_РедакторКодаКлиент.ОбработчикПриНажатии(ЭтотОбъект, Элемент, ДанныеСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

// Возвращает отредактированный текст владельцу и закрывает окно.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура Сохранить(Команда)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПослеЭкспорта", ЭтотОбъект);
	OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, "HTMLТекст", Оповещение);
	
КонецПроцедуры

// Продолжение Сохранить после экспорта текста из Monaco.
//
// Параметры:
//  Текст - Строка
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура СохранитьПослеЭкспорта(Текст, ДополнительныеПараметры) Экспорт
	
	Закрыть(Текст);
	
КонецПроцедуры
