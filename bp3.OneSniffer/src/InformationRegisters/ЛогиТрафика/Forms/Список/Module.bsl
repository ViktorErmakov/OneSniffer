
#Область ОбработчикиСобытийФормы

// Инициализирует форму списка: запускает чтение исключений из ЖР.
//
// Параметры:
//  Отказ - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КэшНастроекЛогирования = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	РезультатЧтенияЖР = ПрочитатьИсключенияИзЖР(Ложь, КэшНастроекЛогирования);
	ДлительнаяОперацияИсключенияЖР = РезультатЧтенияЖР.ДлительнаяОперация;
	ИмпортированоИзЖРПриОткрытии = РезультатЧтенияЖР.КоличествоИмпортированных > 0;
	
	ИменаПолейРедакторов = Новый Массив;
	ИменаПолейРедакторов.Добавить("HTMLТелоЗапроса");
	ИменаПолейРедакторов.Добавить("HTMLТелоОтвета");
	OneSniffer_РедакторКода.ПодготовитьРедакторыНаФорме(ЭтотОбъект, ИменаПолейРедакторов);
	
	РежимРедактированияЗапроса = Ложь;
	ИмяАктивногоРедактора = "HTMLТелоЗапроса";
	
КонецПроцедуры

// Настраивает видимость и ждет ФЗ ЖР. Поля HTML подготовлены на сервере при создании.
//
// Параметры:
//  Отказ - Булево
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПрименитьНастройкиРедактора();
	
	ПоказыватьДанные = Истина;
	ИзменитьВидимостьДоступность();
	
	Если ИмпортированоИзЖРПриОткрытии Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
	Если ДлительнаяОперацияИсключенияЖР <> Неопределено Тогда
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаписатьИсключенияВРСВФонеЗавершение", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияИсключенияЖР, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

// Обновляет список и настройки редактора по оповещениям.
//
// Параметры:
//  ИмяСобытия - Строка
//  Параметр - Произвольный
//  Источник - Произвольный
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ЛогиТрафика" Тогда
		Элементы.Список.Обновить();
	ИначеЕсли ИмяСобытия = "OneSniffer_НастройкиЛогирования" Тогда
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			КэшНастроекЛогирования = Параметр;
		КонецЕсли;
		Если Не ЛогированиеВключеноПоКэшу() И РежимРедактированияЗапроса Тогда
			РежимРедактированияЗапроса = Ложь;
		КонецЕсли;
		ИзменитьВидимостьДоступность();
		ПрименитьНастройкиРедактора();
		СинхронизироватьЖурналРегистрацииНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Устанавливает отбор динамического списка по периоду.
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ГруппаОтбораСписка = Неопределено;
	Для каждого ЭлементКоллекции Из Список.Отбор.Элементы Цикл
		Если ЭлементКоллекции.ИдентификаторПользовательскойНастройки = "Дата" Тогда
			ГруппаОтбораСписка = ЭлементКоллекции;
			ГруппаОтбораСписка.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ГруппаОтбораСписка = Неопределено Тогда
		ГруппаОтбораСписка = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбораСписка.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаОтбораСписка.ИдентификаторПользовательскойНастройки = "Дата";
		ГруппаОтбораСписка.Использование = Истина;
	ИначеЕсли Период.ДатаНачала = '00010101' И Период.ДатаОкончания = '00010101' Тогда
		ГруппаОтбораСписка.Использование = Ложь;
		Возврат;
	КонецЕсли;
	
	// Очистка всех дат.
	Для каждого ЭлементОтбораДанных Из ГруппаОтбораСписка.Элементы Цикл
		Если ЭлементОтбораДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата") Тогда
			ГруппаОтбораСписка.Элементы.Удалить(ЭлементОтбораДанных);
		КонецЕсли;
	КонецЦикла;
	
	ЭлементОтбораДанных = ГруппаОтбораСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	ЭлементОтбораДанных.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементОтбораДанных.ВидСравнения   = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ЭлементОтбораДанных.ПравоеЗначение = Период.ДатаНачала;
	ЭлементОтбораДанных.Использование  = Истина;
	
	ЭлементОтбораДанных = ГруппаОтбораСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораДанных.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементОтбораДанных.ВидСравнения   = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОтбораДанных.ПравоеЗначение = КонецДня(Период.ДатаОкончания);
	ЭлементОтбораДанных.Использование  = Истина;
	
КонецПроцедуры

// ПриНажатии полей HTML Monaco: туннель V8Proxy (см. правило моста HTML-1C V8Proxy).
//
// Параметры:
//  Элемент - ПолеФормы
//  ДанныеСобытия - Структура
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура HTMLТелоЗапросаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	OneSniffer_РедакторКодаКлиент.ОбработчикПриНажатии(ЭтотОбъект, Элемент, ДанныеСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

// Параметры:
//  Элемент - ПолеФормы
//  ДанныеСобытия - Структура
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура HTMLТелоОтветаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	OneSniffer_РедакторКодаКлиент.ОбработчикПриНажатии(ЭтотОбъект, Элемент, ДанныеСобытия, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

// Планирует отложенную загрузку деталей текущей строки.
//
// Параметры:
//  Элемент - ТаблицаФормы
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	// В режиме правки не сбрасываем черновик (обновление списка после настроек / ЖР).
	Если РежимРедактированияЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	ЗапланироватьОтложенноеОбновлениеСодержания();
	
КонецПроцедуры

// Открывает содержание выбранной строки в режиме редактирования запроса.
//
// Параметры:
//  Элемент - ТаблицаФормы
//  ВыбраннаяСтрока - Произвольный - ключ записи регистра
//  Поле - ПолеФормы
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоказыватьДанные = Истина;
	ИзменитьВидимостьДоступность();
	ОтдатьТекущееСодержаниеВРедакторы();
	
	Если ЛогированиеВключеноПоКэшу() Тогда
		РежимРедактированияЗапроса = Истина;
		ПоказатьТекстСодержания();
		ОбновитьВидимостьКомандРедактированияЗапроса();
		ТекущийЭлемент = Элементы.HTMLТелоЗапроса;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Сохраняет текст текущего лога в файл .rest.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьЛогиВФайл(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	СохранитьНаСервере(ТекущиеДанные, АдресХранилища);
	СохранитьЛогиВФайлПродолжение(АдресХранилища);
	
КонецПроцедуры

// Сохраняет текст произвольного запроса из Monaco в файл.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьПроизвольныйЗапрос(Команда)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьПроизвольныйЗапросПослеЭкспорта", ЭтотОбъект);
	OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, "HTMLТелоЗапроса", Оповещение);
	
КонецПроцедуры

// Продолжение СохранитьПроизвольныйЗапрос после экспорта текста из Monaco.
//
// Параметры:
//  Текст - Строка
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура СохранитьПроизвольныйЗапросПослеЭкспорта(Текст, ДополнительныеПараметры) Экспорт
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Текст);
	СохранитьЛогиВФайлПродолжение(АдресХранилища);
	
КонецПроцедуры

// Открывает файл .rest в редактор произвольного запроса.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьПроизвольныйЗапрос(Команда)
	
	ОткрытьПроизвольныйЗапросПродолжение();
	
КонецПроцедуры

// Открывает форму настроек логирования.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьФормуНастроек(Команда)
	
	ОткрытьФорму("РегистрСведений.ЛогиТрафика.Форма.Настройки",, ЭтотОбъект);
	
КонецПроцедуры

// Переключает видимость панели содержания. UI — сразу; Monaco — отложено на 0.1 с.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПоказатьСодержание(Команда)
	
	ПоказыватьДанные = Не ПоказыватьДанные;
	
	Если Не ПоказыватьДанные Тогда
		РежимРедактированияЗапроса = Ложь;
		ИзменитьВидимостьДоступность();
		Возврат;
	КонецЕсли;
	
	ИзменитьВидимостьДоступность();
	ЗапланироватьОтложенноеОбновлениеСодержания();
	
КонецПроцедуры

// Выполняет HTTP-запрос: в режиме редактирования — из Monaco,
// иначе — текст лога текущей строки списка.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ВыполнитьЗапрос(Команда)
	
	Если РежимРедактированияЗапроса Тогда
		Оповещение = Новый ОписаниеОповещения("ВыполнитьЗапросПослеЭкспорта", ЭтотОбъект);
		OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, "HTMLТелоЗапроса", Оповещение);
	ИначеЕсли Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	Иначе
		ВыполнитьЗапросПоТексту(ПолучитьТекстЛога(Элементы.Список.ТекущаяСтрока));
	КонецЕсли;
	
КонецПроцедуры

// Продолжение ВыполнитьЗапрос после экспорта текста из Monaco (режим редактирования).
//
// Параметры:
//  Текст - Строка
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура ВыполнитьЗапросПослеЭкспорта(Текст, ДополнительныеПараметры) Экспорт
	
	ВыполнитьЗапросПоТексту(Текст);
	
КонецПроцедуры

// Выполняет HTTP-запрос по готовому тексту и обновляет список/видимость.
//
// Параметры:
//  ТекстЗапроса - Строка
//
&НаКлиенте
Процедура ВыполнитьЗапросПоТексту(ТекстЗапроса)
	
	НоваяСтрока = Неопределено;
	Отказ = Ложь;
	ТекстОшибки = "";
	
	ВыполнитьЗапросПоСтроке(ТекстЗапроса, Отказ, ТекстОшибки, НоваяСтрока);
	
	РежимРедактированияЗапроса = Ложь;
	СинхронизироватьСписокПослеЗапроса(Отказ, НоваяСтрока);
	ОбновитьВидимостьКомандРедактированияЗапроса();
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

// Переключает режим редактирования запроса в поле HTMLТелоЗапроса.
// При снятии режима сохраняет текущий текст редактора в кэш.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура РедактироватьЗапросСодержания(Команда)
	
	Если Не ПоказыватьДанные Или Не ЛогированиеВключеноПоКэшу() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимРедактированияЗапроса Тогда
		Оповещение = Новый ОписаниеОповещения("РедактироватьЗапросСодержанияПослеЭкспорта", ЭтотОбъект);
		OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, "HTMLТелоЗапроса", Оповещение);
	Иначе
		ПереключитьРежимРедактированияЗапросаСодержания();
	КонецЕсли;
	
КонецПроцедуры

// Продолжение РедактироватьЗапросСодержания после экспорта текста из Monaco.
//
// Параметры:
//  Текст - Строка
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура РедактироватьЗапросСодержанияПослеЭкспорта(Текст, ДополнительныеПараметры) Экспорт
	
	КэшТекстЗапроса = Текст;
	ПереключитьРежимРедактированияЗапросаСодержания();
	
КонецПроцедуры

// Переключает режим редактирования и обновляет отображение содержания.
//
&НаКлиенте
Процедура ПереключитьРежимРедактированияЗапросаСодержания()
	
	РежимРедактированияЗапроса = Не РежимРедактированияЗапроса;
	ПоказатьТекстСодержания();
	ОбновитьВидимостьКомандРедактированияЗапроса();
	
КонецПроцедуры

// Открывает активный редактор на весь экран.
// Запрос — с правкой и «Сохранить»; ответ — только просмотр.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура РазвернутьРедактор(Команда)
	
	Если ТекущийЭлемент = Элементы.HTMLТелоОтвета
		Или ИмяАктивногоРедактора = "HTMLТелоОтвета" Тогда
		ИмяРедактора = "HTMLТелоОтвета";
		ЗаголовокОкна = НСтр("ru = 'Ответ'");
		ТекстКэша = КэшТекстОтвета;
		Редактирование = Ложь;
	Иначе
		ИмяРедактора = "HTMLТелоЗапроса";
		ЗаголовокОкна = НСтр("ru = 'Запрос'");
		ТекстКэша = КэшТекстЗапроса;
		Редактирование = Истина;
	КонецЕсли;
	ИмяАктивногоРедактора = ИмяРедактора;
	
	Если ПоказыватьДанные Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ЗаголовокОкна", ЗаголовокОкна);
		ДопПараметры.Вставить("Редактирование", Редактирование);
		Оповещение = Новый ОписаниеОповещения("РазвернутьРедакторПослеЭкспорта", ЭтотОбъект, ДопПараметры);
		OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, ИмяРедактора, Оповещение);
	Иначе
		ОткрытьРедакторВПолноэкранномРежиме(ТекстКэша, ЗаголовокОкна, Редактирование);
	КонецЕсли;
	
КонецПроцедуры

// Продолжение РазвернутьРедактор после экспорта текста из Monaco.
//
// Параметры:
//  Текст - Строка
//  ДополнительныеПараметры - Структура:
//   * ЗаголовокОкна - Строка
//   * Редактирование - Булево
//
&НаКлиенте
Процедура РазвернутьРедакторПослеЭкспорта(Текст, ДополнительныеПараметры) Экспорт
	
	ОткрытьРедакторВПолноэкранномРежиме(Текст, ДополнительныеПараметры.ЗаголовокОкна, ДополнительныеПараметры.Редактирование);
	
КонецПроцедуры

// Открывает форму «Просмотр» с текстом редактора в полноэкранном режиме.
//
// Параметры:
//  Текст - Строка
//  ЗаголовокОкна - Строка
//  Редактирование - Булево
//
&НаКлиенте
Процедура ОткрытьРедакторВПолноэкранномРежиме(Текст, ЗаголовокОкна, Редактирование)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("АдресХранилища", ПоместитьВоВременноеХранилище(Текст, УникальныйИдентификатор));
	ПараметрыОткрытия.Вставить("Заголовок", ЗаголовокОкна);
	ПараметрыОткрытия.Вставить("Редактирование", Редактирование);
	
	Оповещение = Неопределено;
	Если Редактирование Тогда
		Оповещение = Новый ОписаниеОповещения("РазвернутьРедакторЗавершение", ЭтотОбъект);
	КонецЕсли;
	
	ОткрытьФорму("РегистрСведений.ЛогиТрафика.Форма.Просмотр", ПараметрыОткрытия, ЭтотОбъект,
		Новый УникальныйИдентификатор, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Применяет отредактированный в полноэкранном окне текст в редактор запроса.
//
// Параметры:
//  Результат - Строка, Неопределено - текст запроса или Неопределено при закрытии без сохранения
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура РазвернутьРедакторЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказыватьДанные = Истина;
	КэшТекстЗапроса = Результат;
	РежимРедактированияЗапроса = Истина;
	ИмяАктивногоРедактора = "HTMLТелоЗапроса";
	УстановитьТекстПроизвольногоЗапроса(Результат);
	ИзменитьВидимостьДоступность();
	ТекущийЭлемент = Элементы.HTMLТелоЗапроса;
	
КонецПроцедуры

