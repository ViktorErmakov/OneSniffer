// Формирует текст тестового запроса к публикации ИБ.
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция ТекстТестовогоЗапросаВходящийHTTP()
	
	ИмяСобытия = "OneSniffer.ДемоИсходящий";
	ОтносительныйПуть = "hs/onesniffer/ping";
	
	БазовыйАдрес = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
	Если ПустаяСтрока(БазовыйАдрес) Тогда
		БазовыйАдрес = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	КонецЕсли;
	
	Если ПустаяСтрока(БазовыйАдрес) Тогда
		Возврат
		"### OneSniffer.ДемоИсходящий
		|GET http://localhost/ИБ/hs/onesniffer/ping
		|# Укажите адрес публикации ИБ: константы АдресПубликацииИнформационнойБазыВЛокальнойСети или ВИнтернете (БСП)";
	КонецЕсли;
	
	Если Не СтрЗаканчиваетсяНа(БазовыйАдрес, "/") Тогда
		БазовыйАдрес = БазовыйАдрес + "/";
	КонецЕсли;
	
	Возврат СтрШаблон("### %1
		|GET %2", ИмяСобытия, БазовыйАдрес + ОтносительныйПуть);
	
КонецФункции

