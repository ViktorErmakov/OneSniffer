// Показывает диалог сохранения файла по адресу во временном хранилище.
//
// Параметры:
//  ДополнительныеПараметры - Строка - адрес во временном хранилище
//
&НаКлиенте
Процедура СохранитьЛогиВФайлПродолжение(ДополнительныеПараметры) Экспорт
	
	МассивФайлов = Новый Массив;
	ОписаниеФайла = Новый ОписаниеПередаваемогоФайла("", ДополнительныеПараметры);
	МассивФайлов.Добавить(ОписаниеФайла);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Файл для сохранения'");
	Диалог.Расширение = "rest";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "Запросы rest (*.rest)|*.rest";
	
	ОписаниеОповещения = Новый ОписаниеОповещения();
	НачатьПолучениеФайлов(ОписаниеОповещения, МассивФайлов, Диалог);
	
КонецПроцедуры

// Формирует текст лога и помещает его во временное хранилище.
//
// Параметры:
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции - строка списка
//  АдресХранилища - Строка
//
&НаСервереБезКонтекста
Процедура СохранитьНаСервере(Знач ТекущиеДанные, АдресХранилища)
	
	ТаблицаСтрок = Новый ТаблицаЗначений;
	ТаблицаСтрок.Колонки.Добавить("ВремяНачала", Новый ОписаниеТипов("Число"));
	ТаблицаСтрок.Колонки.Добавить("Сервер",      Новый ОписаниеТипов("Строка"));
	ТаблицаСтрок.Колонки.Добавить("Метод",    Новый ОписаниеТипов("Строка"));
	
	НоваяСтрока = ТаблицаСтрок.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);
	ТаблицаСтрок.Сортировать("ВремяНачала");
	
	Текст = "";
	Для каждого ЭлементКоллекции Из ТаблицаСтрок Цикл
		Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС + Символы.ПС)
			+ ЛогированиеТрафика.ПолучитьТекстЛога(ЭлементКоллекции, Истина, Ложь);
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Текст, АдресХранилища);
	
КонецПроцедуры

// Синхронизирует видимость панелей и пометки команд с флагами формы.
// При скрытом содержании оставляет период / настройки / переключатель и растягивает список.
//
&НаКлиенте
Процедура ИзменитьВидимостьДоступность()
	
	ЛогированиеВключено = ЛогированиеВключеноПоКэшу();
	
	Элементы.ПоказатьСодержание.Пометка = ПоказыватьДанные;
	Элементы.Содержание.Видимость       = ПоказыватьДанные;
	Элементы.ГруппаКомандРедактирования.Видимость = ПоказыватьДанные;
	Элементы.РедактироватьЗапросСодержания.Видимость = ПоказыватьДанные И ЛогированиеВключено;
	
	ОбновитьВидимостьКомандРедактированияЗапроса();
	
КонецПроцедуры

// Устанавливает текст в редактор запроса Monaco.
//
// Параметры:
//  Текст - Строка
//
&НаКлиенте
Процедура УстановитьТекстПроизвольногоЗапроса(Текст)
	
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТелоЗапроса", Текст, "rest", Ложь);
	
КонецПроцедуры

// Показывает сгенерированный код (curl / 1С) в Monaco «Запрос» в режиме редактирования.
//
// Параметры:
//  АдресХранилища - Строка, Неопределено - адрес текста во временном хранилище
//  Язык - Строка - идентификатор языка Monaco (bsl | plaintext | ...)
//
&НаКлиенте
Процедура ПоказатьСгенерированныйКодВРедактореЗапроса(АдресХранилища, Язык)
	
	Если Не ЗначениеЗаполнено(АдресХранилища) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстКода = ТекстИзВременногоХранилища(АдресХранилища);
	
	ПоказыватьДанные = Истина;
	ОтдатьТекущееСодержаниеВРедакторы();
	
	КэшТекстЗапроса = ТекстКода;
	РежимРедактированияЗапроса = Истина;
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТелоЗапроса", КэшТекстЗапроса, Язык, Ложь);
	
	ИзменитьВидимостьДоступность();
	ТекущийЭлемент = Элементы.HTMLТелоЗапроса;
	
КонецПроцедуры

// Добавляет фрагмент в конец текста произвольного запроса.
//
// Параметры:
//  ТекстДляВставки - Строка
//
&НаКлиенте
Процедура ВставитьТекстВПроизвольныйЗапрос(ТекстДляВставки)
	
	Оповещение = Новый ОписаниеОповещения(
		"ВставитьТекстВПроизвольныйЗапросПослеЭкспорта", ЭтотОбъект, ТекстДляВставки);
	OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, "HTMLТелоЗапроса", Оповещение);
	
КонецПроцедуры

// Продолжение ВставитьТекстВПроизвольныйЗапрос после экспорта текста из Monaco.
//
// Параметры:
//  ТекущийТекст - Строка
//  ДополнительныеПараметры - Строка - фрагмент для вставки в конец текста
//
&НаКлиенте
Процедура ВставитьТекстВПроизвольныйЗапросПослеЭкспорта(ТекущийТекст, ДополнительныеПараметры) Экспорт
	
	УстановитьТекстПроизвольногоЗапроса(ТекущийТекст + ДополнительныеПараметры);
	
КонецПроцедуры

// Включает режим редактирования запроса и подставляет тестовый текст.
//
// Параметры:
//  Текст - Строка
//
&НаКлиенте
Процедура ПоказатьТестовыйЗапрос(Текст)
	
	Если Не ЛогированиеВключеноПоКэшу() Тогда
		Возврат;
	КонецЕсли;
	
	ПоказыватьДанные = Истина;
	РежимРедактированияЗапроса = Истина;
	ИзменитьВидимостьДоступность();
	УстановитьТекстПроизвольногоЗапроса(Текст);
	ТекущийЭлемент = Элементы.HTMLТелоЗапроса;
	
КонецПроцедуры

// Применяет настройки Monaco из кэша формы ко всем редакторам.
//
&НаКлиенте
Процедура ПрименитьНастройкиРедактора()
	
	НастройкиРедактора = НастройкиРедактораИзКэшаФормы();
	Если НастройкиРедактора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("HTMLТелоЗапроса");
	ИменаПолей.Добавить("HTMLТелоОтвета");
	OneSniffer_РедакторКодаКлиент.ПрименитьНастройкиКРедакторам(ЭтотОбъект, ИменаПолей, НастройкиРедактора);
	
КонецПроцедуры

// Обрабатывает ответ диалога удаления всех логов.
//
// Параметры:
//  Результат - КодВозвратаДиалога
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура УдалитьВсеЗаписиПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		УдалитьВсеЗаписиНаСервере();
		ПрименитьДанныеСодержанияСтроки(ДанныеСодержанияСтроки(Неопределено, УникальныйИдентификатор));
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

// Очищает регистр логов на сервере (без контекста формы — HTML Monaco не сериализуется).
//
&НаСервереБезКонтекста
Процедура УдалитьВсеЗаписиНаСервере()
	
	НаборЗаписей = РегистрыСведений.ЛогиТрафика.СоздатьНаборЗаписей();
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

// Записывает значения реквизитов в выделенные записи регистра.
//
// Параметры:
//  ВыделенныеСтроки - Массив из Произвольный
//  ПараметрыЗаписи - Структура - имена реквизитов и значения
//
&НаСервереБезКонтекста
Процедура УстановитьЗначениеРеквизитовЛогаЗаписи(Знач ВыделенныеСтроки, Знач ПараметрыЗаписи)
	
	Для каждого ЭлементКоллекции Из ВыделенныеСтроки Цикл
		МенеджерЗаписи = РегистрыСведений.ЛогиТрафика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ЭлементКоллекции);
		МенеджерЗаписи.Прочитать();
		Для каждого ЭлементПараметра Из ПараметрыЗаписи Цикл
			МенеджерЗаписи[ЭлементПараметра.Ключ] = ЭлементПараметра.Значение;
		КонецЦикла;
		МенеджерЗаписи.Записать(Истина);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает текстовое представление лога по ключу записи.
//
// Параметры:
//  КлючЗаписи - Произвольный
//
// Возвращаемое значение:
//  Строка
//
&НаСервереБезКонтекста
Функция ПолучитьТекстЛога(Знач КлючЗаписи)
	
	Возврат ЛогированиеТрафика.ПолучитьТекстЛога(КлючЗаписи);
	
КонецФункции

// Помещает выбранный файл логов во временное хранилище.
//
// Параметры:
//  МассивФайлов - Произвольный - массив путей или Неопределено
//  ОбработчикЗавершения - ОписаниеОповещения
//
&НаКлиенте
Процедура ЗагрузитьЛогиИзФайлаПродложение(МассивФайлов, ОбработчикЗавершения) Экспорт
	
	Если МассивФайлов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработкаОкончанияПомещения = Новый ОписаниеОповещения("ОбработчикОкончанияПомещения", ЭтотОбъект);	
	
	ИмяФайла = МассивФайлов[0];
	АдресХранилища = "";
	НачатьПомещениеФайла(ОбработкаОкончанияПомещения, АдресХранилища, ИмяФайла, Ложь, УникальныйИдентификатор);
	
КонецПроцедуры

// Загружает логи из помещенного файла на сервере.
//
// Параметры:
//  Результат - Булево
//  Адрес - Строка
//  ВыбранноеИмяФайла - Строка
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура ОбработчикОкончанияПомещения(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ТекстОшибки = "";
	ЗагрузитьЛогиИзФайлаНаСервере(Адрес, Отказ, ТекстОшибки);
	Если Отказ Тогда
		Сообщить(ТекстОшибки);
	КонецЕсли;
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

// Импортирует логи HTTP из временного хранилища в регистр.
//
// Параметры:
//  Адрес - Строка
//  Отказ - Булево
//  ТекстОшибки - Строка
//
&НаСервереБезКонтекста
Процедура ЗагрузитьЛогиИзФайлаНаСервере(Знач Адрес, Отказ, ТекстОшибки)
	
	ЛогированиеТрафика.ЗагрузитьЛогиHTTPИзФайла(Адрес, Отказ, ТекстОшибки);
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

#КонецОбласти

#Область Интерактив

// Возвращает числовой код цвета метки по имени команды.
//
// Параметры:
//  ИмяЦвета - Строка
//
// Возвращаемое значение:
//  Число
//
&НаКлиентеНаСервереБезКонтекста
Функция КодЦветаПоИмени(ИмяЦвета)
	
	Результат = 0;
	Если ИмяЦвета = "Желтый" Тогда
		Результат = 1;
	ИначеЕсли ИмяЦвета = "Салатовый" Тогда
		Результат = 2;
	ИначеЕсли ИмяЦвета = "Бирюзовый" Тогда
		Результат = 3;
	ИначеЕсли ИмяЦвета = "Розовый" Тогда
		Результат = 4;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПроизвольныйЗапрос

// Показывает диалог выбора файла произвольного запроса.
//
&НаКлиенте
Процедура ОткрытьПроизвольныйЗапросПродолжение() Экспорт
	
	ПустойОбработчик = Новый ОписаниеОповещения("ОткрытьПроизвольныйЗапросЗавершение", ЭтотОбъект);
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru = 'Файл запроса'");
	Диалог.Расширение = "rest";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Фильтр = "Запросы rest (*.rest)|*.rest";
	НачатьПомещениеФайлов(ПустойОбработчик, Диалог, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

// Загружает выбранный файл в Monaco произвольного запроса.
//
// Параметры:
//  Результат - Произвольный - массив файлов или Неопределено
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура ОткрытьПроизвольныйЗапросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Или Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АдресХранилища = Результат[0].Хранение;
	УстановитьТекстПроизвольногоЗапроса(ПолучитьСтрокуИзДвоичныхДанных(
		ПолучитьИзВременногоХранилища(АдресХранилища)));
	УдалитьИзВременногоХранилища(АдресХранилища);
	
КонецПроцедуры

// Выполняет HTTP-запрос по тексту на сервере.
//
// Параметры:
//  ТекстЗапроса - Строка
//  Отказ - Булево
//  ТекстОшибки - Строка
//  НоваяСтрока - Произвольный - ключ записи регистра или Неопределено
//
&НаСервереБезКонтекста
Процедура ВыполнитьЗапросПоСтроке(Знач ТекстЗапроса, Отказ, ТекстОшибки, НоваяСтрока)
	
	ЛогированиеТрафика.ВыполнитьЗапросПоСтроке(ТекстЗапроса, Отказ, ТекстОшибки, НоваяСтрока);
	
КонецПроцедуры

// Генерирует команду curl и помещает во временное хранилище.
//
// Параметры:
//  КлючЗаписи - Произвольный
//  УникальныйИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище; Неопределено если протокол недоступен
//
&НаСервереБезКонтекста
Функция ПолучитьКодCurl(Знач КлючЗаписи, Знач УникальныйИдентификаторФормы)
	
	Результат = ЛогированиеТрафика.ПолучитьКодCurl(КлючЗаписи);
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификаторФормы);
	
КонецФункции

// Генерирует код 1С и помещает во временное хранилище.
//
// Параметры:
//  КлючЗаписи - Произвольный
//  УникальныйИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Строка - адрес во временном хранилище; Неопределено если протокол недоступен
//
&НаСервереБезКонтекста
Функция ПолучитьКодЗапроса1СПредприятие(Знач КлючЗаписи, Знач УникальныйИдентификаторФормы)
	
	ПротоколЗапроса = ЛогированиеТрафика.ПолучитьПротоколЗапросаЛога(КлючЗаписи);
	Если ПротоколЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	//СтрокаЗапроса = Логирование.ПолучитьСтрокуURLЗапроса(Запрос.Метод, Запрос.Сервер, Запрос.ЭтоЗащищенноеСоединение, Запрос.Порт, Запрос.Адрес);
	
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку("// " + ПротоколЗапроса.Событие);
	Текст.ДобавитьСтроку(СтрШаблон("СоединениеHTTP = Новый HTTPСоединение(""%1"", %2,,,,,%3);", 
		ПротоколЗапроса.Сервер,
		ПротоколЗапроса.Порт,
		?(ПротоколЗапроса.ЭтоЗащищенноеСоединение, " Новый ЗащищенноеСоединениеOpenSSL", "")));
		
	Текст.ДобавитьСтроку(СтрШаблон("ЗапросHTTP = Новый HTTPЗапрос(""%1"");", ПротоколЗапроса.Адрес));
	
	Для каждого ЭлементКоллекции Из ПротоколЗапроса.ЗаголовкиЗапроса Цикл
		Текст.ДобавитьСтроку(СтрШаблон("ЗапросHTTP.Заголовки.Вставить(""%1"", ""%2"");", ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение));
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПротоколЗапроса.ТелоЗапроса) Тогда
		ТелоЗапроса = СтрЗаменить(ПолучитьСтрокуИзДвоичныхДанных(ПротоколЗапроса.ТелоЗапроса), """", """""");
		ТелоЗапроса = СтрЗаменить(ТелоЗапроса, Символы.ПС, " ");
		Текст.ДобавитьСтроку(СтрШаблон("ЗапросHTTP.УстановитьТелоИзСтроки(""%1"");", ТелоЗапроса));
	КонецЕсли;
	
	Текст.ДобавитьСтроку(СтрШаблон("ОтветHTTP = СоединениеHTTP.ВызватьHTTPМетод(""%1"", ЗапросHTTP);", ПротоколЗапроса.Метод));
	Текст.ДобавитьСтроку("Сообщить(ОтветHTTP.ПолучитьТелоКакСтроку());");
	
	Возврат ПоместитьВоВременноеХранилище(Текст.ПолучитьТекст(), УникальныйИдентификаторФормы);
	
КонецФункции

// Возвращает префикс заголовка Authorization Bearer.
//
// Возвращаемое значение:
//  Строка
//
&НаКлиенте
Функция СтрокаЗаголовкаПароля()
	Возврат "Authorization: Bearer ";
КонецФункции

#КонецОбласти

// Применяет DTO содержания строки к реквизитам формы и Monaco (только клиент).
//
// Параметры:
//  ДанныеСодержания - Структура - см. ДанныеСодержанияСтроки
//
&НаКлиенте
Процедура ПрименитьДанныеСодержанияСтроки(ДанныеСодержания)
	
	Элементы.СтраницаОтвета.Заголовок = ДанныеСодержания.ЗаголовокСтраницыОтвета;
	
	КэшТекстОтвета = ТекстИзВременногоХранилища(ДанныеСодержания.АдресТекстаОтвета);
	КэшТекстЗапроса = ТекстИзВременногоХранилища(ДанныеСодержания.АдресТекстаЗапроса);
	
	Если ПоказыватьДанные Тогда
		ПоказатьТекстСодержания();
	КонецЕсли;
	
КонецПроцедуры

// Подставляет в Monaco Запрос/Ответ раздельные тексты; edit только у запроса.
//
&НаКлиенте
Процедура ПоказатьТекстСодержания()
	
	НастройкиРедактора = НастройкиРедактораИзКэшаФормы();
	ТолькоПросмотрЗапроса = Не РежимРедактированияЗапроса;
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТелоЗапроса", КэшТекстЗапроса, "rest", ТолькоПросмотрЗапроса, НастройкиРедактора);
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТелоОтвета", КэшТекстОтвета, "rest", Истина, НастройкиРедактора);
	
КонецПроцедуры

// Признак включения логирования из кэша формы.
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция ЛогированиеВключеноПоКэшу()
	
	Если ТипЗнч(КэшНастроекЛогирования) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Включено = Ложь;
	КэшНастроекЛогирования.Свойство("ВключеноЛогирование", Включено);
	Возврат Включено = Истина;
	
КонецФункции

// Настройки Monaco из кэша формы (загружены на сервере при создании).
//
// Возвращаемое значение:
//  Структура, Неопределено
//
&НаКлиенте
Функция НастройкиРедактораИзКэшаФормы()
	
	Если ТипЗнч(КэшНастроекЛогирования) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НастройкиРедактора = Неопределено;
	Если Не КэшНастроекЛогирования.Свойство("Редактор", НастройкиРедактора)
		Или ТипЗнч(НастройкиРедактора) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НастройкиРедактора;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьКомандРедактированияЗапроса()
	
	ЛогированиеВключено = ЛогированиеВключеноПоКэшу();
	Элементы.РедактироватьЗапросСодержания.Доступность = ПоказыватьДанные И ЛогированиеВключено;
	Элементы.РедактироватьЗапросСодержания.Пометка = РежимРедактированияЗапроса;
	Элементы.ГруппаИнструментыРедактирования.Видимость =
		РежимРедактированияЗапроса И ЛогированиеВключено;
	
КонецПроцедуры

// Читает строку из ВХ и удаляет адрес (тела с управляющими символами нельзя возвращать через XDTO).
//
&НаКлиенте
Функция ТекстИзВременногоХранилища(АдресХранилища)
	
	Если Не ЗначениеЗаполнено(АдресХранилища) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = ПолучитьИзВременногоХранилища(АдресХранилища);
	УдалитьИзВременногоХранилища(АдресХранилища);
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Текст);
	
КонецФункции

// Собирает данные содержания строки без контекста формы (HTML Monaco не уходит в XDTO).
//
// Параметры:
//  КлючЗаписи - Произвольный - ключ записи регистра или Неопределено
//  УникальныйИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Структура:
//   * АдресТекстаОтвета - Строка - только ответ во ВХ
//   * АдресТекстаЗапроса - Строка - только запрос во ВХ
//   * ЗаголовокСтраницыОтвета - Строка
//
&НаСервереБезКонтекста
Функция ДанныеСодержанияСтроки(Знач КлючЗаписи, Знач УникальныйИдентификаторФормы)
	
	Результат = Новый Структура;
	Результат.Вставить("АдресТекстаОтвета", "");
	Результат.Вставить("АдресТекстаЗапроса", "");
	Результат.Вставить("ЗаголовокСтраницыОтвета", НСтр("ru = 'Ответ'"));
	
	Если КлючЗаписи = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПротоколЗапрос = ЛогированиеТрафика.ПолучитьДетализациюПротоколаЗапроса(КлючЗаписи);
	Если ПротоколЗапрос = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстОтвета = ЛогированиеТрафика.ПолучитьТекстОтветаЛога(КлючЗаписи);
	Если ТекстОтвета = Неопределено Тогда
		ТекстОтвета = "";
	КонецЕсли;
	ТекстЗапроса = ЛогированиеТрафика.ПолучитьТекстЛога(КлючЗаписи, Ложь);
	Если ТекстЗапроса = Неопределено Тогда
		ТекстЗапроса = "";
	КонецЕсли;
	
	Результат.АдресТекстаОтвета = ПоместитьВоВременноеХранилище(
		ТекстОтвета,
		УникальныйИдентификаторФормы);
	Результат.АдресТекстаЗапроса = ПоместитьВоВременноеХранилище(
		ТекстЗапроса,
		УникальныйИдентификаторФормы);
	
	КодОтвета = ПротоколЗапрос.КодОтвета;
	Результат.ЗаголовокСтраницыОтвета = НСтр("ru = 'Ответ'")
		+ ?(КодОтвета = 0, "", " - " + КодОтвета);
	
	Возврат Результат;
	
КонецФункции

// Читает исключения HTTP из журнала регистрации в регистр логов.
//
// Параметры:
//  Принудительно - Булево - принудительный импорт после запроса с формы
//  НастройкиЛогирования - см. ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования()
//
// Возвращаемое значение:
//  Структура:
//   * ДлительнаяОперация - Произвольный - параметры ожидания ФЗ или Неопределено
//   * КоличествоИмпортированных - Число
//
&НаСервереБезКонтекста
Функция ПрочитатьИсключенияИзЖР(Знач Принудительно, Знач НастройкиЛогирования)
	
	Результат = Новый Структура(
		"ДлительнаяОперация, КоличествоИмпортированных", 
		Неопределено, 0);
	
	Если Не НастройкиЛогирования.ВключеноЛогирование Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Принудительно Тогда
		
		// После выполнения запроса с формы: импорт из ЖР нужен только когда РС не пишется.
		Если Не НастройкиЛогирования.ЗаписыватьВЖР
			Или НастройкиЛогирования.ЗаписыватьВРС Тогда
			Возврат Результат;
		КонецЕсли;
		
		Результат.КоличествоИмпортированных = ЛогированиеТрафика.ЗаписатьИсключенияВРС();
		
	ИначеЕсли НастройкиЛогирования.ПолучениеИсключенийВключено Тогда
		
		Если НастройкиЛогирования.ПолучатьИсключенияФЗ Тогда
			Результат.ДлительнаяОперация = ЛогированиеТрафика.ЗаписатьИсключенияВРСВФоне();
		Иначе
			Результат.КоличествоИмпортированных = ЛогированиеТрафика.ЗаписатьИсключенияВРС();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обновляет список после завершения фонового импорта из ЖР.
//
// Параметры:
//  Результат - Произвольный - результат длительной операции или Неопределено
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура ЗаписатьИсключенияВРСВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры


// Подставляет обновленный Bearer в текст произвольного запроса.
//
// Параметры:
//  Результат - Произвольный - структура с ШифрованныйТекст или Неопределено
//  ДополнительныеПараметры - Структура:
//   * НомерСтроки - Число
//
&НаКлиенте
Процедура РедактироватьПарольПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметрыЭкспорта = Новый Структура;
	ДопПараметрыЭкспорта.Вставить("НомерСтроки", ДополнительныеПараметры.НомерСтроки);
	ДопПараметрыЭкспорта.Вставить("ШифрованныйТекст", Результат.ШифрованныйТекст);
	
	Оповещение = Новый ОписаниеОповещения(
		"РедактироватьПарольПродолжениеПослеЭкспорта", ЭтотОбъект, ДопПараметрыЭкспорта);
	OneSniffer_РедакторКодаКлиент.ЗапроситьТекстРедактора(ЭтотОбъект, "HTMLТелоЗапроса", Оповещение);
	
КонецПроцедуры

// Продолжение РедактироватьПарольПродолжение после экспорта текста из Monaco:
// подставляет обновлённый Bearer в указанную строку.
//
// Параметры:
//  ТекстЗапроса - Строка
//  ДополнительныеПараметры - Структура:
//   * НомерСтроки - Число
//   * ШифрованныйТекст - Строка
//
&НаКлиенте
Процедура РедактироватьПарольПродолжениеПослеЭкспорта(ТекстЗапроса, ДополнительныеПараметры) Экспорт
	
	ТекстМассив = СтрРазделить(ТекстЗапроса, Символы.ПС);
	ТекстМассив[ДополнительныеПараметры.НомерСтроки] = СтрШаблон(
		"%1 %2", СтрокаЗаголовкаПароля(), ДополнительныеПараметры.ШифрованныйТекст);
	УстановитьТекстПроизвольногоЗапроса(СтрСоединить(ТекстМассив, Символы.ПС));
	
КонецПроцедуры

// Отдаёт тела текущей строки в готовые Monaco (ответ на ready / смена строки).
//
&НаКлиенте
Процедура ОтдатьТекущееСодержаниеВРедакторы()
	
	ИмяАктивногоРедактора = "HTMLТелоЗапроса";
	
	КлючЗаписи = Неопределено;
	Если ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		КлючЗаписи = Элементы.Список.ТекущаяСтрока;
	КонецЕсли;
	
	ДанныеСодержания = ДанныеСодержанияСтроки(КлючЗаписи, УникальныйИдентификатор);
	ПрименитьДанныеСодержанияСтроки(ДанныеСодержания);
	
КонецПроцедуры

// Планирует отложенную отдачу содержания в Monaco (0.1 с, однократно).
// При быстрой смене строки предыдущий таймер сбрасывается.
//
&НаКлиенте
Процедура ЗапланироватьОтложенноеОбновлениеСодержания()
	
	ОтключитьОбработчикОжидания("ОтложенноеОбновлениеСодержания");
	Если Не ПоказыватьДанные Тогда
		Возврат;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ОтложенноеОбновлениеСодержания", 0.1, Истина);
	
КонецПроцедуры

// Обработчик ожидания: заполняет Monaco текущей строкой списка.
//
&НаКлиенте
Процедура ОтложенноеОбновлениеСодержания()
	
	ОтдатьТекущееСодержаниеВРедакторы();
	
КонецПроцедуры

#КонецОбласти
