// Продолжение РедактироватьПароль после экспорта текста из Monaco:
// ищет строку с Authorization: Bearer и открывает форму редактирования.
//
// Параметры:
//  ТекстЗапроса - Строка
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура РедактироватьПарольПослеЭкспорта(ТекстЗапроса, ДополнительныеПараметры) Экспорт
	
	ТекстМассив = СтрРазделить(ТекстЗапроса, Символы.ПС);
	
	Для Каждого СтрокаМассива Из ТекстМассив Цикл
		
		Если СтрНайти(СтрокаМассива, "Authorization: Bearer ") Тогда
			
			ШифрованныйТекст = СокрЛП(СтрЗаменить(СтрокаМассива, СтрокаЗаголовкаПароля(), ""));
			
			ДопПараметрыФормы = Новый Структура;
			ДопПараметрыФормы.Вставить("НомерСтроки", ТекстМассив.Найти(СтрокаМассива));
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения(
				"РедактироватьПарольПродолжение", ЭтотОбъект, ДопПараметрыФормы);
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ШифрованныйТекст", ШифрованныйТекст);
			ОткрытьФорму("РегистрСведений.ЛогиТрафика.Форма.ФормаАвторизации", 
				ПараметрыОткрытия, ЭтотОбъект, , , , 
				ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

