// Применяет DTO содержания строки к реквизитам формы и Monaco (только клиент).
//
// Параметры:
//  ДанныеСодержания - Структура - см. ДанныеСодержанияСтроки
//
&НаКлиенте
Процедура ПрименитьДанныеСодержанияСтроки(ДанныеСодержания)
	
	Элементы.СтраницаОтвета.Заголовок = ДанныеСодержания.ЗаголовокСтраницыОтвета;
	
	АдресКартинкиОтвета = ДанныеСодержания.АдресКартинкиОтвета;
	ПояснениеКартинкиОтвета = ДанныеСодержания.ПояснениеКартинкиОтвета;
	Элементы.СтраницаКартинкиОтвета.Видимость = ДанныеСодержания.ПоказыватьКартинкуОтвета;
	Если Не ДанныеСодержания.ПоказыватьКартинкуОтвета
		И Элементы.ГруппаОтвета.ТекущаяСтраница = Элементы.СтраницаКартинкиОтвета Тогда
		Элементы.ГруппаОтвета.ТекущаяСтраница = Элементы.СтраницаОтвета;
	КонецЕсли;
	
	КэшТекстОтвета = ТекстИзВременногоХранилища(ДанныеСодержания.АдресТекстаОтвета);
	КэшТекстЗапроса = ТекстИзВременногоХранилища(ДанныеСодержания.АдресТекстаЗапроса);
	
	Если ПоказыватьДанные Тогда
		ПоказатьТекстСодержания();
	КонецЕсли;
	
	ОбновитьВидимостьКомандРедактированияЗапроса();
	
КонецПроцедуры

// Подставляет в Monaco Запрос/Ответ раздельные тексты; edit только у запроса.
//
&НаКлиенте
Процедура ПоказатьТекстСодержания()
	
	ТолькоПросмотрЗапроса = Не РежимРедактированияЗапроса;
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТелоЗапроса", КэшТекстЗапроса, "rest", ТолькоПросмотрЗапроса);
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLТелоОтвета", КэшТекстОтвета, "rest", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьКомандРедактированияЗапроса()
	
	ЕстьСтрока = Элементы.Список.ТекущаяСтрока <> Неопределено;
	Элементы.РедактироватьЗапросСодержания.Доступность = ЕстьСтрока И ПоказыватьДанные;
	Элементы.РедактироватьЗапросСодержания.Пометка = РежимРедактированияЗапроса;
	Элементы.ВыполнитьТекущийЗапрос.Видимость = РежимРедактированияЗапроса;
	Элементы.ВыполнитьТекущийЗапрос.Доступность = РежимРедактированияЗапроса;
	
КонецПроцедуры

// Читает строку из ВХ и удаляет адрес (тела с управляющими символами нельзя возвращать через XDTO).
//
&НаКлиенте
Функция ТекстИзВременногоХранилища(АдресХранилища)
	
	Если Не ЗначениеЗаполнено(АдресХранилища) Тогда
		Возврат "";
	КонецЕсли;
	
	Текст = ПолучитьИзВременногоХранилища(АдресХранилища);
	УдалитьИзВременногоХранилища(АдресХранилища);
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Текст);
	
КонецФункции


// Собирает данные содержания строки без контекста формы (HTML Monaco не уходит в XDTO).
//
// Параметры:
//  КлючЗаписи - Произвольный - ключ записи регистра или Неопределено
//  УникальныйИдентификаторФормы - УникальныйИдентификатор
//
// Возвращаемое значение:
//  Структура:
//   * АдресТекстаОтвета - Строка - только ответ во ВХ
//   * АдресТекстаЗапроса - Строка - только запрос во ВХ
//   * ЗаголовокСтраницыОтвета - Строка
//   * АдресКартинкиОтвета - Строка
//   * ПояснениеКартинкиОтвета - Строка
//   * ПоказыватьКартинкуОтвета - Булево
//
&НаСервереБезКонтекста
Функция ДанныеСодержанияСтроки(Знач КлючЗаписи, Знач УникальныйИдентификаторФормы)
	
	Результат = Новый Структура;
	Результат.Вставить("АдресТекстаОтвета", "");
	Результат.Вставить("АдресТекстаЗапроса", "");
	Результат.Вставить("ЗаголовокСтраницыОтвета", НСтр("ru = 'Ответ'"));
	Результат.Вставить("АдресКартинкиОтвета", "");
	Результат.Вставить("ПояснениеКартинкиОтвета", "");
	Результат.Вставить("ПоказыватьКартинкуОтвета", Ложь);
	
	Если КлючЗаписи = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПротоколЗапрос = ЛогированиеТрафика.ПолучитьДетализациюПротоколаЗапроса(КлючЗаписи);
	Если ПротоколЗапрос = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТекстОтвета = ЛогированиеТрафика.ПолучитьТекстОтветаЛога(КлючЗаписи);
	Если ТекстОтвета = Неопределено Тогда
		ТекстОтвета = "";
	КонецЕсли;
	ТекстЗапроса = ЛогированиеТрафика.ПолучитьТекстЛога(КлючЗаписи, Ложь);
	Если ТекстЗапроса = Неопределено Тогда
		ТекстЗапроса = "";
	КонецЕсли;
	
	Результат.АдресТекстаОтвета = ПоместитьВоВременноеХранилище(
		OneSniffer_РедакторКодаКлиентСервер.УсечьТекстДляОтображения(ТекстОтвета),
		УникальныйИдентификаторФормы);
	Результат.АдресТекстаЗапроса = ПоместитьВоВременноеХранилище(
		OneSniffer_РедакторКодаКлиентСервер.УсечьТекстДляОтображения(ТекстЗапроса),
		УникальныйИдентификаторФормы);
	
	КодОтвета = ПротоколЗапрос.КодОтвета;
	Результат.ЗаголовокСтраницыОтвета = НСтр("ru = 'Ответ'")
		+ ?(КодОтвета = 0, "", " - " + КодОтвета);
	
	ЗаполнитьДанныеКартинкиОтвета(Результат, ПротоколЗапрос.ПревьюКартинок, УникальныйИдентификаторФормы);
	
	Возврат Результат;
	
КонецФункции


// Заполняет поля картинки в DTO содержания.
//
&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеКартинкиОтвета(Результат, ПревьюКартинок, УникальныйИдентификаторФормы)
	
	Если ПревьюКартинок = Неопределено Или ПревьюКартинок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Картинка = ПревьюКартинок[0];
	Если Картинка.ДвоичныеДанные <> Неопределено Тогда
		Результат.АдресКартинкиОтвета = ПоместитьВоВременноеХранилище(
			Новый Картинка(Картинка.ДвоичныеДанные), УникальныйИдентификаторФормы);
	КонецЕсли;
	Результат.ПояснениеКартинкиОтвета = ?(ЗначениеЗаполнено(Картинка.Пояснение), Картинка.Пояснение, Картинка.Имя);
	Результат.ПоказыватьКартинкуОтвета = Истина;
	
КонецПроцедуры

// Читает исключения HTTP из журнала регистрации в регистр логов.
//
// Параметры:
//  Принудительно - Булево - принудительный импорт после запроса с формы
//
// Возвращаемое значение:
//  Структура:
//   * ДлительнаяОперация - Произвольный - параметры ожидания ФЗ или Неопределено
//   * КоличествоИмпортированных - Число
//
&НаСервереБезКонтекста
Функция ПрочитатьИсключенияИзЖР(Знач Принудительно = Ложь)
	
	Результат = Новый Структура(
		"ДлительнаяОперация, КоличествоИмпортированных", 
		Неопределено, 0);
	
	НастройкиЛогирования = ЛогированиеТрафика.ЗагрузитьНастройкиЛогирования();
	Если Не НастройкиЛогирования.ВключеноЛогирование Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Принудительно Тогда
		
		// После выполнения запроса с формы: импорт из ЖР нужен только когда РС не пишется.
		Если Не НастройкиЛогирования.ЗаписыватьВЖР
			Или НастройкиЛогирования.ЗаписыватьВРС Тогда
			Возврат Результат;
		КонецЕсли;
		
		Результат.КоличествоИмпортированных = ЛогированиеТрафика.ЗаписатьИсключенияВРС();
		
	ИначеЕсли НастройкиЛогирования.ПолучениеИсключенийВключено Тогда
		
		Если НастройкиЛогирования.ПолучатьИсключенияФЗ Тогда
			Результат.ДлительнаяОперация = ЛогированиеТрафика.ЗаписатьИсключенияВРСВФоне();
		Иначе
			Результат.КоличествоИмпортированных = ЛогированиеТрафика.ЗаписатьИсключенияВРС();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Обновляет список после завершения фонового импорта из ЖР.
//
// Параметры:
//  Результат - Произвольный - результат длительной операции или Неопределено
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура ЗаписатьИсключенияВРСВФонеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, Результат.КраткоеПредставлениеОшибки);
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
КонецПроцедуры

// Применяет настройки редактора и повторно синхронизирует ЖР после закрытия настроек.
//
// Параметры:
//  Результат - Произвольный - Булево или Неопределено
//  ДополнительныеПараметры - Произвольный
//
&НаКлиенте
Процедура ОповещениеОЗакрытииНастроек(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Или Результат = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьНастройкиРедактора();

	РезультатЧтенияЖР = ПрочитатьИсключенияИзЖР();
	ДлительнаяОперацияИсключенияЖР = РезультатЧтенияЖР.ДлительнаяОперация;
	
	Если РезультатЧтенияЖР.КоличествоИмпортированных > 0 Тогда
		Элементы.Список.Обновить();
	ИначеЕсли ДлительнаяОперацияИсключенияЖР <> Неопределено Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаписатьИсключенияВРСВФонеЗавершение", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияИсключенияЖР, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;
	
КонецПроцедуры

// Подставляет обновленный Bearer в текст произвольного запроса.
//
// Параметры:
//  Результат - Произвольный - структура с ШифрованныйТекст или Неопределено
//  ДополнительныеПараметры - Структура:
//   * НомерСтроки - Число
//
&НаКлиенте
Процедура РедактироватьПарольПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаЗаголовкаПароля = СтрокаЗаголовкаПароля();
	НомерСтроки = ДополнительныеПараметры.НомерСтроки;
	
	ТекстЗапроса = OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLПроизвольныйЗапрос");
	ТекстМассив = СтрРазделить(ТекстЗапроса, Символы.ПС);
	ТекстМассив[НомерСтроки] = СтрШаблон("%1 %2", СтрокаЗаголовкаПароля, Результат.ШифрованныйТекст);
	ТекстЗапроса = СтрСоединить(ТекстМассив, Символы.ПС);
	УстановитьТекстПроизвольногоЗапроса(ТекстЗапроса);
	
КонецПроцедуры

// Отдаёт тела текущей строки в готовые Monaco (ответ на ready / смена строки).
//
&НаКлиенте
Процедура ОтдатьТекущееСодержаниеВРедакторы()
	
	РежимРедактированияЗапроса = Ложь;
	
	Если Не ПоказыватьДанные Тогда
		ОбновитьВидимостьКомандРедактированияЗапроса();
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		ОбновитьВидимостьКомандРедактированияЗапроса();
		Возврат;
	КонецЕсли;
	
	ДанныеСодержания = ДанныеСодержанияСтроки(Элементы.Список.ТекущаяСтрока, УникальныйИдентификатор);
	ПрименитьДанныеСодержанияСтроки(ДанныеСодержания);
	
КонецПроцедуры

