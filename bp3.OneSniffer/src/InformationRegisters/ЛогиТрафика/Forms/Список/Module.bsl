// Синхронизирует ЖР и позиционирует список на новой строке.
//
// Параметры:
//  Отказ - Булево
//  НоваяСтрока - Произвольный - ключ записи регистра или Неопределено
//
&НаКлиенте
Процедура СинхронизироватьСписокПослеЗапроса(Отказ, НоваяСтрока = Неопределено)
	
	СинхронизироватьЖурналРегистрацииНаКлиенте(Истина);
	
	Если Не Отказ И НоваяСтрока <> Неопределено Тогда
		Элементы.Список.ТекущаяСтрока = НоваяСтрока;
	КонецЕсли;
	
КонецПроцедуры

// Читает исключения из ЖР и обновляет список при необходимости.
//
// Параметры:
//  Принудительно - Булево
//
&НаКлиенте
Процедура СинхронизироватьЖурналРегистрацииНаКлиенте(Принудительно = Ложь)
	
	РезультатЧтенияЖР = ПрочитатьИсключенияИзЖР(Принудительно);
	ДлительнаяОперацияИсключенияЖР = РезультатЧтенияЖР.ДлительнаяОперация;
	
	Если Принудительно Или РезультатЧтенияЖР.КоличествоИмпортированных > 0 Тогда
		Элементы.Список.Обновить();
	ИначеЕсли ДлительнаяОперацияИсключенияЖР <> Неопределено Тогда
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаписатьИсключенияВРСВФонеЗавершение", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияИсключенияЖР, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;
	
КонецПроцедуры

// Запускает синхронизацию исключений из ЖР без принудительного режима.
//
&НаКлиенте
Процедура ЗагрузитьИсключенияИзЖРНаКлиенте()
	
	СинхронизироватьЖурналРегистрацииНаКлиенте();
	
КонецПроцедуры

