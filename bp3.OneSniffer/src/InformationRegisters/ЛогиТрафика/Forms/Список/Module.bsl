
#Область ОбработчикиСобытийФормы

// Инициализирует форму списка: запускает чтение исключений из ЖР.
//
// Параметры:
//  Отказ - Булево
//  СтандартнаяОбработка - Булево
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РезультатЧтенияЖР = ПрочитатьИсключенияИзЖР();
	ДлительнаяОперацияИсключенияЖР = РезультатЧтенияЖР.ДлительнаяОперация;
	ИмпортированоИзЖРПриОткрытии = РезультатЧтенияЖР.КоличествоИмпортированных > 0;
	
	OneSniffer_РедакторКода.ПодготовитьМакетРедактораНаФорме(ЭтотОбъект);
	РежимРедактированияЗапроса = Ложь;
	
КонецПроцедуры

// Настраивает видимость, загружает Monaco (как bsl_console при открытии), ждет ФЗ ЖР.
//
// Параметры:
//  Отказ - Булево
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПоказыватьДанные = Истина;
	ИзменитьВидимостьДоступность();
	
	OneSniffer_РедакторКодаКлиент.ОбеспечитьЗагрузкуМакета(ЭтотОбъект, "HTMLТелоЗапроса");
	OneSniffer_РедакторКодаКлиент.ОбеспечитьЗагрузкуМакета(ЭтотОбъект, "HTMLТелоОтвета");
	
	Если ИмпортированоИзЖРПриОткрытии Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
	Если ДлительнаяОперацияИсключенияЖР <> Неопределено Тогда
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаписатьИсключенияВРСВФонеЗавершение", ЭтотОбъект);
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперацияИсключенияЖР, ОповещениеОЗавершении, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

// Обновляет список и настройки редактора по оповещениям.
//
// Параметры:
//  ИмяСобытия - Строка
//  Параметр - Произвольный
//  Источник - Произвольный
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ЛогиТрафика" Тогда
		Элементы.Список.Обновить();
	ИначеЕсли ИмяСобытия = "OneSniffer_НастройкиРедактора" Тогда
		ПрименитьНастройкиРедактора();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

// Устанавливает отбор динамического списка по периоду.
//
// Параметры:
//  Элемент - ПолеФормы
//
&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ГруппаОтбораСписка = Неопределено;
	Для каждого ЭлементКоллекции Из Список.Отбор.Элементы Цикл
		Если ЭлементКоллекции.ИдентификаторПользовательскойНастройки = "Дата" Тогда
			ГруппаОтбораСписка = ЭлементКоллекции;
			ГруппаОтбораСписка.Использование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ГруппаОтбораСписка = Неопределено Тогда
		ГруппаОтбораСписка = Список.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаОтбораСписка.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		ГруппаОтбораСписка.ИдентификаторПользовательскойНастройки = "Дата";
		ГруппаОтбораСписка.Использование = Истина;
	ИначеЕсли Период.ДатаНачала = '00010101' И Период.ДатаОкончания = '00010101' Тогда
		ГруппаОтбораСписка.Использование = Ложь;
		Возврат;
	КонецЕсли;
	
	// Очистка всех дат.
	Для каждого ЭлементОтбораДанных Из ГруппаОтбораСписка.Элементы Цикл
		Если ЭлементОтбораДанных.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата") Тогда
			ГруппаОтбораСписка.Элементы.Удалить(ЭлементОтбораДанных);
		КонецЕсли;
	КонецЦикла;
	
	ЭлементОтбораДанных = ГруппаОтбораСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	ЭлементОтбораДанных.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементОтбораДанных.ВидСравнения   = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ЭлементОтбораДанных.ПравоеЗначение = Период.ДатаНачала;
	ЭлементОтбораДанных.Использование  = Истина;
	
	ЭлементОтбораДанных = ГруппаОтбораСписка.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбораДанных.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Дата");
	ЭлементОтбораДанных.ВидСравнения   = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОтбораДанных.ПравоеЗначение = КонецДня(Период.ДатаОкончания);
	ЭлементОтбораДанных.Использование  = Истина;
	
КонецПроцедуры

// DocumentComplete → init Monaco (паттерн ConsoleOnReady / bsl_console).
//
&НаКлиенте
Процедура HTMLТелоЗапросаДокументСформирован(Элемент)
	
	OneSniffer_РедакторКодаКлиент.ОбработчикДокументСформирован(
		ЭтотОбъект, Элемент, "", "plaintext", Истина);
	ОтдатьТекущееСодержаниеВРедакторы();
	
КонецПроцедуры

&НаКлиенте
Процедура HTMLТелоОтветаДокументСформирован(Элемент)
	
	OneSniffer_РедакторКодаКлиент.ОбработчикДокументСформирован(
		ЭтотОбъект, Элемент, "", "plaintext", Истина);
	ОтдатьТекущееСодержаниеВРедакторы();
	
КонецПроцедуры

&НаКлиенте
Процедура HTMLПроизвольныйЗапросДокументСформирован(Элемент)
	
	OneSniffer_РедакторКодаКлиент.ОбработчикДокументСформирован(
		ЭтотОбъект, Элемент, ТекстПроизвольногоЗапроса, "rest", Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

// Планирует отложенную загрузку деталей текущей строки.
//
// Параметры:
//  Элемент - ТаблицаФормы
//
&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ОтдатьТекущееСодержаниеВРедакторы();
	//ПодключитьОбработчикОжидания("СписокПриАктивизацииСтрокиПродолжение", 0.1, Истина);
	
КонецПроцедуры

// Открывает произвольный запрос по выбранной строке лога.
//
// Параметры:
//  Элемент - ТаблицаФормы
//  ВыбраннаяСтрока - Произвольный - ключ записи регистра
//  Поле - ПолеФормы
//  СтандартнаяОбработка - Булево
//
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоказыватьПроизвольныйЗапрос = Истина;
	Элементы.ИзменитьЗапрос.Пометка = Истина;
	Элементы.ГруппаПроизвольныйЗапрос.Видимость = Истина;
	АдресТекста = АдресТекстаПроизвольногоЗапроса(ВыбраннаяСтрока, УникальныйИдентификатор);
	ПрименитьТекстПроизвольногоИзХранилища(АдресТекста);
	ТекущийЭлемент = Элементы.HTMLПроизвольныйЗапрос;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Сохраняет текст текущего лога в файл .rest.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьЛогиВФайл(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	СохранитьНаСервере(ТекущиеДанные, АдресХранилища);
	СохранитьЛогиВФайлПродолжение(АдресХранилища);
	
КонецПроцедуры

// Сохраняет текст произвольного запроса из Monaco в файл.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура СохранитьПроизвольныйЗапрос(Команда)
	
	АдресХранилища = ПоместитьВоВременноеХранилище(
		OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLПроизвольныйЗапрос"));
	СохранитьЛогиВФайлПродолжение(АдресХранилища);
	
КонецПроцедуры

// Открывает файл .rest в редактор произвольного запроса.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьПроизвольныйЗапрос(Команда)
	
	ОткрытьПроизвольныйЗапросПродолжение();
	
КонецПроцедуры

// Открывает форму настроек логирования.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОткрытьФормуНастроек(Команда)
	
	ОповещениеОЗакрытииНастроек = Новый ОписаниеОповещения("ОповещениеОЗакрытииНастроек", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.ЛогиТрафика.Форма.Настройки",, ЭтотОбъект, , , , ОповещениеОЗакрытииНастроек);
	
КонецПроцедуры

// Переключает видимость панели содержания и при включении грузит Monaco.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПоказатьСодержание(Команда)
	
	ПоказыватьДанные = Не ПоказыватьДанные;
	
	Если Не ПоказыватьДанные Тогда
		РежимРедактированияЗапроса = Ложь;
	КонецЕсли;
	
	Если ПоказыватьДанные Тогда
		OneSniffer_РедакторКодаКлиент.ОбеспечитьЗагрузкуМакета(ЭтотОбъект, "HTMLТелоЗапроса");
		OneSniffer_РедакторКодаКлиент.ОбеспечитьЗагрузкуМакета(ЭтотОбъект, "HTMLТелоОтвета");
		СписокПриАктивизацииСтрокиПродолжение();
	КонецЕсли;
	
	ИзменитьВидимостьДоступность();
	
КонецПроцедуры

// Переключает панель произвольного запроса и читает текст текущей строки.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ИзменитьПроизвольныйЗапрос(Команда)
	
	ПоказыватьПроизвольныйЗапрос = Не ПоказыватьПроизвольныйЗапрос;
	Элементы.ИзменитьЗапрос.Пометка = ПоказыватьПроизвольныйЗапрос;
	Элементы.ГруппаПроизвольныйЗапрос.Видимость = ПоказыватьПроизвольныйЗапрос;
	
	АдресТекста = "";
	Если ПоказыватьПроизвольныйЗапрос Тогда
		АдресТекста = АдресТекстаПроизвольногоЗапроса(Элементы.Список.ТекущаяСтрока, УникальныйИдентификатор);
	КонецЕсли;
	ПрименитьТекстПроизвольногоИзХранилища(АдресТекста);
	
	Если ПоказыватьПроизвольныйЗапрос = Ложь Тогда
		Модифицированность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

// Выполняет HTTP-запрос из текста Monaco произвольного запроса.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ВыполнитьПроизвольныйЗапрос(Команда)
	
	НоваяСтрока = Неопределено;
	Отказ = Ложь;
	ТекстОшибки = "";
	ТекстЗапроса = OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLПроизвольныйЗапрос");
	
	ВыполнитьЗапросПоСтроке(ТекстЗапроса, Отказ, ТекстОшибки, НоваяСтрока);
	
	СинхронизироватьСписокПослеЗапроса(Отказ, НоваяСтрока);
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

// Переключает режим редактирования запроса в поле HTMLТелоЗапроса.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура РедактироватьЗапросСодержания(Команда)
	
	Если Не ПоказыватьДанные Или Не ЗначениеЗаполнено(Элементы.Список.ТекущаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	РежимРедактированияЗапроса = Не РежимРедактированияЗапроса;
	ПоказатьТекстСодержания();
	ОбновитьВидимостьКомандРедактированияЗапроса();
	
КонецПроцедуры

// Выполняет HTTP-запрос из текста Monaco поля запроса (режим редактирования).
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ВыполнитьТекущийЗапрос(Команда)
	
	Если Не РежимРедактированияЗапроса Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = Неопределено;
	Отказ = Ложь;
	ТекстОшибки = "";
	ТекстЗапроса = OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLТелоЗапроса");
	
	ВыполнитьЗапросПоСтроке(ТекстЗапроса, Отказ, ТекстОшибки, НоваяСтрока);
	
	РежимРедактированияЗапроса = Ложь;
	СинхронизироватьСписокПослеЗапроса(Отказ, НоваяСтрока);
	ОбновитьВидимостьКомандРедактированияЗапроса();
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму просмотра выделенных логов.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПросмотрЛогов(Команда)
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	СохранитьНаСервере(Элементы.Список.ВыделенныеСтроки, АдресХранилища);
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("АдресХранилища", АдресХранилища);
	ПараметрыОткрытия.Вставить("Заголовок", Элементы.Список.ТекущиеДанные.Событие + " ("
		+ Элементы.Список.ТекущиеДанные.Дата + ")");
	
	ОткрытьФорму("РегистрСведений.ЛогиТрафика.Форма.Просмотр", ПараметрыОткрытия, ЭтотОбъект,
		Новый УникальныйИдентификатор);
	
КонецПроцедуры

// Очищает текст произвольного запроса в Monaco.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ОчиститьПроизвольныйЗапрос(Команда)
	
	ТекстПроизвольногоЗапроса = "";
	OneSniffer_РедакторКодаКлиент.УстановитьТекстРедактора(
		ЭтотОбъект, "HTMLПроизвольныйЗапрос", "", "rest", Ложь);
	Модифицированность = Ложь;
	
КонецПроцедуры

// Устанавливает цвет метки для выделенных строк списка.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура УстановитьЦвет(Команда)
	
	Цвет = 0;
	ИмяЦвета = СтрЗаменить(Команда.Имя, "УстановитьЦвет", "");
	КодЦвета = КодЦветаПоИмени(ИмяЦвета);
	
	ПараметрыЗаписи = Новый Структура;
	ПараметрыЗаписи.Вставить("Цвет", КодЦвета);
	УстановитьЗначениеРеквизитовЛогаЗаписи(Элементы.Список.ВыделенныеСтроки, ПараметрыЗаписи);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

// Запрашивает подтверждение и удаляет все записи регистра логов.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура УдалитьВсеЗаписи(Команда)
	
	ОбработкаОповещения = Новый ОписаниеОповещения("УдалитьВсеЗаписиПродолжение", ЭтотОбъект);
	
	ПоказатьВопрос(ОбработкаОповещения, НСтр("ru = 'Будут удалены все строки логов. Продолжить?'"),
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Скрывает панель произвольного запроса.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗакрытьГруппуПроизвольногоЗапроса(Команда)
	
	ПоказыватьПроизвольныйЗапрос = Не ПоказыватьПроизвольныйЗапрос;
	ИзменитьВидимостьДоступность();
	
КонецПроцедуры

// Вставляет плейсхолдер {{}} в произвольный запрос.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ВставитьУникальныйИдентификатор(Команда)
	
	ВставитьТекстВПроизвольныйЗапрос("{{$guid}}");
	
КонецПроцедуры

// Вставляет плейсхолдер {{}} в произвольный запрос.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ВставитьУникальноеВремя(Команда)
	
	ВставитьТекстВПроизвольныйЗапрос("{{$time}}");
	
КонецПроцедуры

// Кодирует текст произвольного запроса в Base64.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура КодироватьBase64(Команда)
	
	ТекущийТекст = OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLПроизвольныйЗапрос");
	Если ПустаяСтрока(ТекущийТекст) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанныеТекста = ПолучитьДвоичныеДанныеИзСтроки(ТекущийТекст);
		НовыйТекст = Base64Строка(ДвоичныеДанныеТекста);
		УстановитьТекстПроизвольногоЗапроса(НовыйТекст);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось кодировать текст произвольного запроса");
	КонецПопытки;
	
КонецПроцедуры

// Декодирует текст произвольного запроса из Base64.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ДекодироватьBase64(Команда)
	
	ТекущийТекст = OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLПроизвольныйЗапрос");
	Если ПустаяСтрока(ТекущийТекст) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДвоичныеДанныеТекста = Base64Значение(ТекущийТекст);
		НовыйТекст = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеТекста);
		УстановитьТекстПроизвольногоЗапроса(НовыйТекст);
	Исключение
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не удалось декодировать текст произвольного запроса");
	КонецПопытки;
	
КонецПроцедуры

// Открывает форму редактирования заголовка Authorization Bearer.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура РедактироватьПароль(Команда)
	
	ТекстЗапроса = OneSniffer_РедакторКодаКлиент.ПолучитьТекстРедактора(ЭтотОбъект, "HTMLПроизвольныйЗапрос");
	ТекстМассив = СтрРазделить(ТекстЗапроса, Символы.ПС);
	
	Для Каждого СтрокаМассива Из ТекстМассив Цикл
		
		Если СтрНайти(СтрокаМассива, "Authorization: Bearer ") Тогда
			
			ШифрованныйТекст = СокрЛП(СтрЗаменить(СтрокаМассива, СтрокаЗаголовкаПароля(), ""));
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("НомерСтроки", ТекстМассив.Найти(СтрокаМассива));
			
			ОповещениеОЗакрытии = Новый ОписаниеОповещения(
				"РедактироватьПарольПродолжение", ЭтотОбъект, ДополнительныеПараметры);
			
			ПараметрыОткрытия = Новый Структура;
			ПараметрыОткрытия.Вставить("ШифрованныйТекст", ШифрованныйТекст);
			ОткрытьФорму("РегистрСведений.ЛогиТрафика.Форма.ФормаАвторизации", 
				ПараметрыОткрытия, ЭтотОбъект, , , , 
				ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Загружает логи HTTP из выбранного файла .rest.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ЗагрузитьЛогиИзФайла(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузитьЛогиИзФайлаПродложение", ЭтотОбъект);
	
 	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = НСтр("ru = 'Запросы rest'") + "(*.rest)|*.rest";
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Расширение = "rest";
	Диалог.Заголовок = НСтр("ru = 'Выберите файл запросов rest'");
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

// Повторяет HTTP-запрос текущей строки лога.
//
// Параметры:
//  Команда - КомандаФормы
//
&НаКлиенте
Процедура ПовторитьЗапрос(Команда)
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекстЗапроса = ПолучитьТекстЛога(Элементы.Список.ТекущаяСтрока);
	
	НоваяСтрока = Неопределено;
	Отказ = Ложь;
	ТекстОшибки = "";
	
	ВыполнитьЗапросПоСтроке(ТекстЗапроса, Отказ, ТекстОшибки, НоваяСтрока);
	
	СинхронизироватьСписокПослеЗапроса(Отказ, НоваяСтрока);
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

