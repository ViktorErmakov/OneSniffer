#Область ОбработчикиСобытий

// GET /ping — демо входящего логирования OneSniffer.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция PingПолучить(Запрос)
	
	ЛогЗапроса = _HTTPСервис.НовыйЛогВходящегоЗапроса(Запрос, "OneSniffer.ДемоВходящий");
	
	Попытка
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ТелоJSON = "{""service"":""OneSniffer"",""ping"":""ok""}";
		Ответ.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
		
		_HTTPСервис.ЗаписатьВходящийЛог(ЛогЗапроса, Ответ);
		
		Возврат Ответ;
		
	Исключение
		
		_HTTPСервис.ЗаписатьВходящийЛог(ЛогЗапроса, , ИнформацияОбОшибке());
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции

#КонецОбласти
