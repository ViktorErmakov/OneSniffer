// @strict-types


#Область ОбработчикиСобытий

// GET /ping — демо входящего логирования OneSniffer.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция PingПолучить(Запрос)
	
	ИмяСобытия = "OneSniffer.ДемоВходящий";
	ВремяНачалаЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
	
	Попытка
		
		Ответ = Новый HTTPСервисОтвет(200);
		Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		ТелоJSON = "{""service"":""OneSniffer"",""ping"":""ok""}";
		Ответ.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8);
		
		_HTTPСервис.ЗаписатьВходящийЛог(Запрос, ИмяСобытия, Ответ, , ВремяНачалаЗамера);
		
		Возврат Ответ;
		
	Исключение
		
		_HTTPСервис.ЗаписатьВходящийЛог(Запрос, ИмяСобытия, , ИнформацияОбОшибке(), ВремяНачалаЗамера);
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции

#КонецОбласти
